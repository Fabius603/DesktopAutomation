<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="App.Palette.Kind">AppThemePalette</sys:String>
    <Color x:Key="App.Color.WindowBackground">#FF181A1F</Color>
    <Color x:Key="App.Color.Surface">#FF202329</Color>
    <Color x:Key="App.Color.SurfaceRaised">#FF25282F</Color>
    <Color x:Key="App.Color.SurfaceHover">#FF292D34</Color>
    <Color x:Key="App.Color.SurfacePressed">#FF30353D</Color>
    <Color x:Key="App.Color.SidebarBackground">#FF14161A</Color>
    <Color x:Key="App.Color.CardBorder">#FF30343B</Color>
    <Color x:Key="App.Color.BorderSubtle">#FF30343B</Color>
    <Color x:Key="App.Color.BorderStrong">#FF484E58</Color>
    <Color x:Key="App.Color.RowEven">#FF1B1E23</Color>
    <Color x:Key="App.Color.RowOdd">#FF202329</Color>
    <Color x:Key="App.Color.TextPrimary">#FFECEEF2</Color>
    <Color x:Key="App.Color.TextSecondary">#FFA8ADB7</Color>
    <Color x:Key="App.Color.TextMuted">#FF7D838E</Color>
    <Color x:Key="App.Color.TextDisabled">#FF5F646D</Color>
    <SolidColorBrush x:Key="App.Brush.WindowBackground" Color="{StaticResource App.Color.WindowBackground}"/>
    <SolidColorBrush x:Key="App.Brush.Surface" Color="{StaticResource App.Color.Surface}"/>
    <SolidColorBrush x:Key="App.Brush.SurfaceRaised" Color="{StaticResource App.Color.SurfaceRaised}"/>
    <SolidColorBrush x:Key="App.Brush.SurfaceHover" Color="{StaticResource App.Color.SurfaceHover}"/>
    <SolidColorBrush x:Key="App.Brush.SurfacePressed" Color="{StaticResource App.Color.SurfacePressed}"/>
    <SolidColorBrush x:Key="App.Brush.SidebarBackground" Color="{StaticResource App.Color.SidebarBackground}"/>
    <SolidColorBrush x:Key="App.Brush.CardBorder" Color="{StaticResource App.Color.CardBorder}"/>
    <SolidColorBrush x:Key="App.Brush.BorderSubtle" Color="{StaticResource App.Color.BorderSubtle}"/>
    <SolidColorBrush x:Key="App.Brush.BorderStrong" Color="{StaticResource App.Color.BorderStrong}"/>
    <SolidColorBrush x:Key="App.Brush.RowEven" Color="{StaticResource App.Color.RowEven}"/>
    <SolidColorBrush x:Key="App.Brush.RowOdd" Color="{StaticResource App.Color.RowOdd}"/>
    <SolidColorBrush x:Key="App.Brush.TextPrimary" Color="{StaticResource App.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="App.Brush.TextSecondary" Color="{StaticResource App.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="App.Brush.TextMuted" Color="{StaticResource App.Color.TextMuted}"/>
    <SolidColorBrush x:Key="App.Brush.TextDisabled" Color="{StaticResource App.Color.TextDisabled}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.ThemeBackground" Color="{StaticResource App.Color.WindowBackground}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.ThemeForeground" Color="{StaticResource App.Color.TextPrimary}"/>
</ResourceDictionary>
