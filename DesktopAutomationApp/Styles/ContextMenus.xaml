<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:menus="clr-namespace:DesktopAutomationApp.Controls">
    <SolidColorBrush x:Key="App.Brush.MenuHover" Color="#FFD8F2FC"/>
    <SolidColorBrush x:Key="App.Brush.MenuHoverForeground" Color="#FF0F172A"/>
    <SolidColorBrush x:Key="App.Brush.MenuDanger" Color="#FFFF101B"/>
    <Style x:Key="App.ContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinWidth" Value="284"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ContextMenu">
                <Border Margin="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <Border.Effect><DropShadowEffect Color="#18223B" BlurRadius="18" ShadowDepth="5" Opacity="0.18"/></Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource App.ContextMenuStyle}"/>
    <Style x:Key="App.MenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="MenuItem">
                <Grid>
                    <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconPresenter" ContentSource="Icon" VerticalAlignment="Center"/>
                            <Path x:Name="Checkmark" Data="M 0 4 L 3 7 L 9 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Visibility="Collapsed" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="4,0,20,0"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource App.Brush.TextMuted}" VerticalAlignment="Center"/>
                            <Path x:Name="Arrow" Grid.Column="3" Data="M 0 0 L 4 4 L 0 8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" HorizontalOffset="-12" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Margin="12" Background="{DynamicResource App.Brush.SurfaceRaised}" BorderBrush="{DynamicResource App.Brush.BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="4">
                            <Border.Effect><DropShadowEffect Color="#18223B" BlurRadius="18" ShadowDepth="5" Opacity="0.18"/></Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/><Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource App.Brush.MenuHover}"/><Setter Property="Foreground" Value="{DynamicResource App.Brush.MenuHoverForeground}"/></Trigger>
                    <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource App.Brush.TextDisabled}"/><Setter Property="Opacity" Value="0.65"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource App.MenuItemStyle}"/>
    <Style x:Key="App.MenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="6,5"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource App.Brush.BorderSubtle}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Separator" BasedOn="{StaticResource App.MenuSeparatorStyle}"/>
</ResourceDictionary>
