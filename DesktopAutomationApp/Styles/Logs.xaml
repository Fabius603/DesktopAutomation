<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:loc="clr-namespace:DesktopAutomationApp.Localization" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Style x:Key="LogText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/><Setter Property="FontSize" Value="18"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="LogMuted" TargetType="TextBlock" BasedOn="{StaticResource LogText}"><Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/></Style>
    <Style x:Key="LogTone" TargetType="TextBlock" BasedOn="{StaticResource LogText}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="Error"><Setter Property="Foreground" Value="{DynamicResource App.Brush.DangerLight}"/></Trigger>
            <Trigger Property="Tag" Value="Warning"><Setter Property="Foreground" Value="#E7A323"/></Trigger>
            <Trigger Property="Tag" Value="Success"><Setter Property="Foreground" Value="#12BA8E"/></Trigger>
            <Trigger Property="Tag" Value="Active"><Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/></Trigger>
            <Trigger Property="Tag" Value="Muted"><Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LogStatusIcon" TargetType="icon:PackIconMaterial">
        <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Kind" Value="MinusCircle"/><Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Error"><Setter Property="Kind" Value="AlertCircle"/><Setter Property="Foreground" Value="{DynamicResource App.Brush.DangerLight}"/></Trigger>
            <Trigger Property="Tag" Value="Warning"><Setter Property="Kind" Value="Alert"/><Setter Property="Foreground" Value="#E7A323"/></Trigger>
            <Trigger Property="Tag" Value="Success"><Setter Property="Kind" Value="CheckCircle"/><Setter Property="Foreground" Value="#12BA8E"/></Trigger>
            <Trigger Property="Tag" Value="Active"><Setter Property="Kind" Value="ProgressClock"/><Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LogList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingStackPanel.ScrollUnit" Value="Pixel"/><Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
    </Style>
    <Style x:Key="LogRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="16,14"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource App.Brush.BorderSubtle}" Background="Transparent">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/><Setter TargetName="Row" Property="BorderThickness" Value="3,0,0,1"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/></Trigger>
            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tone}" Value="Error"/><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="Row" Property="Background" Value="{DynamicResource App.Brush.DangerSubtle}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}"/></MultiDataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LogTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="18"/><Setter Property="Padding" Value="12,12"/><Setter Property="Margin" Value="0,0,20,0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Line" BorderBrush="Transparent" BorderThickness="0,0,0,3"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Line" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/><Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="LogRunTemplate">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><icon:PackIconMaterial Kind="FileDocumentOutline" Width="20" Height="20" Margin="0,0,14,0"/><TextBlock Text="{Binding Name}" Style="{StaticResource LogText}" FontWeight="SemiBold" ToolTip="{Binding Number}"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><icon:PackIconMaterial Tag="{Binding Tone}" Style="{StaticResource LogStatusIcon}" Margin="0,0,12,0"/><TextBlock Text="{Binding Result}" Tag="{Binding Tone}" Style="{StaticResource LogTone}"/></StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Origin}" Style="{StaticResource LogMuted}" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="3" Text="{Binding Time}" Style="{StaticResource LogMuted}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource LogMuted}"/>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LogStepTemplate">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Background="{Binding IconBrush}" CornerRadius="7" VerticalAlignment="Top"><icon:PackIconMaterial Kind="{Binding Icon}" Foreground="White" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" Style="{StaticResource LogText}" FontWeight="SemiBold" FontSize="18"/>
                <WrapPanel Margin="0,7,0,5"><icon:PackIconMaterial Tag="{Binding Tone}" Style="{StaticResource LogStatusIcon}" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="{Binding Result}" Tag="{Binding Tone}" Style="{StaticResource LogTone}"/><TextBlock Text="{Binding Duration}" Style="{StaticResource LogMuted}" Margin="12,0,0,0"/><TextBlock Text="{Binding Context}" Style="{StaticResource LogMuted}" FontSize="11" Margin="12,3,0,0"/></WrapPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource LogMuted}"/>

            </StackPanel>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LogAutomationTemplate">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Time}" Style="{StaticResource LogMuted}" Margin="0,3,10,0"/>
            <icon:PackIconMaterial Grid.Column="1" Style="{StaticResource LogStatusIcon}" Tag="{Binding Tone}" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" ToolTip="{Binding Context}" Style="{StaticResource LogText}" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="{Binding Summary}" Style="{StaticResource LogMuted}" Margin="0,6,0,0"/></StackPanel>
        </Grid>
    </DataTemplate>
    <Style x:Key="LogButton" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}"><Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal"/><Setter Property="FontSize" Value="16"/><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="18,12"/></Style>
    <Style x:Key="LogPrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}"><Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal"/><Setter Property="FontSize" Value="16"/><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="18,12"/></Style>
    <Style x:Key="LogExpander" TargetType="Expander" BasedOn="{StaticResource StepAdvancedExpander}"><Setter Property="FontSize" Value="18"/><Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style>
    <Style x:Key="LogHeading" TargetType="TextBlock" BasedOn="{StaticResource Heading2}"><Setter Property="FontSize" Value="28"/></Style>
    <Style x:Key="LogProblemPanel" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}"><Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceRaised}"/><Style.Triggers><DataTrigger Binding="{Binding DetailTone}" Value="Error"><Setter Property="Background" Value="{DynamicResource App.Brush.DangerSubtle}"/><Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="LogCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="FontSize" Value="16"/><Setter Property="MinHeight" Value="48"/></Style>
    <Style x:Key="LogStepRow" TargetType="ListBoxItem" BasedOn="{StaticResource LogRow}"><Setter Property="Padding" Value="12,10"/></Style>
<DataTemplate x:Key="LogPathTemplate"><Button Command="{Binding DataContext.CheckPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource LogButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="{loc:Translate Key=Logs.Ui.CheckPath}"><StackPanel><TextBlock Text="{loc:Translate Key=Logs.Ui.CheckPath}"/><TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Brush.TextMuted}" Margin="0,4,0,0"/></StackPanel></Button></DataTemplate>
</ResourceDictionary>
