<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
                    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf">
    <Style x:Key="VirtualizedCompoundEditorItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="SelectionBorder" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="StepErrorOutline" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="StepFieldErrorOutline" TargetType="Border" BasedOn="{StaticResource StepErrorOutline}">
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Validation.Message}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Validation.HasError}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Keep source actions keyboard reachable while visually quiet at rest. -->
    <Style x:Key="StepValueSourceAction" TargetType="Button" BasedOn="{StaticResource ButtonIcon}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Panel}}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type Panel}}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Reserve a stable action slot for bindable fields, independent of hover, focus or menu state. -->
    <Style x:Key="StepValueSourceContent" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,32,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Visibility, ElementName=SourceButton}" Value="Collapsed">
                <Setter Property="Margin" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StepRadioButton" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.BorderSubtle}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource App.Brush.TextMuted}" StrokeThickness="1.5"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource App.Brush.Accent}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource App.Brush.Accent}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.Brush.FocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StepFieldGrid" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="StepFieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="StepAdvancedExpander" TargetType="Expander">
        <Setter Property="Header" Value="{loc:Translate Key=Ui.Step.Settings.Advanced}"/>
        <Setter Property="IsExpanded" Value="False"/>
        <Setter Property="Margin" Value="0,6,0,8"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource App.Brush.Surface}"
                            BorderBrush="{DynamicResource App.Brush.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="HeaderSite"
                                          Grid.Row="0"
                                          MinHeight="38"
                                          Padding="12,8"
                                          HorizontalContentAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBackground"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Chevron"
                                                      Width="7"
                                                      Height="11"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Data="M 1,1 L 6,5.5 L 1,10"
                                                      Stroke="{DynamicResource App.Brush.TextMuted}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"
                                                                  TextElement.FontSize="12"
                                                                  TextElement.FontWeight="SemiBold"
                                                                  TextElement.Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background"
                                                        Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                                <Setter TargetName="Chevron" Property="Stroke"
                                                        Value="{DynamicResource App.Brush.Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background"
                                                        Value="{DynamicResource App.Brush.AccentSubtle}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background"
                                                        Value="{DynamicResource App.Brush.AccentSubtle}"/>
                                                <Setter TargetName="Chevron" Property="Stroke"
                                                        Value="{DynamicResource App.Brush.Accent}"/>
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="Divider"
                                    Grid.Row="1"
                                    Height="1"
                                    Margin="12,0"
                                    Background="{DynamicResource App.Brush.CardBorder}"
                                    Visibility="Collapsed"/>

                            <ContentPresenter x:Name="ExpandSite"
                                              Grid.Row="2"
                                              Margin="12,0,12,10"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Focusable="False"
                                              Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource App.Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GeometryCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="StepInspectorScrollBarStyle"
           TargetType="{x:Type ScrollBar}"
           BasedOn="{StaticResource {x:Type ScrollBar}}">
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CompoundValueSourceGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style x:Key="GeometrySectionHeader" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
    </Style>
    <Style x:Key="GeometryFieldContainer" TargetType="StackPanel">
        <Setter Property="Width" Value="92"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style x:Key="GeometryFieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
    </Style>
    <Style x:Key="GeometryInlineFieldLabel" TargetType="TextBlock"
           BasedOn="{StaticResource GeometryFieldLabel}">
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GeometryNumberInput" TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StepRichTextInput" TargetType="{x:Type emoji:RichTextBox}"
           BasedOn="{StaticResource MahApps.Styles.RichTextBox}">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.BorderSubtle}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource App.Brush.Accent}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.FocusBorder}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextDisabled}"/>
                <Setter Property="Opacity" Value="0.72"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GeometryUnitLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
    </Style>
    <Style x:Key="GeometryInlineAction" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style x:Key="GeometrySummary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
    </Style>
    <Style x:Key="TemplatePreviewBorder" TargetType="Border">
        <Setter Property="Width" Value="96"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Background" Value="{DynamicResource App.Brush.WindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
</ResourceDictionary>
