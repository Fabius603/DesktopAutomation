<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:DesktopAutomationApp.Localization">
    <Style x:Key="StepFieldGrid" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="StepFieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
    </Style>
    <Style x:Key="StepAdvancedExpander" TargetType="Expander">
        <Setter Property="Header" Value="{loc:Translate Key=Ui.Step.Settings.Advanced}"/>
        <Setter Property="IsExpanded" Value="False"/>
        <Setter Property="Margin" Value="0,6,0,8"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource App.Brush.Surface}"
                            BorderBrush="{DynamicResource App.Brush.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="HeaderSite"
                                          Grid.Row="0"
                                          MinHeight="38"
                                          Padding="12,8"
                                          HorizontalContentAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBackground"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Chevron"
                                                      Width="7"
                                                      Height="11"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Data="M 1,1 L 6,5.5 L 1,10"
                                                      Stroke="{DynamicResource App.Brush.TextMuted}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"
                                                                  TextElement.FontSize="12"
                                                                  TextElement.FontWeight="SemiBold"
                                                                  TextElement.Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background"
                                                        Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                                <Setter TargetName="Chevron" Property="Stroke"
                                                        Value="{DynamicResource App.Brush.Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background"
                                                        Value="{DynamicResource App.Brush.AccentSubtle}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background"
                                                        Value="{DynamicResource App.Brush.AccentSubtle}"/>
                                                <Setter TargetName="Chevron" Property="Stroke"
                                                        Value="{DynamicResource App.Brush.Accent}"/>
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="Divider"
                                    Grid.Row="1"
                                    Height="1"
                                    Margin="12,0"
                                    Background="{DynamicResource App.Brush.CardBorder}"
                                    Visibility="Collapsed"/>

                            <ContentPresenter x:Name="ExpandSite"
                                              Grid.Row="2"
                                              Margin="12,0,12,10"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Focusable="False"
                                              Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource App.Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StepCompactTextBox" TargetType="TextBox">
        <Setter Property="Width" Value="42"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StepAxisLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
    </Style>
    <Style x:Key="StepGroupedFieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
    </Style>
    <Style x:Key="StepGroupedTextBox" TargetType="TextBox" BasedOn="{StaticResource StepCompactTextBox}">
        <Setter Property="Width" Value="72"/>
    </Style>
    <Style x:Key="RoiFieldWrapPanel" TargetType="WrapPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ItemHeight" Value="34"/>
    </Style>
    <Style x:Key="RoiFieldGroup" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,0,14,6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StepInlineButton" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TemplatePreviewBorder" TargetType="Border">
        <Setter Property="Width" Value="96"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Background" Value="{DynamicResource App.Brush.WindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
</ResourceDictionary>
