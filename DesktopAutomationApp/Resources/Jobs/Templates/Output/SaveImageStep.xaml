<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
                    xmlns:jobs="clr-namespace:TaskAutomation.Jobs;assembly=TaskAutomation">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Jobs/Templates/Shared.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate DataType="{x:Type jobs:SaveImageStep}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Converter={StaticResource StepDisplayNameConverter}}"
                       FontWeight="Bold" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource ParamText}">
                    <Run Text="{loc:Translate Key=Ui.Job.Steps.ImageSource}"/>
                    <Run>
                        <Run.Text>
                            <MultiBinding Converter="{StaticResource SourceStepNameConverter}">
                                <Binding Path="Settings.ImageSource"/>
                                <Binding Path="DataContext.Steps" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                <Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                            </MultiBinding>
                        </Run.Text>
                    </Run>
                </TextBlock>
                <TextBlock Style="{StaticResource ParamText}">
                    <Run Text="{loc:Translate Key=Ui.Job.Steps.SavePath}"/>
                    <Run Text="{Binding Settings.SavePath}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource ParamText}">
                    <Run Text="{loc:Translate Key=Ui.Job.Steps.FileName}"/>
                    <Run Text="{Binding Settings.FileName}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource ParamText}">
                    <Run Text="{loc:Translate Key=Ui.Job.Steps.DetectionOverlayCount}"/><Run Text="{Binding Settings.Overlay.DetectionResults.Count}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource ParamText}">
                    <Run Text="{loc:Translate Key=Ui.Job.Steps.TextOverlayCount}"/><Run Text="{Binding Settings.Overlay.TextResults.Count}"/>
                </TextBlock>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
