<UserControl x:Class="DesktopAutomationApp.Views.Library.LibraryTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:behaviors="clr-namespace:DesktopAutomationApp.Behaviors"
             behaviors:ViewShortcutGuard.IsEnabled="True"
             AllowDrop="True"
             PreviewDragOver="LibraryTree_PreviewDragOver"
             PreviewDrop="LibraryTree_PreviewDrop"
             PreviewKeyDown="LibraryTree_PreviewKeyDown"
             GiveFeedback="LibraryTree_GiveFeedback">
    <UserControl.Resources>
        <Style x:Key="LibraryRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource App.Brush.SelectionBackground}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource App.Brush.SelectionBorder}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource App.Brush.FocusBorder}"/></Trigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True"><Setter TargetName="Row" Property="Opacity" Value="0.45"/></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="LibraryFolderContextMenu">
            <MenuItem Header="{Binding PlacementTarget.Tag.NewItemLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      InputGestureText="{loc:Translate Key=Shortcut.CtrlN}"
                      Command="{Binding PlacementTarget.Tag.NewItemInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.NewFolder}"
                      InputGestureText="{loc:Translate Key=Shortcut.CtrlShiftN}"
                      Command="{Binding PlacementTarget.Tag.NewSubfolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.RenameFolder}"
                      InputGestureText="{loc:Translate Key=Shortcut.F2}"
                      Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.MoveUpOneLevel}"
                      InputGestureText="{loc:Translate Key=Shortcut.AltUp}"
                      IsEnabled="{Binding PlacementTarget.DataContext.CanMoveUpOneLevel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Click="MoveUpOneLevel_Click"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.Delete}"
                      InputGestureText="{loc:Translate Key=Shortcut.Delete}"
                      Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
        <ContextMenu x:Key="LibraryItemContextMenu">
            <MenuItem Header="{loc:Translate Key=Ui.Library.ExecuteOrStop}"
                      Command="{Binding PlacementTarget.Tag.ExecuteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="{loc:Translate Key=Ui.Common.Open}"
                      InputGestureText="{loc:Translate Key=Shortcut.Enter}"
                      Command="{Binding PlacementTarget.Tag.OpenNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="{loc:Translate Key=Ui.Common.Rename}"
                      InputGestureText="{loc:Translate Key=Shortcut.F2}"
                      Command="{Binding PlacementTarget.Tag.RenameNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.MoveUpOneLevel}"
                      InputGestureText="{loc:Translate Key=Shortcut.AltUp}"
                      IsEnabled="{Binding PlacementTarget.DataContext.CanMoveUpOneLevel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Click="MoveUpOneLevel_Click"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.Delete}"
                      InputGestureText="{loc:Translate Key=Shortcut.Delete}"
                      Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="360"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource TableCardStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,14" BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{loc:Translate Key=Ui.Library.Folders}" FontSize="16" FontWeight="SemiBold"/>
                </Border>
                <Button DockPanel.Dock="Top" Command="{Binding ShowAllCommand}"
                        AutomationProperties.AutomationId="Library.AllItems" Margin="8,12,8,4" HorizontalContentAlignment="Left">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ButtonToolbar}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedFolderId}" Value="{x:Null}"><Setter Property="Background" Value="{DynamicResource App.Brush.SelectionBackground}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsRootDropTarget}" Value="True"><Setter Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/><Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/><Setter Property="BorderThickness" Value="1"/></DataTrigger>
                        </Style.Triggers>
                    </Style></Button.Style>
                    <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="FolderMultipleOutline" Width="18" Height="18" Margin="8,0,10,0"/><TextBlock Text="{Binding AllItemsLabel}"/></StackPanel>
                </Button>
                <ListBox x:Name="FolderList" Foreground="{DynamicResource App.Brush.TextPrimary}" ItemsSource="{Binding FolderNodes}" SelectedItem="{Binding SelectedFolderNode, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="6"
                         AutomationProperties.AutomationId="Library.Folders" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource LibraryRow}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <EventSetter Event="PreviewMouseMove" Handler="Node_PreviewMouseMove"/>
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Node_PreviewMouseRightButtonDown"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="44" Padding="5" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ContextMenu="{StaticResource LibraryFolderContextMenu}" BorderThickness="{Binding DropBorderThickness}" CornerRadius="5"
                                    MouseLeftButtonUp="Folder_Select">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource App.Brush.SelectionBackground}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDropGroupMember}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True"><Setter Property="Opacity" Value="0.45"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Indent}"/><ColumnDefinition Width="24"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Width="22" Height="28" Click="Folder_Expand"
                                            AutomationProperties.AutomationId="Library.ExpandFolder" ToolTip="{loc:Translate Key=Ui.Library.ExpandFolder}">
                                        <iconPacks:PackIconMaterial Width="14" Height="14">
                                            <iconPacks:PackIconMaterial.Style>
                                                <Style TargetType="iconPacks:PackIconMaterial"><Setter Property="Kind" Value="ChevronRight"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Kind" Value="ChevronDown"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconMaterial.Style>
                                        </iconPacks:PackIconMaterial>
                                    </Button>
                                    <iconPacks:PackIconMaterial Grid.Column="2" Kind="FolderOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Name}" Foreground="{DynamicResource App.Brush.TextPrimary}" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"
                      AutomationProperties.AutomationId="Library.FolderWidth"/>
        <Border Grid.Column="2" Style="{StaticResource TableCardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ItemsControl ItemsSource="{Binding Breadcrumbs}" Margin="16,12,16,6" AutomationProperties.AutomationId="Library.Breadcrumbs">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button controls:ControlsHelper.ContentCharacterCasing="Normal" Content="{Binding Name}" Style="{StaticResource ButtonToolbar}" FontSize="16" Padding="4,6"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            <TextBlock Text="{loc:Translate Key=Ui.Library.PathSeparator}" Margin="7,0" VerticalAlignment="Center" Foreground="{DynamicResource App.Brush.TextMuted}" Visibility="{Binding IsLast, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Row="1" Margin="16,4,16,16">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=160}"
                             AutomationProperties.AutomationId="Library.Search" MinHeight="40" Padding="36,7,32,7"
                             controls:TextBoxHelper.Watermark="{Binding SearchWatermark}"/>
                    <iconPacks:PackIconMaterial Kind="Magnify" Width="19" Height="19" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Button Command="{Binding ClearSearchCommand}" Style="{StaticResource ButtonIcon}" HorizontalAlignment="Right" Margin="0,0,4,0"
                            ToolTip="{loc:Translate Key=Ui.Library.ClearSearch}" Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                    </Button>
                </Grid>
                <Border Grid.Row="2" Padding="18,8" BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="0,1,0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ButtonToolbar}" Command="{Binding SortCommand}" HorizontalAlignment="Left" Padding="4,4" AutomationProperties.AutomationId="Library.SortName">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{loc:Translate Key=Ui.Library.Name}" FontWeight="SemiBold"/>
                                <iconPacks:PackIconMaterial Kind="{Binding SortIcon}" Width="12" Height="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource App.Brush.Accent}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{loc:Translate Key=Ui.Library.Description}" VerticalAlignment="Center" Foreground="{DynamicResource App.Brush.TextMuted}" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
                <ListBox Grid.Row="3" x:Name="LibraryNodes" Foreground="{DynamicResource App.Brush.TextPrimary}" ItemsSource="{Binding ContentNodes}" BorderThickness="0" Background="Transparent" Padding="0"
                         AutomationProperties.AutomationId="Library.Items" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource LibraryRow}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
                            <EventSetter Event="PreviewMouseMove" Handler="Node_PreviewMouseMove"/>
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Node_PreviewMouseRightButtonDown"/>
                            <EventSetter Event="MouseDoubleClick" Handler="Node_MouseDoubleClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border MinHeight="58" Padding="18,8" BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="0,0,0,1"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource LibraryItemContextMenu}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions>
                                <Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Kind="FileDocumentOutline" Width="22" Height="22" VerticalAlignment="Center" Foreground="{DynamicResource App.Brush.TextPrimary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource App.Brush.TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Subtitle}" Foreground="{DynamicResource App.Brush.TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Subtitle}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ButtonSecondary}" BorderBrush="{DynamicResource App.Brush.Accent}" Background="{DynamicResource App.Brush.AccentSubtle}" Padding="10,6" Margin="0,0,8,0"
                                            Command="{Binding DataContext.OpenNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Visibility><Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Converter="{StaticResource BooleanToVisibilityConverter}"/></Button.Visibility>
                                        <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="OpenInNew" Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource App.Brush.Accent}"/><TextBlock Text="{loc:Translate Key=Ui.Common.Open}"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ButtonIcon}" Click="ItemMenu_Click" ToolTip="{loc:Translate Key=Ui.Library.Actions}" AutomationProperties.AutomationId="Library.ItemActions">
                                        <iconPacks:PackIconMaterial Kind="DotsHorizontal" Width="20" Height="20"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="400" Visibility="{Binding HasContent, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="38" Height="38" Margin="0,0,0,14" Foreground="{DynamicResource App.Brush.Accent}"/>
                    <TextBlock Text="{Binding EmptyTitle}" TextAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding EmptyDescription}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,16" Foreground="{DynamicResource App.Brush.TextMuted}"/>
                    <Button Content="{Binding NewItemLabel}" Command="{Binding NewItemCommand}" Style="{StaticResource ButtonPrimary}" Visibility="{Binding HasSearchText, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <Button Content="{loc:Translate Key=Ui.Library.ResetSearch}" Command="{Binding ClearSearchCommand}" Style="{StaticResource ButtonSecondary}" Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <Border Grid.Row="4" Padding="18,12" BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding ContentCountText}" Foreground="{DynamicResource App.Brush.TextMuted}"/>
                </Border>
            </Grid>
        </Border>
        <Canvas Grid.ColumnSpan="3" Panel.ZIndex="100"
                ClipToBounds="True"
                IsHitTestVisible="False"
                Visibility="{Binding IsDragActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="DragPreview"
                    Padding="10,7"
                    MaxWidth="360"
                    Background="{DynamicResource App.Brush.Surface}"
                    BorderBrush="{DynamicResource App.Brush.Accent}"
                    BorderThickness="1"
                    CornerRadius="7">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="17" Height="17"
                                                Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource App.Brush.Accent}">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                                <Setter Property="Kind" Value="FileDocumentOutline"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DraggedItemIsFolder}" Value="True">
                                        <Setter Property="Kind" Value="Folder"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                    <TextBlock Text="{Binding DraggedItemName}"
                               MaxWidth="310"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
