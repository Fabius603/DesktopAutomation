<UserControl x:Class="DesktopAutomationApp.Views.Library.LibraryTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:behaviors="clr-namespace:DesktopAutomationApp.Behaviors"
             behaviors:ViewShortcutGuard.IsEnabled="True"
             AllowDrop="True"
             PreviewDragOver="LibraryTree_PreviewDragOver"
             PreviewDrop="LibraryTree_PreviewDrop"
             PreviewKeyDown="LibraryTree_PreviewKeyDown"
             GiveFeedback="LibraryTree_GiveFeedback">
    <UserControl.Resources>
        <ContextMenu x:Key="LibraryFolderContextMenu">
            <MenuItem Header="{Binding PlacementTarget.Tag.NewItemLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      InputGestureText="{loc:Translate Key=Shortcut.CtrlN}"
                      Command="{Binding PlacementTarget.Tag.NewItemInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.NewFolder}"
                      InputGestureText="{loc:Translate Key=Shortcut.CtrlShiftN}"
                      Command="{Binding PlacementTarget.Tag.NewSubfolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.RenameFolder}"
                      InputGestureText="{loc:Translate Key=Shortcut.F2}"
                      Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.MoveUpOneLevel}"
                      InputGestureText="{loc:Translate Key=Shortcut.AltUp}"
                      IsEnabled="{Binding PlacementTarget.DataContext.CanMoveUpOneLevel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Click="MoveUpOneLevel_Click"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.Delete}"
                      InputGestureText="{loc:Translate Key=Shortcut.Delete}"
                      Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
        <ContextMenu x:Key="LibraryItemContextMenu">
            <MenuItem Header="{loc:Translate Key=Ui.Common.Open}"
                      InputGestureText="{loc:Translate Key=Shortcut.Enter}"
                      Command="{Binding PlacementTarget.Tag.OpenNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="{loc:Translate Key=Ui.Common.Rename}"
                      InputGestureText="{loc:Translate Key=Shortcut.F2}"
                      Command="{Binding PlacementTarget.Tag.RenameNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.MoveUpOneLevel}"
                      InputGestureText="{loc:Translate Key=Shortcut.AltUp}"
                      IsEnabled="{Binding PlacementTarget.DataContext.CanMoveUpOneLevel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Click="MoveUpOneLevel_Click"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.Delete}"
                      InputGestureText="{loc:Translate Key=Shortcut.Delete}"
                      Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

    </UserControl.Resources>

    <Grid>
        <Border AllowDrop="True">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource TableCardStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRootDropTarget}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="14,12"
                        Background="{DynamicResource App.Brush.Surface}"
                        BorderBrush="{DynamicResource App.Brush.CardBorder}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="420" MaxWidth="520" HorizontalAlignment="Left">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36"
                                     Padding="34,6,34,6"
                                     controls:TextBoxHelper.Watermark="{loc:Translate Key=Ui.Library.Search}"/>
                            <iconPacks:PackIconMaterial Kind="Magnify"
                                                       Width="16" Height="16"
                                                       Margin="10,0,0,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource App.Brush.TextMuted}"
                                                       IsHitTestVisible="False"/>
                            <Button Style="{StaticResource ButtonIcon}"
                                    Command="{Binding ClearSearchCommand}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    ToolTip="{loc:Translate Key=Ui.Library.ClearSearch}"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <iconPacks:PackIconMaterial Kind="Close" Width="13" Height="13"/>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SearchResultText}"
                                   Margin="14,0,2,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Brush.TextMuted}"
                                   FontSize="12"
                                   Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="Transparent">
                    <ListBox x:Name="LibraryNodes" ItemsSource="{Binding VisibleNodes}"
                             Padding="8"
                             BorderThickness="0"
                             Background="Transparent"
                             AllowDrop="True"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="AllowDrop" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <EventSetter Event="PreviewMouseMove" Handler="Node_PreviewMouseMove"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="Node_PreviewMouseRightButtonDown"/>
                                <EventSetter Event="MouseDoubleClick" Handler="Node_MouseDoubleClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="42"
                                        Padding="9,6"
                                        Margin="2,1"
                                        BorderThickness="{Binding DropBorderThickness}"
                                        CornerRadius="7"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        MouseLeftButtonUp="Node_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="ContextMenu" Value="{StaticResource LibraryItemContextMenu}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                    <Setter Property="ContextMenu" Value="{StaticResource LibraryFolderContextMenu}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding DataContext.IsDragActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.BorderSubtle}"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.Brush.SelectionBackground}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.SelectionBorder}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.FocusBorder}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropGroupMember}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Indent}"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <iconPacks:PackIconMaterial Grid.Column="1"
                                                                    Width="14" Height="14"
                                                                    VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial.Style>
                                                <Style TargetType="iconPacks:PackIconMaterial">
                                                    <Setter Property="Kind" Value="ChevronRight"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Kind" Value="ChevronDown"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconMaterial.Style>
                                        </iconPacks:PackIconMaterial>

                                        <Border Grid.Column="2"
                                                Width="22" Height="22"
                                                VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Width="17" Height="17"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                <iconPacks:PackIconMaterial.Style>
                                                    <Style TargetType="iconPacks:PackIconMaterial">
                                                        <Setter Property="Kind" Value="FileDocumentOutline"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Kind" Value="Folder"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsFolder}" Value="True"/>
                                                                    <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Kind" Value="FolderOpen"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconMaterial.Style>
                                            </iconPacks:PackIconMaterial>
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{Binding Name}"
                                                   Margin="8,0,12,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Column="4"
                                                MinWidth="26"
                                                Padding="7,2"
                                                CornerRadius="9"
                                                Background="{DynamicResource App.Brush.SurfaceHover}"
                                                VerticalAlignment="Center"
                                                ToolTip="{loc:Translate Key=Ui.Library.ContainedItems}"
                                                Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ContainedItemCount}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                        </Border>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsItem}" Value="True"/>
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsItem}" Value="True"/>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{StaticResource ButtonIcon}"
                                                    Command="{Binding DataContext.OpenNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{loc:Translate Key=Ui.Common.Open}">
                                                <iconPacks:PackIconMaterial Kind="OpenInNew" Width="14" Height="14"/>
                                            </Button>
                                            <Button Style="{StaticResource ButtonIcon}"
                                                    Width="30" Height="30" Margin="2,0,0,0"
                                                    Command="{Binding DataContext.ExecuteNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{loc:Translate Key=Ui.Library.ExecuteOrStop}">
                                                <iconPacks:PackIconMaterial Width="13" Height="13">
                                                    <iconPacks:PackIconMaterial.Style>
                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                            <Setter Property="Kind" Value="Play"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Kind" Value="Stop"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconMaterial.Style>
                                                </iconPacks:PackIconMaterial>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="430"
                                Margin="24"
                                Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Border Width="58" Height="58"
                                Margin="0,0,0,14"
                                CornerRadius="14"
                                Background="{DynamicResource App.Brush.AccentSubtle}">
                            <iconPacks:PackIconMaterial Kind="FolderOpen"
                                                        Width="27" Height="27"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource App.Brush.Accent}"/>
                        </Border>
                        <TextBlock Text="{Binding EmptyTitle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding EmptyDescription}"
                                   Margin="0,6,0,16"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Brush.TextMuted}"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Button Content="{Binding NewItemLabel}"
                                    Command="{Binding NewItemCommand}"
                                    Style="{StaticResource ButtonPrimary}"/>
                            <Button Command="{Binding NewFolderCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderPlus" Width="14" Height="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="{loc:Translate Key=Ui.Library.NewFolder}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Content="{loc:Translate Key=Ui.Library.ResetSearch}"
                                Command="{Binding ClearSearchCommand}"
                                HorizontalAlignment="Center"
                                Style="{StaticResource ButtonSecondary}"
                                Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Canvas Panel.ZIndex="100"
                ClipToBounds="True"
                IsHitTestVisible="False"
                Visibility="{Binding IsDragActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="DragPreview"
                    Padding="10,7"
                    MaxWidth="360"
                    Background="{DynamicResource App.Brush.Surface}"
                    BorderBrush="{DynamicResource App.Brush.Accent}"
                    BorderThickness="1"
                    CornerRadius="7">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="17" Height="17"
                                                Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource App.Brush.Accent}">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                                <Setter Property="Kind" Value="FileDocumentOutline"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DraggedItemIsFolder}" Value="True">
                                        <Setter Property="Kind" Value="Folder"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                    <TextBlock Text="{Binding DraggedItemName}"
                               MaxWidth="310"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
