<UserControl x:Class="DesktopAutomationApp.Views.Library.LibraryTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             AllowDrop="True"
             PreviewDragOver="LibraryTree_PreviewDragOver"
             PreviewDrop="LibraryTree_PreviewDrop"
             GiveFeedback="LibraryTree_GiveFeedback">
    <UserControl.Resources>
        <ContextMenu x:Key="LibraryFolderContextMenu">
            <MenuItem Header="{Binding PlacementTarget.Tag.NewItemLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Command="{Binding PlacementTarget.Tag.NewItemInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.NewFolder}"
                      Command="{Binding PlacementTarget.Tag.NewSubfolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.RenameFolder}"
                      Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.MoveUpOneLevel}"
                      IsEnabled="{Binding PlacementTarget.DataContext.CanMoveUpOneLevel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Click="MoveUpOneLevel_Click"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.Delete}"
                      Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
        <ContextMenu x:Key="LibraryItemContextMenu">
            <MenuItem Header="{loc:Translate Key=Ui.Common.Open}"
                      Command="{Binding PlacementTarget.Tag.OpenNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.MoveUpOneLevel}"
                      IsEnabled="{Binding PlacementTarget.DataContext.CanMoveUpOneLevel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Click="MoveUpOneLevel_Click"/>
            <MenuItem Header="{loc:Translate Key=Ui.Library.Delete}"
                      Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ButtonSecondary}"
                        Command="{Binding NewFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FolderPlus" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Translate Key=Ui.Library.NewFolder}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="260"
                     MaxWidth="460"
                     HorizontalAlignment="Left"
                     ToolTip="{loc:Translate Key=Ui.Library.Search}"
                     controls:TextBoxHelper.Watermark="{loc:Translate Key=Ui.Library.Search}"
                     xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"/>
        </DockPanel>

        <Border Grid.Row="1"
                AllowDrop="True">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource TableCardStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRootDropTarget}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <ListBox ItemsSource="{Binding VisibleNodes}"
                         BorderThickness="0"
                         Background="Transparent"
                         AllowDrop="True"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="AllowDrop" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="PreviewMouseMove" Handler="Node_PreviewMouseMove"/>
                            <EventSetter Event="MouseDoubleClick" Handler="Node_MouseDoubleClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,7"
                                    BorderThickness="{Binding DropBorderThickness}"
                                    CornerRadius="{Binding DropCornerRadius}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    MouseLeftButtonUp="Node_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="ContextMenu" Value="{StaticResource LibraryItemContextMenu}"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                                               Value="True"/>
                                                    <Condition Binding="{Binding DataContext.IsDragActive, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDropGroupMember}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter Property="ContextMenu" Value="{StaticResource LibraryFolderContextMenu}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Indent}"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <iconPacks:PackIconMaterial Grid.Column="1"
                                                                Width="16" Height="16"
                                                                VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.Style>
                                            <Style TargetType="iconPacks:PackIconMaterial">
                                                <Setter Property="Kind" Value="ChevronRight"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Kind" Value="ChevronDown"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconMaterial.Style>
                                    </iconPacks:PackIconMaterial>

                                    <iconPacks:PackIconMaterial Grid.Column="2"
                                                                Width="17" Height="17"
                                                                VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.Style>
                                            <Style TargetType="iconPacks:PackIconMaterial">
                                                <Setter Property="Kind" Value="FileDocumentOutline"/>
                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="Kind" Value="Folder"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsFolder}" Value="True"/>
                                                            <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Kind" Value="FolderOpen"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconMaterial.Style>
                                    </iconPacks:PackIconMaterial>

                                    <StackPanel Grid.Column="3" Margin="6,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Opacity="0.68"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasSubtitle, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                Visibility="{Binding IsItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Style="{StaticResource ButtonIcon}"
                                                Command="{Binding DataContext.OpenNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:Translate Key=Ui.Common.Open}">
                                            <iconPacks:PackIconMaterial Kind="OpenInNew"
                                                                        Width="14"
                                                                        Height="14"/>
                                        </Button>
                                        <Button Style="{StaticResource ButtonTablePrimary}"
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.ExecuteNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:Translate Key=Ui.Library.ExecuteOrStop}">
                                            <iconPacks:PackIconMaterial Width="13" Height="13">
                                                <iconPacks:PackIconMaterial.Style>
                                                    <Style TargetType="iconPacks:PackIconMaterial">
                                                        <Setter Property="Kind" Value="Play"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Kind" Value="Stop"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconMaterial.Style>
                                            </iconPacks:PackIconMaterial>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding EmptyText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.65"
                           Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <Canvas Grid.RowSpan="2"
                Panel.ZIndex="100"
                ClipToBounds="True"
                IsHitTestVisible="False"
                Visibility="{Binding IsDragActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="DragPreview"
                    Padding="10,7"
                    MaxWidth="360"
                    Background="{DynamicResource App.Brush.Surface}"
                    BorderBrush="{DynamicResource App.Brush.Accent}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="3"
                                      Opacity="0.3"
                                      Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="17"
                                                Height="17"
                                                Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource App.Brush.Accent}">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                                <Setter Property="Kind" Value="FileDocumentOutline"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DraggedItemIsFolder}" Value="True">
                                        <Setter Property="Kind" Value="Folder"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                    <TextBlock Text="{Binding DraggedItemName}"
                               MaxWidth="310"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
