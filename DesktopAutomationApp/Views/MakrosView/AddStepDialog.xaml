<mah:MetroWindow x:Class="DesktopAutomationApp.Views.AddStepDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:local="clr-namespace:DesktopAutomationApp.Views"
                 xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="{Binding DialogTitle}"
                 Width="920" Height="680"
                 MinWidth="760" MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize" ShowInTaskbar="False"
                 Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource App.Brush.Surface}"
                BorderBrush="{DynamicResource App.Brush.CardBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="8"
                        Background="{DynamicResource App.Brush.AccentSubtle}"
                        Margin="0,0,14,0">
                    <iconPacks:PackIconMaterial Kind="TuneVariant"
                                               Width="21" Height="21"
                                               Foreground="{DynamicResource App.Brush.Accent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedStepDisplayName}"
                               Foreground="{DynamicResource App.Brush.TextPrimary}"
                               FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StepTypeDescription}"
                               Foreground="{DynamicResource App.Brush.TextMuted}"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource App.Brush.Surface}"
                    BorderBrush="{DynamicResource App.Brush.CardBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="12" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.Type}"
                               Foreground="{DynamicResource App.Brush.TextSecondary}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="2,0,0,8"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding StepTypes}"
                             SelectedItem="{Binding SelectedType}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource MacroStepTypeConverter}}"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SelectionIndicator"
                                                        Background="Transparent"
                                                        CornerRadius="2" Margin="0,5"/>
                                                <Border x:Name="ItemCard" Grid.Column="2"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="7">
                                                    <ContentPresenter Margin="11,8,10,8"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                                    <Setter TargetName="ItemCard" Property="BorderBrush" Value="{DynamicResource App.Brush.CardBorder}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource App.Brush.SelectionBackground}"/>
                                                    <Setter TargetName="ItemCard" Property="BorderBrush" Value="{DynamicResource App.Brush.SelectionBorder}"/>
                                                    <Setter TargetName="SelectionIndicator" Property="Background" Value="{DynamicResource App.Brush.SelectionBorder}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource App.Brush.Surface}"
                    BorderBrush="{DynamicResource App.Brush.CardBorder}"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="18,14">
                        <TextBlock Text="{Binding SelectedStepDisplayName}"
                                   Foreground="{DynamicResource App.Brush.TextPrimary}"
                                   FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedStepCategory}"
                                   Foreground="{DynamicResource App.Brush.TextMuted}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource App.Brush.CardBorder}"
                            BorderThickness="0,1,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="18,16">
                            <local:MacroStepFields/>
</ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource App.Brush.Surface}"
                BorderBrush="{DynamicResource App.Brush.CardBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="AlertCircleOutline"
                                               Foreground="#FFD13438" Width="16" Height="16"
                                               Margin="0,0,8,0"
                                               Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding ValidationError}"
                               Foreground="#FFD13438" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:Translate Key=Ui.Common.Cancel}"
                            IsCancel="True" Margin="0,0,8,0"
                            Click="Cancel_Click"
                            Style="{StaticResource ButtonSecondary}"/>
                    <Button Content="{Binding ConfirmButtonText}"
                            IsDefault="True" MinWidth="110"
                            Click="Ok_Click"
                            Style="{StaticResource ButtonPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
