<UserControl x:Class="DesktopAutomationApp.Views.MacroStepFields" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopAutomationApp.Localization" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"><UserControl.Resources><Style x:Key="GeometryCard" TargetType="Border"><Setter Property="Margin" Value="0,0,0,22"/><Setter Property="Padding" Value="0"/></Style></UserControl.Resources><StackPanel><StackPanel Margin="0,0,0,18" Visibility="{Binding ShowText, Converter={StaticResource BooleanToVisibilityConverter}}">
<TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.Text}" Margin="0,0,0,8"/>
<TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Macro.Text"/>
</StackPanel>

                                <Border Style="{StaticResource GeometryCard}"
                                        Visibility="{Binding ShowMouseXY, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.Position}"
                                                   Style="{StaticResource GeometrySectionHeader}" Margin="0,0,0,10"/>
                                        <WrapPanel>
                                            <StackPanel Style="{StaticResource GeometryFieldContainer}">
                                                <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.X}" Style="{StaticResource GeometryFieldLabel}"/>
                                                <TextBox Text="{Binding XInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GeometryNumberInput}"/>
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource GeometryFieldContainer}">
                                                <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.Y}" Style="{StaticResource GeometryFieldLabel}"/>
                                                <TextBox Text="{Binding YInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GeometryNumberInput}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GeometryCard}"
                                        Visibility="{Binding ShowMouseDelta, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.Offset}"
                                                   Style="{StaticResource GeometrySectionHeader}" Margin="0,0,0,10"/>
                                        <WrapPanel>
                                            <StackPanel Style="{StaticResource GeometryFieldContainer}">
                                                <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.DeltaX}" Style="{StaticResource GeometryFieldLabel}"/>
                                                <TextBox Text="{Binding DeltaXInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GeometryNumberInput}"/>
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource GeometryFieldContainer}">
                                                <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.DeltaY}" Style="{StaticResource GeometryFieldLabel}"/>
                                                <TextBox Text="{Binding DeltaYInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GeometryNumberInput}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GeometryCard}"
                                        Visibility="{Binding ShowMouseButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.Button}" Style="{StaticResource GeometryFieldLabel}"/>
                                        <ComboBox Width="220" HorizontalAlignment="Left"
                                                  SelectedValuePath="Tag" SelectedValue="{Binding MouseButton}">
                                            <ComboBoxItem Tag="Left" Content="{loc:Translate Key=Ui.Macro.StepEditor.Left}"/>
                                            <ComboBoxItem Tag="Right" Content="{loc:Translate Key=Ui.Macro.StepEditor.Right}"/>
                                            <ComboBoxItem Tag="Middle" Content="{loc:Translate Key=Ui.Macro.StepEditor.Middle}"/>
<ComboBoxItem Tag="X1" Content="{loc:Translate Key=Ui.Macro.StepEditor.X1}"/><ComboBoxItem Tag="X2" Content="{loc:Translate Key=Ui.Macro.StepEditor.X2}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GeometryCard}"
                                        Visibility="{Binding ShowKey, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.Key}" Style="{StaticResource GeometryFieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox IsReadOnly="True" Text="{Binding Key}"/>
                                            <Button Grid.Column="1" Margin="8,0,0,0"
                                                    Command="{Binding CaptureKeyCommand}"
                                                    Content="{Binding CaptureButtonText}"
                                                    Style="{StaticResource ButtonSecondary}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GeometryCard}"
                                        Visibility="{Binding ShowDuration, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.Duration}" Style="{StaticResource GeometryFieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding DurationValueInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource GeometryNumberInput}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding DurationUnits}"
                                                      SelectedItem="{Binding SelectedDurationUnit}"
                                                      DisplayMemberPath="Label" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GeometryCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.DelayBefore}"
                                                   Style="{StaticResource GeometrySectionHeader}"/>
                                        <TextBlock Text="{loc:Translate Key=Ui.Macro.StepEditor.DelayBefore.Help}"
                                                   Style="{StaticResource GeometrySummary}" Margin="0,3,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox AutomationProperties.AutomationId="Macro.DelayBefore" Text="{Binding DelayBeforeValueInput, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     Style="{StaticResource GeometryNumberInput}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding DelayUnits}"
                                                      SelectedItem="{Binding SelectedDelayUnit}"
                                                      DisplayMemberPath="Label" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </UserControl>