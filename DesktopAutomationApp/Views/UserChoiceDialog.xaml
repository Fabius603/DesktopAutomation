<mah:MetroWindow x:Class="DesktopAutomationApp.Views.UserChoiceDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
                 WindowStartupLocation="CenterOwner"
                 MinWidth="360" MaxWidth="640"
                 MinHeight="150" MaxHeight="720"
                 SizeToContent="WidthAndHeight"
                 ResizeMode="NoResize"
                 WindowStyle="None"
                 AllowsTransparency="True"
                 Topmost="True"
                 ShowActivated="True"
                 ShowCloseButton="False"
                 ShowMinButton="False"
                 ShowMaxRestoreButton="False"
                 ShowInTaskbar="False"
                 ShowTitleBar="False"
                 Background="Transparent"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 GlowBrush="Transparent"
                 Style="{StaticResource DialogWindowStyle}">
    <mah:MetroWindow.Resources>
        <Style x:Key="UserChoiceOptionStyle"
               TargetType="Button"
               BasedOn="{StaticResource MahApps.Styles.Button}">
            <Setter Property="MinHeight" Value="68"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Background" Value="{DynamicResource App.Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OptionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource App.Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OptionBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource App.Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <Border Background="{DynamicResource App.Brush.WindowBackground}"
            CornerRadius="14"
            ClipToBounds="True">
        <Grid Margin="17">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="HeaderPanel" Margin="5,5,5,0">
                <emoji:TextBlock x:Name="QuestionText" FontSize="20" FontWeight="SemiBold"
                                 TextWrapping="Wrap"/>
                <emoji:TextBlock x:Name="DescriptionText" Margin="0,8,0,0"
                                 Foreground="{DynamicResource App.Brush.TextSecondary}"
                                 TextWrapping="Wrap"/>
            </StackPanel>

            <ItemsControl x:Name="OptionsList" Grid.Row="1" Margin="0,15,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Option_Click"
                                Style="{StaticResource UserChoiceOptionStyle}">
                            <emoji:TextBlock Text="{Binding Label}"
                                             Loaded="OptionText_Loaded"
                                             SizeChanged="OptionText_SizeChanged"
                                             MaxWidth="540"
                                             MaxHeight="48"
                                             LineHeight="24"
                                             LineStackingStrategy="BlockLineHeight"
                                             VerticalAlignment="Center"
                                             TextWrapping="Wrap"
                                             TextTrimming="CharacterEllipsis"
                                             TextAlignment="Center"
                                             FontWeight="Normal"
                                             ToolTip="{Binding Label}"
                                             ToolTipService.InitialShowDelay="250"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</mah:MetroWindow>
