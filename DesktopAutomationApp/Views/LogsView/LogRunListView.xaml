<UserControl x:Class="DesktopAutomationApp.Views.LogRunListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopAutomationApp.Localization" xmlns:vm="clr-namespace:DesktopAutomationApp.ViewModels" xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{DynamicResource App.Brush.Danger}" Background="{DynamicResource App.Brush.DangerSubtle}">
            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsOverview}" Value="True"/><Condition Binding="{Binding HasAttention}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
            <DockPanel><Button Content="{loc:Translate Key=Logs.Ui.MarkAllSeen}" Command="{Binding MarkAllSeenCommand}" Style="{StaticResource LogButton}" DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="14" AutomationProperties.AutomationId="Logs.MarkAllSeen"/><Button Content="{loc:Translate Key=Logs.Ui.ViewProblems}" Command="{Binding AttentionCommand}" DockPanel.Dock="Right" Style="{StaticResource LogButton}" AutomationProperties.AutomationId="Logs.Attention"/><icon:PackIconMaterial Kind="AlertCircle" Width="30" Height="30" Foreground="{DynamicResource App.Brush.DangerLight}" Margin="0,0,18,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="{Binding AttentionText}" Style="{StaticResource LogText}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding AttentionSummary}" Style="{StaticResource LogMuted}" Margin="0,5,0,0"/></StackPanel></DockPanel>
        </Border>
        <StackPanel Grid.Row="1">
            <TextBlock Text="{loc:Translate Key=Logs.Ui.RecentRuns}" Style="{StaticResource LogHeading}" Margin="0,12,0,14" Visibility="{Binding IsOverview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Grid Visibility="{Binding IsOverview, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,12,0"><TextBox FontSize="16" MinHeight="48" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=350}" Padding="40,10,12,10" ToolTip="{loc:Translate Key=Logs.Ui.Search}" AutomationProperties.Name="{loc:Translate Key=Logs.Ui.Search}" AutomationProperties.AutomationId="Logs.OverviewSearch"/><icon:PackIconMaterial Kind="Magnify" Width="19" Height="19" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Text="{loc:Translate Key=Logs.Ui.Search}" Margin="40,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource App.Brush.TextMuted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                <ComboBox Style="{StaticResource LogCombo}" Grid.Column="1" ItemsSource="{Binding Ranges}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Range}" FontSize="16" Margin="0,0,12,0" AutomationProperties.Name="{loc:Translate Key=Logs.Ui.Period}"/>
                <ComboBox Style="{StaticResource LogCombo}" Grid.Column="2" ItemsSource="{Binding Outcomes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Outcome}" FontSize="16" AutomationProperties.Name="{loc:Translate Key=Logs.Ui.AllResults}"/>
            </Grid>
            <WrapPanel Margin="0,0,0,14" Visibility="{Binding IsJobs, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ComboBox Style="{StaticResource LogCombo}" ItemsSource="{Binding Sources}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Source}" MinWidth="170" Margin="0,0,12,0" AutomationProperties.AutomationId="Logs.Source" AutomationProperties.Name="{loc:Translate Key=Logs.Ui.AllRuns}"/>
                <ComboBox Style="{StaticResource LogCombo}" ItemsSource="{Binding RunSources}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SourceId}" MinWidth="200" Margin="0,0,12,0" AutomationProperties.AutomationId="Logs.SourceId" AutomationProperties.Name="{loc:Translate Key=Logs.Ui.AllJobs}"/>
                <CheckBox IsChecked="{Binding OnlyNewProblems}" Content="{loc:Translate Key=Logs.Ui.OnlyNewProblems}" VerticalAlignment="Center" Margin="12,0" AutomationProperties.AutomationId="Logs.OnlyNewProblems"/><CheckBox IsChecked="{Binding OnlyProblems}" Content="{loc:Translate Key=Logs.Ui.OnlyProblems}" VerticalAlignment="Center" AutomationProperties.AutomationId="Logs.OnlyProblems"/>
            </WrapPanel>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource TableCardStyle}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="16,14" Background="{DynamicResource App.Brush.Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Translate Key=Logs.Ui.Job}" Style="{StaticResource LogText}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{loc:Translate Key=Logs.Ui.Result}" Style="{StaticResource LogText}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{loc:Translate Key=Logs.Ui.Origin}" Style="{StaticResource LogText}" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="{loc:Translate Key=Logs.Ui.Start}" Style="{StaticResource LogText}" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="{loc:Translate Key=Logs.Ui.Duration}" Style="{StaticResource LogText}" FontWeight="SemiBold"/></Grid>
                <ListBox x:Name="RunList" Grid.Row="1" ItemsSource="{Binding Runs}" Style="{StaticResource LogList}" ItemContainerStyle="{StaticResource LogRow}" ItemTemplate="{StaticResource LogRunTemplate}" MouseLeftButtonUp="OpenRun" KeyDown="OnKeyDown" AutomationProperties.AutomationId="Logs.Runs"/>
                <TextBlock Grid.Row="1" Text="{loc:Translate Key=Logs.Ui.EmptyRuns}" Margin="24"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LogMuted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Runs.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" Visibility="{Binding IsJobs, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,16"><Button Content="{loc:Translate Key=Logs.Ui.More}" Command="{Binding MoreCommand}" Style="{StaticResource LogButton}" DockPanel.Dock="Right" Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="Logs.MoreRuns"/><TextBlock Text="{Binding CountText}" Style="{StaticResource LogMuted}" VerticalAlignment="Center"/></DockPanel>
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Visibility="{Binding IsOverview, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel><TextBlock Text="{loc:Translate Key=Logs.Ui.RecentAutomations}" Style="{StaticResource LogHeading}" FontSize="24"/>
                <ItemsControl ItemsSource="{Binding AutomationRows}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,10"><TextBlock Text="{Binding Item.Name}" Style="{StaticResource LogText}" Width="240"/><TextBlock Text="{Binding Time}" Style="{StaticResource LogMuted}" Width="180"/><TextBlock Text="{Binding Title}" Style="{StaticResource LogMuted}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Button Content="{loc:Translate Key=Logs.Ui.AllEvents}" Command="{Binding ChangePageCommand}" CommandParameter="{x:Static vm:LogPageKind.Automations}" Style="{StaticResource LogButton}" HorizontalAlignment="Right" Margin="0,12,0,0" AutomationProperties.AutomationId="Logs.AllAutomationEvents"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
