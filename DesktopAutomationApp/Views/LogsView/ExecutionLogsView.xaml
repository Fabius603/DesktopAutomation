<UserControl x:Class="DesktopAutomationApp.Views.ExecutionLogsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopAutomationApp.Localization" xmlns:views="clr-namespace:DesktopAutomationApp.Views">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" MinWidth="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*" MinWidth="260"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBox}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="{loc:Translate Key=Logs.Ui.Timeline}" Style="{StaticResource LogHeading}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,16"><RadioButton Content="{loc:Translate Key=Logs.Ui.AllSteps}" Style="{StaticResource LogTab}" IsChecked="{Binding StepProblems, Converter={StaticResource InverseBooleanConverter}}" GroupName="StepFilter" Margin="0,0,12,0" AutomationProperties.AutomationId="Logs.AllSteps"/><RadioButton Content="{loc:Translate Key=Logs.Ui.OnlyProblems}" Style="{StaticResource LogTab}" IsChecked="{Binding StepProblems}" GroupName="StepFilter" AutomationProperties.AutomationId="Logs.StepProblems"/></StackPanel></StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" Style="{StaticResource LogList}" ItemContainerStyle="{StaticResource LogStepRow}" ItemTemplate="{StaticResource LogStepTemplate}" VirtualizingStackPanel.ScrollUnit="Pixel" AutomationProperties.AutomationId="Logs.Steps"/>
            <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="{Binding StepCounts}" Style="{StaticResource LogMuted}"/><TextBlock Text="{Binding TimelineDate}" Style="{StaticResource LogMuted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        </Grid></Border>
        <views:LogDetailPanel Grid.Column="2"/>
    </Grid>
</UserControl>
