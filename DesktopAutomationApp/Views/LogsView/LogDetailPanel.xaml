<UserControl x:Class="DesktopAutomationApp.Views.LogDetailPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopAutomationApp.Localization" xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Border Style="{StaticResource CardBox}" Padding="22">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <DockPanel Margin="0,0,0,12"><icon:PackIconMaterial Kind="{Binding SelectedStep.Icon}" Width="30" Height="30" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{Binding SelectedStep.IconBrush}" Visibility="{Binding IsRunDetail, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="{Binding DetailTitle}" Style="{StaticResource LogHeading}" TextWrapping="Wrap"/></DockPanel>
            <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource LogProblemPanel}"><Style.Triggers><DataTrigger Binding="{Binding IsApplication}" Value="True"><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><icon:PackIconMaterial Tag="{Binding DetailTone}" Style="{StaticResource LogStatusIcon}" Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Top"/><StackPanel><TextBlock Text="{Binding DetailSeverity}" Style="{StaticResource LogTone}" Tag="{Binding DetailTone}" FontWeight="SemiBold" Margin="0,0,0,8" Visibility="{Binding IsApplication, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="{Binding DiagnosticTitle}" Visibility="{Binding IsApplication, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Style="{StaticResource LogTone}" Tag="{Binding DetailTone}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding DetailSummary}" FontSize="16" Style="{StaticResource LogMuted}" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
            <StackPanel Visibility="{Binding HasImpact, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,12,0,12"><TextBlock Text="{loc:Translate Key=Logs.Ui.Impact}" Style="{StaticResource Heading3}"/><TextBlock Text="{Binding Impact}" Style="{StaticResource LogMuted}"/></StackPanel>
            <StackPanel Visibility="{Binding ShowHelp, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,12,0,16"><TextBlock Text="{loc:Translate Key=Logs.Ui.Help}" Style="{StaticResource Heading3}"/><TextBlock Text="{Binding Help}" Style="{StaticResource LogMuted}"/></StackPanel>
            <WrapPanel Visibility="{Binding IsRunDetail, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,12,0,8">
                <Button Content="{loc:Translate Key=Logs.Ui.OpenStep}" Command="{Binding OpenStepCommand}" Style="{StaticResource LogPrimaryButton}" Margin="0,0,8,8" AutomationProperties.AutomationId="Logs.OpenStep"/>
                <Button Content="{loc:Translate Key=Logs.Ui.OpenCause}" Command="{Binding OpenCauseCommand}" Style="{StaticResource LogButton}" Margin="0,0,8,8" Visibility="{Binding HasCause, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="Logs.OpenCause"/>
                
                
            </WrapPanel>
            <TextBlock Text="{Binding NavigationReason}" Style="{StaticResource LogMuted}" Visibility="{Binding HasNavigationReason, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12"/>
            <ItemsControl Visibility="{Binding IsRunDetail, Converter={StaticResource BooleanToVisibilityConverter}}" ItemsSource="{Binding PathActions}" ItemTemplate="{StaticResource LogPathTemplate}"></ItemsControl>
            <StackPanel Visibility="{Binding ShowRelatedRun, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,8">
                <TextBlock Text="{loc:Translate Key=Logs.Ui.RelatedRun}" Style="{StaticResource Heading3}"/>
                <Button Content="{Binding RelatedRunText}" Command="{Binding OpenRelatedRunCommand}" Style="{StaticResource LogButton}" HorizontalContentAlignment="Left" AutomationProperties.AutomationId="Logs.RelatedRun"/>
            </StackPanel>
            <StackPanel Visibility="{Binding IsAutomation, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,12,0,12">
                <TextBlock Text="{Binding SelectedTrigger.Context}" Style="{StaticResource LogMuted}" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding Eligibility}" Style="{StaticResource LogMuted}" Margin="0,0,0,16" Visibility="{Binding HasEligibility, Converter={StaticResource BooleanToVisibilityConverter}}"/><ItemsControl ItemsSource="{Binding RelatedRuns}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="{Binding UnavailableReason}" Style="{StaticResource LogPrimaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding ExecutionNumber, StringFormat='#{0}'}"/><TextBlock Text="{Binding Result}"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Button Content="{loc:Translate Key=Logs.Ui.OpenAutomation}" Command="{Binding OpenAutomationCommand}" Style="{StaticResource LogButton}" IsEnabled="{Binding CanOpenAutomation}" HorizontalAlignment="Left"/>
            </StackPanel>
            <Border BorderBrush="{DynamicResource App.Brush.BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                <Expander Style="{StaticResource LogExpander}" Header="{loc:Translate Key=Logs.Ui.Technical}" AutomationProperties.AutomationId="Logs.Technical">
                    <StackPanel><TextBox Text="{Binding TechnicalText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" BorderThickness="1" Padding="12" MaxHeight="240" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Logs.TechnicalText"/><ItemsControl Visibility="{Binding IsApplication, Converter={StaticResource BooleanToVisibilityConverter}}" ItemsSource="{Binding PathActions}" ItemTemplate="{StaticResource LogPathTemplate}"></ItemsControl><TextBlock Text="{Binding Help}" Style="{StaticResource LogMuted}" FontSize="14" Margin="0,8" Visibility="{Binding IsApplication, Converter={StaticResource BooleanToVisibilityConverter}}"/><WrapPanel Visibility="{Binding IsRunDetail, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Content="{loc:Translate Key=Logs.Ui.OpenJob}" Command="{Binding OpenJobCommand}" IsEnabled="{Binding CanOpenJob}" Style="{StaticResource LogButton}" Margin="0,8,8,0"/><Button Content="{loc:Translate Key=Logs.Ui.OpenOrigin}" Command="{Binding OpenOriginCommand}" IsEnabled="{Binding CanOpenOrigin}" Style="{StaticResource LogButton}" Margin="0,8,0,0"/></WrapPanel></StackPanel>
                </Expander>
            </Border>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="1">            <WrapPanel><Button Content="{loc:Translate Key=Logs.Ui.Copy}" Command="{Binding CopyCommand}" IsEnabled="{Binding CanCopy}" Style="{StaticResource LogButton}" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.AutomationId="Logs.Copy"/><TextBlock Text="{Binding AttentionProblemState}" Style="{StaticResource LogMuted}" FontSize="14" VerticalAlignment="Center" Margin="12,12,0,0" MaxWidth="230" Visibility="{Binding HasAttentionProblem, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="Logs.AttentionState"/></WrapPanel>
            <Button Content="{loc:Translate Key=Logs.Ui.NextProblem}" Command="{Binding OpenNewProblemCommand}" Style="{StaticResource LogButton}" Visibility="{Binding HasNextProblem, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Left" Margin="0,8,0,0" FontSize="14" AutomationProperties.AutomationId="Logs.NextProblem"/>
            <StackPanel Visibility="{Binding HasAttentionProblem, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,0">
                <WrapPanel><Button Content="{loc:Translate Key=Logs.Ui.ResolveProblem}" Command="{Binding ResolveProblemCommand}" Style="{StaticResource LogButton}" Margin="0,6,8,0" FontSize="14" MinHeight="36" Padding="12,6" AutomationProperties.AutomationId="Logs.ResolveProblem"/><Button Content="{loc:Translate Key=Logs.Ui.ReopenProblem}" Command="{Binding ReopenProblemCommand}" Style="{StaticResource LogButton}" Margin="0,6,0,0" FontSize="14" MinHeight="36" Padding="12,6" AutomationProperties.AutomationId="Logs.ReopenProblem"/></WrapPanel>
            </StackPanel>
<Expander Visibility="{Binding HasAttentionSummary, Converter={StaticResource BooleanToVisibilityConverter}}" Header="{Binding AttentionSummaryState}" Style="{StaticResource LogExpander}" AutomationProperties.AutomationId="Logs.AttentionSummary" MaxHeight="170"><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="110"><StackPanel Margin="0,8,0,12"><TextBlock Text="{loc:Translate Key=Logs.Ui.AttentionSummary}" Style="{StaticResource LogMuted}" FontSize="14"/><TextBlock Text="{Binding AttentionSummaryState}" Style="{StaticResource LogMuted}" FontSize="14"/><WrapPanel><Button Content="{loc:Translate Key=Logs.Ui.MarkSeen}" Command="{Binding SeeSummaryCommand}" Style="{StaticResource LogButton}" FontSize="14" Margin="0,6,8,0" AutomationProperties.AutomationId="Logs.SeeSummary"/><Button Content="{loc:Translate Key=Logs.Ui.ResolveProblem}" Command="{Binding ResolveSummaryCommand}" Style="{StaticResource LogButton}" FontSize="14" Margin="0,6,8,0"/><Button Content="{loc:Translate Key=Logs.Ui.ReopenProblem}" Command="{Binding ReopenSummaryCommand}" Style="{StaticResource LogButton}" FontSize="14" Margin="0,6,0,0"/></WrapPanel></StackPanel></ScrollViewer></Expander>
            <TextBlock Text="{loc:Translate Key=Logs.Ui.Privacy}" Style="{StaticResource LogMuted}" FontSize="11" Margin="0,8,0,0"/>
</StackPanel></Grid>
    </Border>
</UserControl>
