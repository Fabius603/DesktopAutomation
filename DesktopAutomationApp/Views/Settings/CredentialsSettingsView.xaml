<UserControl x:Class="DesktopAutomationApp.Views.CredentialsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0" ToolTip="{loc:Translate Key=Ui.Common.Refresh}">
                    <iconPacks:PackIconMaterial Kind="Refresh" Width="15" Height="15"/>
                </Button>
                <Button Command="{Binding NewCommand}" Style="{StaticResource ButtonPrimary}">
                    <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Plus" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="{loc:Translate Key=Settings.Credentials.Add}"/></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Translate Key=Settings.Credentials.Title}" Style="{StaticResource Heading1}"/>
                <TextBlock Text="{loc:Translate Key=Settings.Credentials.Description}" Foreground="{DynamicResource App.Brush.TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                 mah:TextBoxHelper.Watermark="{loc:Translate Key=Settings.Credentials.Search}"
                 ToolTip="{loc:Translate Key=Settings.Credentials.Search}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="8">
                <ListBox ItemsSource="{Binding Secrets}" SelectedItem="{Binding SelectedSecret, Mode=TwoWay}"
                         Style="{StaticResource StepCardListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource App.Brush.TextSecondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <iconPacks:PackIconMaterial Grid.Column="1" Kind="KeyVariant" Width="18" Height="18" Foreground="{DynamicResource App.Brush.Accent}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <iconPacks:PackIconMaterial Kind="KeyVariant" Width="42" Height="42" Foreground="{DynamicResource App.Brush.TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Translate Key=Settings.Credentials.Empty}" Foreground="{DynamicResource App.Brush.TextSecondary}" Margin="0,12,0,0"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedSecret.Name}" Style="{StaticResource Heading1}"/>
                        <TextBlock Text="{Binding SelectedSecret.Description}" Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,16"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Translate Key=Settings.Credentials.Updated}" Foreground="{DynamicResource App.Brush.TextSecondary}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedSecret.UpdatedDisplay}"/>
                        </Grid>
                        <TextBlock Text="{loc:Translate Key=Settings.Credentials.HiddenHint}" Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <WrapPanel>
                            <Button Command="{Binding EditCommand}" Style="{StaticResource ButtonSecondary}" Content="{loc:Translate Key=Ui.Common.Edit}" Margin="0,0,8,8"/>
                            <Button Command="{Binding ReplaceCommand}" Style="{StaticResource ButtonSecondary}" Content="{loc:Translate Key=Settings.Credentials.Replace}" Margin="0,0,8,8"/>
                            <Button Command="{Binding DeleteCommand}" Style="{StaticResource ButtonDanger}" Content="{loc:Translate Key=Settings.Credentials.Delete}" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>

                    <ScrollViewer Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Key=Settings.Credentials.EditorTitle}" Style="{StaticResource Heading1}" Margin="0,0,0,16"/>
                            <TextBlock Text="{loc:Translate Key=Ui.Dialog.Name}" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" MaxLength="120"/>
                            <TextBlock Text="{loc:Translate Key=Settings.Credentials.SecretDescription}" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" MaxLength="2000"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalScrollBarVisibility="Auto"/>

                            <StackPanel Visibility="{Binding IsSecretInputVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{loc:Translate Key=Settings.Credentials.SecretValue}" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="SecretPasswordBox" PasswordChanged="SecretPasswordBox_OnPasswordChanged"
                                             Margin="0,6,0,14"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource App.Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Command="{Binding SaveCommand}" Style="{StaticResource ButtonPrimary}" Content="{loc:Translate Key=Ui.Common.Save}" Margin="0,0,8,0"/>
                                <Button Command="{Binding CancelCommand}" Style="{StaticResource ButtonSecondary}" Content="{loc:Translate Key=Ui.Common.Cancel}"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
