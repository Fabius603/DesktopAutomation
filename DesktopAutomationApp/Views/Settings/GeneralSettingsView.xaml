<UserControl x:Class="DesktopAutomationApp.Views.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization">
    <UserControl.Resources>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SettingsDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="{loc:Translate Key=Settings.Navigation.General}" Style="{StaticResource Heading1}" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SettingsSectionCardStyle}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{loc:Translate Settings.Language}" Style="{StaticResource Heading2}"/>
                            <TextBlock Text="{loc:Translate Settings.Language.Description}" Style="{StaticResource SettingsDescription}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SettingsSectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.Appearance}" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Settings.Theme}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Margin="0,7,0,12"/>
                        <TextBlock Text="{loc:Translate Settings.Accent}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent, Mode=TwoWay}" Margin="0,7,0,0">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Fill="{Binding Color}" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Translate Settings.Startup}" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource SettingsDescription}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Translate Settings.StartWithWindows}" Style="{StaticResource SettingsLabel}"/><TextBlock Text="{loc:Translate Settings.StartWithWindows.Description}" Style="{StaticResource SettingsDescription}"/></StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" IsEnabled="{Binding CanConfigureStartup}" AutomationProperties.AutomationId="StartupEnabled" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Translate Settings.StartInBackground}" Style="{StaticResource SettingsLabel}"/><TextBlock Text="{loc:Translate Settings.StartInBackground.Description}" Style="{StaticResource SettingsDescription}"/></StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StartInBackgroundAtWindowsStartup, Mode=TwoWay}" IsEnabled="{Binding CanConfigureBackgroundStartup}" AutomationProperties.AutomationId="StartupBackground" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSectionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="{loc:Translate Key=Settings.ForceStopKey.Title}" Style="{StaticResource Heading2}"/><TextBlock Text="{loc:Translate Key=Settings.ForceStopKey.Description}" Style="{StaticResource SettingsDescription}" Margin="0,3,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border MinWidth="64" Padding="12,7" Margin="0,0,10,0" CornerRadius="6" Background="{DynamicResource App.Brush.WindowBackground}"><TextBlock Text="{Binding ForceStopKeyDisplay}" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border>
                        <Button Command="{Binding CaptureForceStopKeyCommand}" Style="{StaticResource ButtonSecondary}" Content="{Binding ForceStopKeyButtonText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
