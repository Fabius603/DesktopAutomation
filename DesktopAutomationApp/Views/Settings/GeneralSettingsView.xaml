<UserControl x:Class="DesktopAutomationApp.Views.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <Style x:Key="SettingsSectionIcon" TargetType="Border">
            <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="8"/><Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/>
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SettingsDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="{loc:Translate Key=Settings.Navigation.General}" Style="{StaticResource Heading1}" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource SettingsSectionIcon}">
                                <iconPacks:PackIconMaterial Kind="Translate" Width="19" Height="19" Foreground="{DynamicResource App.Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Settings.Language}" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="{loc:Translate Settings.Language.Description}" Style="{StaticResource SettingsDescription}"/>
                            </StackPanel>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource SettingsSectionIcon}">
                                <iconPacks:PackIconMaterial Kind="PaletteOutline" Width="19" Height="19" Foreground="{DynamicResource App.Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{loc:Translate Settings.Appearance}" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Translate Settings.Theme}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Margin="0,7,0,12"/>
                        <TextBlock Text="{loc:Translate Settings.Accent}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent, Mode=TwoWay}" Margin="0,7,0,0">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Fill="{Binding Color}" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource SettingsSectionIcon}">
                            <iconPacks:PackIconMaterial Kind="RocketLaunchOutline" Width="19" Height="19" Foreground="{DynamicResource App.Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{loc:Translate Settings.Startup}" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Translate Settings.StartWithWindows}" Style="{StaticResource SettingsLabel}"/><TextBlock Text="{loc:Translate Settings.StartWithWindows.Description}" Style="{StaticResource SettingsDescription}"/></StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Translate Settings.StartInBackground}" Style="{StaticResource SettingsLabel}"/><TextBlock Text="{loc:Translate Settings.StartInBackground.Description}" Style="{StaticResource SettingsDescription}"/></StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StartInBackgroundAtWindowsStartup, Mode=TwoWay}" IsEnabled="{Binding StartWithWindows}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingsSectionIcon}">
                        <iconPacks:PackIconMaterial Kind="KeyboardOutline" Width="19" Height="19" Foreground="{DynamicResource App.Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="{loc:Translate Key=Settings.ForceStopKey.Title}" Style="{StaticResource Heading2}"/><TextBlock Text="{loc:Translate Key=Settings.ForceStopKey.Description}" Style="{StaticResource SettingsDescription}"/></StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border MinWidth="64" Padding="12,7" Margin="0,0,10,0" CornerRadius="6" Background="{DynamicResource App.Brush.WindowBackground}"><TextBlock Text="{Binding ForceStopKeyDisplay}" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border>
                        <Button Command="{Binding CaptureForceStopKeyCommand}" Style="{StaticResource ButtonSecondary}" Content="{Binding ForceStopKeyButtonText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
