<mah:MetroWindow x:Class="DesktopAutomationApp.Views.AddJobStepDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
 xmlns:conv="clr-namespace:DesktopAutomationApp.Converters"
 xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
 Width="1120" Height="610" MinWidth="940" MinHeight="480"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
 Title="{Binding DialogTitle}" Style="{StaticResource DialogWindowStyle}"
 WindowTitleBrush="{DynamicResource App.Brush.Surface}" NonActiveWindowTitleBrush="{DynamicResource App.Brush.Surface}"
 TitleForeground="{DynamicResource App.Brush.TextPrimary}" FontSize="14">
 <mah:MetroWindow.Resources>
  <Style x:Key="DialogPrimaryAction" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}"><Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal"/></Style>
  <Style x:Key="DialogSecondaryAction" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}"><Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal"/></Style>
  <conv:StepOverviewConverter x:Key="PickerStepPresentation"/>
  <Style x:Key="PickerIcon" TargetType="Border">
   <Setter Property="Background"><Setter.Value><MultiBinding Converter="{StaticResource PickerStepPresentation}" ConverterParameter="color"><Binding Path="CategoryKey"/><Binding RelativeSource="{RelativeSource Self}"/></MultiBinding></Setter.Value></Setter>
   <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/>
   <Setter Property="CornerRadius" Value="7"/>
  </Style>
  <Style x:Key="PickerRow" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Margin" Value="0,0,0,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" Padding="10,10" CornerRadius="6" BorderThickness="1"
     BorderBrush="{DynamicResource App.Brush.CardBorder}" Background="{DynamicResource App.Brush.SurfaceRaised}">
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </mah:MetroWindow.Resources>
 <Grid Background="{DynamicResource App.Brush.WindowBackground}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="0,0,1,0" Padding="12,18">
    <ListBox ItemsSource="{Binding StepCategories}" SelectedItem="{Binding SelectedStepCategoryFilter, Mode=TwoWay}"
     AutomationProperties.AutomationId="JobStepCategoryList" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Steps.Picker.Categories}"
     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="Category" Padding="10,12" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"><ContentPresenter/></Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Category" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Category" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/><Setter TargetName="Category" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Category" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Border>
   <Grid Grid.Column="1" Margin="16,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
     <TextBox x:Name="StepSearchBox" Text="{Binding StepTypeSearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="34,8,10,8"
      AutomationProperties.AutomationId="JobStepTypeSearch" AutomationProperties.Name="{loc:Translate Key=Ui.Step.Editor.Search}"
      mah:TextBoxHelper.Watermark="{loc:Translate Key=Ui.Step.Editor.Search}"/>
     <icons:PackIconMaterial Kind="Magnify" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource App.Brush.TextSecondary}" IsHitTestVisible="False"/>
    </Grid>
    <ListBox x:Name="StepTypeList" Loaded="StepTypeList_Loaded" SizeChanged="StepTypeList_SizeChanged" SelectionChanged="StepTypeList_SelectionChanged" Grid.Row="1" ItemsSource="{Binding StepTypeItems}" SelectedItem="{Binding SelectedStepTypeItem, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False"
     ItemContainerStyle="{StaticResource PickerRow}" Background="Transparent" BorderThickness="0"
     AutomationProperties.AutomationId="JobStepTypePickerList" AutomationProperties.Name="{loc:Translate Key=Ui.Step.Settings.StepType}"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
     <ListBox.ItemTemplate><DataTemplate><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource PickerIcon}" HorizontalAlignment="Left" VerticalAlignment="Center"><icons:PackIconMaterial Kind="{Binding Icon}" Width="23" Height="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Description}" Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap" FontSize="13" Margin="0,3,0,0"/>
      </StackPanel>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="1" Text="{loc:Translate Key=Ui.Job.Steps.Picker.Empty}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource App.Brush.TextSecondary}" Visibility="{Binding HasMatchingStepTypes, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
   </Grid>
   <Border Grid.Column="2" BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1,0,0,0" Padding="20,24"
    AutomationProperties.AutomationId="JobStepPickerDescriptionPanel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Visibility="{Binding HasMatchingStepTypes, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border Width="46" Height="46" CornerRadius="8" HorizontalAlignment="Left"><Border.Background><MultiBinding Converter="{StaticResource PickerStepPresentation}" ConverterParameter="color"><Binding Path="SelectedStepCategoryKey"/><Binding RelativeSource="{RelativeSource Self}"/></MultiBinding></Border.Background><icons:PackIconMaterial Kind="{Binding SelectedStepIcon}" Foreground="White" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="{Binding SelectedStepDisplayName}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,6"/>
      <TextBlock Text="{Binding SelectedStepCategory}" Foreground="{DynamicResource App.Brush.Accent}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding StepTypeDescription}" Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="22" Margin="0,22,0,0"/>
      <Border Height="1" Background="{DynamicResource App.Brush.CardBorder}" Margin="0,24,0,14"/>
      <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Picker.EditLater}" Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="1" BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="0,1,0,0" Background="{DynamicResource App.Brush.Surface}" Padding="18,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <icons:PackIconMaterial Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource App.Brush.Accent}" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding InsertionDescription}" TextWrapping="Wrap" AutomationProperties.AutomationId="JobStepInsertionDescription"/>
      <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Picker.NoFocus}" FontSize="12" Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="{Binding ConfirmButtonText}" AutomationProperties.AutomationId="ConfirmJobStepTypeButton" IsDefault="True" Command="{Binding ConfirmCommand}" MinWidth="125" Style="{StaticResource DialogPrimaryAction}"/>
     <Button Content="{loc:Translate Key=Ui.Common.Cancel}" AutomationProperties.AutomationId="CancelJobStepTypeButton" IsCancel="True" Click="Cancel_Click" MinWidth="105" Margin="8,0,0,0" Style="{StaticResource DialogSecondaryAction}"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</mah:MetroWindow>
