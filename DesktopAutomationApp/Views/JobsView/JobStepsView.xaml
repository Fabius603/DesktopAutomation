<UserControl xmlns:loc="clr-namespace:DesktopAutomationApp.Localization" x:Class="DesktopAutomationApp.Views.JobStepsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jobs="clr-namespace:TaskAutomation.Jobs;assembly=TaskAutomation"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:DesktopAutomationApp.Converters"
             xmlns:behaviors="clr-namespace:DesktopAutomationApp.Behaviors"
             behaviors:ViewShortcutGuard.IsEnabled="True"
             xmlns:controls="clr-namespace:DesktopAutomationApp.Controls"
             xmlns:generated="clr-namespace:DesktopAutomationApp.Controls.Jobs.Editors.Generated"
             xmlns:input="clr-namespace:DesktopAutomationApp.Input"
             mc:Ignorable="d"
             Style="{StaticResource ContentViewBase}">
    <UserControl.InputBindings>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.Save}" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.NewItem}" Command="{Binding AddStepCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.Back}" Command="{Binding BackCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.Rename}" Command="{Binding RenameCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.OpenFile}" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.Execute}" Command="{Binding StartJobCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.Stop}" Command="{Binding StopJobCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.DebugJob}" Command="{Binding DebugJobCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.DebugStep}" Command="{Binding DebugStepCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.DebugContinue}" Command="{Binding DebugContinueCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.ToggleBreakpoint}" Command="{Binding ToggleBreakpointCommand}" CommandParameter="{Binding SelectedStep}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="StepList.Rail.If" Color="#FFB83C"/>
            <SolidColorBrush x:Key="StepList.Rail.Else" Color="#9B73F7"/>
            <SolidColorBrush x:Key="StepList.Block.Fill" Color="#129F845A"/>
            <SolidColorBrush x:Key="StepList.Block.Border" Color="#887F694A"/>
<conv:JobStepDetailsConverter x:Key="JobStepDetailsConverter"/>
            <conv:StepHasDetailsConverter x:Key="StepHasDetailsConverter"/>
            <conv:StepBlockShapeConverter x:Key="StepBlockShapeConverter"/>
            <conv:StepCanAddBranchesConverter x:Key="StepCanAddBranchesConverter"/>
            <conv:StepDetailsEnabledConverter x:Key="StepDetailsEnabledConverter"/>
            <conv:StepBlockVisualConverter x:Key="StepBlockVisualConverter"/>
            <conv:StepNumberConverter x:Key="StepNumberConverter"/>
            <conv:StepDisplayNameConverter x:Key="StepDisplayNameConverter"/>
            <conv:StepOverviewConverter x:Key="StepOverviewConverter"/>
        <Style x:Key="JobStepBranchButton" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
            <Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
        <DataTemplate x:Key="JobStepBranchActions">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <StackPanel.Visibility><MultiBinding Converter="{StaticResource StepOverviewConverter}" ConverterParameter="branchActionsVisibility"><Binding/></MultiBinding></StackPanel.Visibility>
                <Button Command="{Binding DataContext.AddElseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                        Content="{loc:Translate Key=Ui.Job.Steps.Branch.AddElse}" ToolTip="{loc:Translate Key=Ui.Job.Steps.Branch.ElseHint}"
                        AutomationProperties.AutomationId="AddElseBranchButton" Style="{StaticResource JobStepBranchButton}" FontSize="12" Padding="8,6" Margin="0,0,6,0"/>
                <Button Command="{Binding DataContext.AddElseIfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                        Content="{loc:Translate Key=Ui.Job.Steps.Branch.AddElseIf}" ToolTip="{loc:Translate Key=Ui.Job.Steps.Branch.ElseIfHint}"
                        AutomationProperties.AutomationId="AddElseIfBranchButton" Style="{StaticResource JobStepBranchButton}" FontSize="12" Padding="8,6"/>
            </StackPanel>
        </DataTemplate>
            <Style x:Key="InspectorPageTabItemStyle" TargetType="TabItem">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabHeaderBorder" Background="Transparent" Padding="8,9"
                                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="TabHeaderBorder" Property="BorderBrush" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="InspectorPageTabControlStyle" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource InspectorPageTabItemStyle}"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="Transparent"
                                        BorderBrush="{DynamicResource App.Brush.BorderSubtle}"
                                        BorderThickness="0,0,0,1" CornerRadius="0" Padding="0">
                                    <Grid x:Name="PART_InspectorHeaderTrack" Height="40" ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="PART_InspectorSelectionPill"
                                                Grid.Column="0" HorizontalAlignment="Stretch" CornerRadius="6"
                                                Background="{DynamicResource App.Brush.Accent}" Height="3" VerticalAlignment="Bottom"
                                                BorderBrush="{DynamicResource App.Brush.Accent}"
                                                BorderThickness="0">
                                            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                                        </Border>
                                        <ItemsPresenter Grid.ColumnSpan="3"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource App.Brush.BorderSubtle}"
                                        BorderThickness="0" CornerRadius="0">
                                    <ContentPresenter ContentSource="SelectedContent"
                                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="InspectorGridSplitterStyle" TargetType="GridSplitter">
                <Setter Property="Width" Value="14"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="SizeWE"/>
                <Setter Property="ResizeDirection" Value="Columns"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Border x:Name="ResizeGrip"
                                        Width="4" MinHeight="52"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource App.Brush.BorderSubtle}"
                                        CornerRadius="2"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ResizeGrip" Property="Width" Value="6"/>
                                    <Setter TargetName="ResizeGrip" Property="Background" Value="{DynamicResource App.Brush.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="ResizeGrip" Property="Width" Value="6"/>
                                    <Setter TargetName="ResizeGrip" Property="Background" Value="{DynamicResource App.Brush.FocusBorder}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="StepDetailItemTemplate">
                <Border Padding="4,6" BorderBrush="{DynamicResource App.Brush.CardBorder}"
                        BorderThickness="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.SystemControlErrorTextForeground}"/>
                                    <Setter Property="BorderThickness" Value="2,0,0,1"/>
                                    <Setter Property="Padding" Value="7,6,4,6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Opacity="0.76" TextWrapping="Wrap"
                                   VerticalAlignment="Top" Margin="0,1,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SourceLabel}" Margin="0,2,0,0" FontSize="10"
                                       Foreground="{DynamicResource App.Brush.TextSecondary}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasSourceLabel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
            <HierarchicalDataTemplate x:Key="DebugContextValueTemplate" ItemsSource="{Binding Children}">
                <Border Margin="0,2" Padding="7,5" CornerRadius="4"
                        Background="Transparent" ToolTip="{Binding Description}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Margin="0,0,12,0"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                    <Border Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="9"
                            Padding="7,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConditionState}" Value="Met">
                                        <Setter Property="Background" Value="#1F43A047"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConditionState}" Value="NotMet">
                                        <Setter Property="Background" Value="#20E53935"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConditionState}" Value="NotEvaluated">
                                        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConditionState}" Value="Unavailable">
                                        <Setter Property="Background" Value="#20F9A825"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTrue}" Value="True">
                                        <Setter Property="Background" Value="#1F43A047"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConditionState}" Value="Met">
                                            <Setter Property="Foreground" Value="#43A047"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConditionState}" Value="NotMet">
                                            <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConditionState}" Value="NotEvaluated">
                                            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConditionState}" Value="Unavailable">
                                            <Setter Property="Foreground" Value="#F9A825"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNull}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
                </Border>
            </HierarchicalDataTemplate>
            <Style x:Key="DebugContextTreeItemStyle" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="PropertyExpander"
                                              Grid.Row="0" Grid.Column="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Width="18" Height="24"
                                              Background="Transparent" BorderThickness="0"
                                              FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ArrowBackground" CornerRadius="4"
                                                    Background="Transparent">
                                                <iconPacks:PackIconMaterial x:Name="Arrow"
                                                    Kind="ChevronRight" Width="13" Height="13"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Kind" Value="ChevronDown"/>
                                                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                                    <Setter TargetName="ArrowBackground" Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                                    <Setter TargetName="ArrowBackground" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="PropertyHeader" Grid.Row="0" Grid.Column="1"
                                        Background="Transparent">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ItemsPresenter x:Name="PropertyChildren"
                                                Grid.Row="1" Grid.Column="1"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="PropertyExpander" Property="Visibility" Value="Hidden"/>
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="PropertyChildren" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DebugResultExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ToggleButton Grid.Row="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              HorizontalContentAlignment="Stretch"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"
                                              FocusVisualStyle="{x:Null}">
                                    <ContentPresenter Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      HorizontalAlignment="Stretch"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="ResultContent"
                                                  Grid.Row="1"
                                                  ContentSource="Content"
                                                  HorizontalAlignment="Stretch"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="ResultContent" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StepDetailsExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ToggleButton Grid.Row="0"
                                              MinHeight="32"
                                              Padding="6,4"
                                              HorizontalAlignment="Stretch"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="DetailsContent" Grid.Row="1"
                                                  ContentSource="Content"
                                                  HorizontalAlignment="Stretch"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="DetailsContent" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <HierarchicalDataTemplate x:Key="StepResultPropertyTemplate" ItemsSource="{Binding Children}">
                <Grid Margin="2,3" ToolTip="{Binding Description}" TextElement.FontSize="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Opacity="0.7" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.Brush.Text}"/>
                    <TextBlock Grid.Column="1" Text="{Binding TypeName}" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap"/>
                </Grid>
            </HierarchicalDataTemplate>
            <Style x:Key="StepResultTreeItemStyle" TargetType="TreeViewItem">
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                </Style.Resources>
                <Setter Property="IsExpanded" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="ResultRowToggle"
                                              Grid.Row="0" Grid.ColumnSpan="2"
                                              MinHeight="28"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ResultRowBackground"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <iconPacks:PackIconMaterial x:Name="ResultRowChevron"
                                                                                Kind="ChevronRight"
                                                                                Width="13" Height="13"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center">
                                                        <iconPacks:PackIconMaterial.Style>
                                                            <Style TargetType="iconPacks:PackIconMaterial">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                                                 Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </iconPacks:PackIconMaterial.Style>
                                                    </iconPacks:PackIconMaterial>
                                                    <ContentPresenter Grid.Column="1"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ResultRowBackground" Property="Background"
                                                            Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                                    <Setter TargetName="ResultRowChevron" Property="Foreground"
                                                            Value="{DynamicResource App.Brush.Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ResultRowChevron" Property="Kind" Value="ChevronDown"/>
                                                    <Setter TargetName="ResultRowChevron" Property="Foreground"
                                                            Value="{DynamicResource App.Brush.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ItemsPresenter x:Name="ResultChildren"
                                                Grid.Row="1" Grid.Column="1"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="ResultRowToggle" Property="IsHitTestVisible" Value="False"/>
                                    <Setter TargetName="ResultRowToggle" Property="Cursor" Value="Arrow"/>
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="ResultChildren" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="JobStepSectionExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Padding="10" CornerRadius="7" Background="{DynamicResource App.Brush.Surface}" BorderBrush="{DynamicResource App.Brush.BorderStrong}" BorderThickness="1"><Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ToggleButton x:Name="SectionHeader" Grid.Row="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  HorizontalContentAlignment="Stretch"
                                                  Background="Transparent" BorderThickness="0" Padding="0"
                                                  FocusVisualStyle="{x:Null}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{DynamicResource App.Brush.CardBorder}"
                                                        BorderThickness="0,0,0,1">
                                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <ContentPresenter Content="{TemplateBinding Header}"
                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                          HorizontalAlignment="Stretch"/>
                                    </ToggleButton>
