<UserControl xmlns:loc="clr-namespace:DesktopAutomationApp.Localization" x:Class="DesktopAutomationApp.Views.JobStepsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jobs="clr-namespace:TaskAutomation.Jobs;assembly=TaskAutomation"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:DesktopAutomationApp.Converters"
             xmlns:behaviors="clr-namespace:DesktopAutomationApp.Behaviors"
             behaviors:ViewShortcutGuard.IsEnabled="True"
             xmlns:controls="clr-namespace:DesktopAutomationApp.Controls"
             xmlns:generated="clr-namespace:DesktopAutomationApp.Controls.Jobs.Editors.Generated"
             xmlns:input="clr-namespace:DesktopAutomationApp.Input"
             mc:Ignorable="d"
             Style="{StaticResource ContentViewBase}">
    <UserControl.InputBindings>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.Save}" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.NewItem}" Command="{Binding AddStepCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.Back}" Command="{Binding BackCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.Rename}" Command="{Binding RenameCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.OpenFile}" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.Execute}" Command="{Binding StartJobCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.Stop}" Command="{Binding StopJobCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.DebugJob}" Command="{Binding DebugJobCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.DebugStep}" Command="{Binding DebugStepCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.DebugContinue}" Command="{Binding DebugContinueCommand}"/>
        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.ToggleBreakpoint}" Command="{Binding ToggleBreakpointCommand}" CommandParameter="{Binding SelectedStep}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <conv:JobStepDetailsConverter x:Key="JobStepDetailsConverter"/>
            <conv:StepHasDetailsConverter x:Key="StepHasDetailsConverter"/>
            <conv:StepBlockShapeConverter x:Key="StepBlockShapeConverter"/>
            <conv:StepCanAddBranchesConverter x:Key="StepCanAddBranchesConverter"/>
            <conv:StepDetailsEnabledConverter x:Key="StepDetailsEnabledConverter"/>
            <conv:StepBlockVisualConverter x:Key="StepBlockVisualConverter"/>
            <conv:StepNumberConverter x:Key="StepNumberConverter"/>
            <conv:StepDisplayNameConverter x:Key="StepDisplayNameConverter"/>
            <Style x:Key="InspectorPageTabItemStyle" TargetType="TabItem">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabHeaderBorder" Background="Transparent" Padding="8,9"
                                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="TabHeaderBorder" Property="BorderBrush" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="InspectorPageTabControlStyle" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource InspectorPageTabItemStyle}"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource App.Brush.SurfaceRaised}"
                                        BorderBrush="{DynamicResource App.Brush.BorderSubtle}"
                                        BorderThickness="1" CornerRadius="8" Padding="3">
                                    <Grid x:Name="PART_InspectorHeaderTrack" Height="40" ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="PART_InspectorSelectionPill"
                                                Grid.Column="0" HorizontalAlignment="Stretch" CornerRadius="6"
                                                Background="{DynamicResource App.Brush.AccentSubtle}"
                                                BorderBrush="{DynamicResource App.Brush.Accent}"
                                                BorderThickness="1">
                                            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                                        </Border>
                                        <ItemsPresenter Grid.ColumnSpan="3"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12"
                                        Background="{DynamicResource App.Brush.SurfaceRaised}"
                                        BorderBrush="{DynamicResource App.Brush.BorderSubtle}"
                                        BorderThickness="1" CornerRadius="8">
                                    <ContentPresenter ContentSource="SelectedContent"
                                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="StepDetailItemTemplate">
                <Border Padding="4,6" BorderBrush="{DynamicResource App.Brush.CardBorder}"
                        BorderThickness="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.SystemControlErrorTextForeground}"/>
                                    <Setter Property="BorderThickness" Value="2,0,0,1"/>
                                    <Setter Property="Padding" Value="7,6,4,6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Opacity="0.76" TextWrapping="Wrap"
                                   VerticalAlignment="Top" Margin="0,1,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SourceLabel}" Margin="0,2,0,0" FontSize="10"
                                       Foreground="{DynamicResource App.Brush.TextSecondary}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasSourceLabel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
            <HierarchicalDataTemplate x:Key="DebugContextValueTemplate" ItemsSource="{Binding Children}">
                <Border Margin="0,2" Padding="7,5" CornerRadius="4"
                        Background="Transparent" ToolTip="{Binding Description}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Margin="0,0,12,0"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                    <Border Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="9"
                            Padding="7,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConditionState}" Value="Met">
                                        <Setter Property="Background" Value="#1F43A047"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConditionState}" Value="NotMet">
                                        <Setter Property="Background" Value="#20E53935"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConditionState}" Value="NotEvaluated">
                                        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConditionState}" Value="Unavailable">
                                        <Setter Property="Background" Value="#20F9A825"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTrue}" Value="True">
                                        <Setter Property="Background" Value="#1F43A047"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConditionState}" Value="Met">
                                            <Setter Property="Foreground" Value="#43A047"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConditionState}" Value="NotMet">
                                            <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConditionState}" Value="NotEvaluated">
                                            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConditionState}" Value="Unavailable">
                                            <Setter Property="Foreground" Value="#F9A825"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNull}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
                </Border>
            </HierarchicalDataTemplate>
            <Style x:Key="DebugContextTreeItemStyle" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="PropertyExpander"
                                              Grid.Row="0" Grid.Column="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Width="18" Height="24"
                                              Background="Transparent" BorderThickness="0"
                                              FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ArrowBackground" CornerRadius="4"
                                                    Background="Transparent">
                                                <iconPacks:PackIconMaterial x:Name="Arrow"
                                                    Kind="ChevronRight" Width="13" Height="13"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Kind" Value="ChevronDown"/>
                                                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                                    <Setter TargetName="ArrowBackground" Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                                    <Setter TargetName="ArrowBackground" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="PropertyHeader" Grid.Row="0" Grid.Column="1"
                                        Background="Transparent">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ItemsPresenter x:Name="PropertyChildren"
                                                Grid.Row="1" Grid.Column="1"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="PropertyExpander" Property="Visibility" Value="Hidden"/>
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="PropertyChildren" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DebugResultExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ToggleButton Grid.Row="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              HorizontalContentAlignment="Stretch"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"
                                              FocusVisualStyle="{x:Null}">
                                    <ContentPresenter Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      HorizontalAlignment="Stretch"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="ResultContent"
                                                  Grid.Row="1"
                                                  ContentSource="Content"
                                                  HorizontalAlignment="Stretch"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="ResultContent" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StepDetailsExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ToggleButton Grid.Row="0"
                                              MinHeight="32"
                                              Padding="6,4"
                                              HorizontalAlignment="Stretch"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="DetailsContent" Grid.Row="1"
                                                  ContentSource="Content"
                                                  HorizontalAlignment="Stretch"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="DetailsContent" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <HierarchicalDataTemplate x:Key="StepResultPropertyTemplate" ItemsSource="{Binding Children}">
                <Grid Margin="2,3" ToolTip="{Binding Description}" TextElement.FontSize="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Opacity="0.7" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.Brush.Text}"/>
                    <TextBlock Grid.Column="1" Text="{Binding TypeName}" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap"/>
                </Grid>
            </HierarchicalDataTemplate>
            <Style x:Key="StepResultTreeItemStyle" TargetType="TreeViewItem">
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                </Style.Resources>
                <Setter Property="IsExpanded" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="ResultRowToggle"
                                              Grid.Row="0" Grid.ColumnSpan="2"
                                              MinHeight="28"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ResultRowBackground"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <iconPacks:PackIconMaterial x:Name="ResultRowChevron"
                                                                                Kind="ChevronRight"
                                                                                Width="13" Height="13"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center">
                                                        <iconPacks:PackIconMaterial.Style>
                                                            <Style TargetType="iconPacks:PackIconMaterial">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                                                 Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </iconPacks:PackIconMaterial.Style>
                                                    </iconPacks:PackIconMaterial>
                                                    <ContentPresenter Grid.Column="1"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ResultRowBackground" Property="Background"
                                                            Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                                    <Setter TargetName="ResultRowChevron" Property="Foreground"
                                                            Value="{DynamicResource App.Brush.Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ResultRowChevron" Property="Kind" Value="ChevronDown"/>
                                                    <Setter TargetName="ResultRowChevron" Property="Foreground"
                                                            Value="{DynamicResource App.Brush.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ItemsPresenter x:Name="ResultChildren"
                                                Grid.Row="1" Grid.Column="1"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="ResultRowToggle" Property="IsHitTestVisible" Value="False"/>
                                    <Setter TargetName="ResultRowToggle" Property="Cursor" Value="Arrow"/>
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="ResultChildren" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="JobStepSectionExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,0,18"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ToggleButton x:Name="SectionHeader" Grid.Row="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  HorizontalContentAlignment="Stretch"
                                                  Background="Transparent" BorderThickness="0" Padding="0"
                                                  FocusVisualStyle="{x:Null}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{DynamicResource App.Brush.CardBorder}"
                                                        BorderThickness="0,0,0,1">
                                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <ContentPresenter Content="{TemplateBinding Header}"
                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                          HorizontalAlignment="Stretch"/>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="SectionContent"
                                                      Grid.Row="1"
                                                      ContentSource="Content"
                                                      Visibility="Collapsed"/>
                                </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="SectionHeader" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SectionHeader" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="SectionContent" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="JobStepSectionHeaderStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="4,8"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="False"/>
                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#30FF0000"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="JobStepSectionChevronStyle" TargetType="iconPacks:PackIconMaterial">
                <Setter Property="Kind" Value="ChevronRight"/>
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                        <Setter Property="Kind" Value="ChevronDown"/>
                        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="JobStepSectionCountStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="JobStepDetailsToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ToggleSurface"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <iconPacks:PackIconMaterial x:Name="ToggleIcon"
                                                            Kind="InformationOutline"
                                                            Width="16" Height="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleSurface" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                    <Setter TargetName="ToggleIcon" Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleSurface" Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/>
                                    <Setter TargetName="ToggleIcon" Property="Kind" Value="Information"/>
                                    <Setter TargetName="ToggleIcon" Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="JobStepBreakpointButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource ButtonIcon}">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Visibility" Value="Hidden"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                 Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsBreakpoint}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="JobStepSectionCompactCardTemplate">
                <Border Margin="0,0,0,6" Padding="12,9" CornerRadius="6" BorderThickness="1"
                        ToolTip="{Binding DebugDetails}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource App.Brush.CardBackground}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.CardBorder}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                    <Setter Property="Background" Value="#30FF0000"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource JobStepBreakpointButtonStyle}"
                                Command="{Binding DataContext.ToggleBreakpointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="{loc:Translate Key=Ui.Job.Debug.ToggleBreakpoint}">
                            <iconPacks:PackIconMaterial Width="13" Height="13">
                                <iconPacks:PackIconMaterial.Style><Style TargetType="iconPacks:PackIconMaterial"><Setter Property="Kind" Value="CircleOutline"/><Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/><Style.Triggers><DataTrigger Binding="{Binding IsBreakpoint}" Value="True"><Setter Property="Kind" Value="Circle"/><Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}"/></DataTrigger></Style.Triggers></Style></iconPacks:PackIconMaterial.Style>
                            </iconPacks:PackIconMaterial>
                        </Button>
                        <TextBlock Grid.Column="1" FontWeight="Bold" FontSize="13" Margin="0,0,2,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource StepNumberConverter}">
                                    <Binding/>
                                    <Binding Path="DataContext.AllJobSteps" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding Converter={StaticResource StepDisplayNameConverter}}"
                                   FontWeight="SemiBold" FontSize="14"/>
                        <Button Grid.Column="3" Style="{StaticResource ButtonIcon}" Margin="8,0,2,0"
                                ToolTip="{loc:Translate Key=Ui.Common.Ellipsis}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Click="StepMoreButton_Click">
                            <iconPacks:PackIconMaterial Kind="DotsVertical"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Translate Key=Ui.Common.MoveStepUp}"
                                              Command="{Binding PlacementTarget.Tag.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Translate Key=Ui.Common.MoveStepDown}"
                                              Command="{Binding PlacementTarget.Tag.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Steps.MoveToStart}"
                                              Command="{Binding PlacementTarget.Tag.MoveToStartSectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Steps.MoveToRun}"
                                              Command="{Binding PlacementTarget.Tag.MoveToRunSectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Steps.MoveToEnd}"
                                              Command="{Binding PlacementTarget.Tag.MoveToEndSectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Steps.DeleteStep}"
                                              Command="{Binding PlacementTarget.Tag.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <iconPacks:PackIconMaterial Grid.Column="4" Kind="AlertCircleOutline"
                                                    Width="16" Height="16" Margin="8,0,0,0"
                                                    Foreground="{DynamicResource App.Brush.Danger}"
                                                    ToolTip="{Binding ValidationError}"
                                                    Visibility="{Binding IsValid, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </DataTemplate>
            <Style x:Key="JobStepCompactListItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style x:Key="JobStepCardListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="itemMargin">
                            <Binding/>
                            <Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                            <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                            <Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <!-- Transparent hit surface keeps hover active across the gap to outside actions. -->
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Measured space for hover actions rendered beside the visual element. -->
                                    <ColumnDefinition Width="128"/>
                                </Grid.ColumnDefinitions>

                                <!-- The breakpoint gutter is deliberately outside every card and block frame. -->
                                <Button Grid.Column="0"
                                        Style="{StaticResource JobStepBreakpointButtonStyle}"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.ToggleBreakpointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{loc:Translate Key=Ui.Job.Debug.ToggleBreakpoint}">
                                    <iconPacks:PackIconMaterial Width="13" Height="13">
                                        <iconPacks:PackIconMaterial.Style>
                                            <Style TargetType="iconPacks:PackIconMaterial">
                                                <Setter Property="Kind" Value="CircleOutline"/>
                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBreakpoint}" Value="True">
                                                        <Setter Property="Kind" Value="Circle"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconMaterial.Style>
                                    </iconPacks:PackIconMaterial>
                                </Button>

                            <Border x:Name="Frame" Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    BorderBrush="{DynamicResource App.Brush.Accent}"
                                    ClipToBounds="False"
                                    SnapsToDevicePixels="True">
                                <Border.Margin><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="frameMargin"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.Margin>
                                <Border.Width><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="frameWidth"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.Width>
                                <Border.Background><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="frameBackground"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.Background>
                                <Border.BorderThickness><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="frameBorder"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.BorderThickness>
                                <Border.CornerRadius><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="frameCorner"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.CornerRadius>
                                <Border x:Name="Card" HorizontalAlignment="Left" ClipToBounds="False"
                                        BorderBrush="{DynamicResource App.Brush.CardBorder}" Padding="0">
                                    <Border.Width><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="cardWidth"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.Width>
                                    <Border.Height><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="cardHeight"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.Height>
                                    <Border.Margin><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="cardMargin"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.Margin>
                                    <Border.Background><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="cardBackground"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.Background>
                                    <Border.BorderThickness><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="cardBorder"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.BorderThickness>
                                    <Border.CornerRadius><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="cardCorner"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.CornerRadius>
                                    <Grid>
                                        <Border x:Name="SelectionOverlay"
                                                Background="Transparent"
                                                IsHitTestVisible="False"/>
                                        <ContentPresenter/>
                                    </Grid>
                                </Border>
                            </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource App.Brush.BorderStrong}"/></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource App.Brush.SelectionBorder}"/>
                                    <Setter TargetName="SelectionOverlay" Property="Background" Value="{DynamicResource App.Brush.SelectionBackground}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding DebugState}" Value="{x:Static jobs:JobStepDebugState.Waiting}"><Setter TargetName="Card" Property="BorderBrush" Value="#FFFFC107"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></DataTrigger>
                                <DataTrigger Binding="{Binding DebugState}" Value="{x:Static jobs:JobStepDebugState.Running}"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></DataTrigger>
                                <DataTrigger Binding="{Binding DebugState}" Value="{x:Static jobs:JobStepDebugState.Completed}"><Setter TargetName="Card" Property="BorderBrush" Value="#FF4CAF50"/></DataTrigger>
                                <DataTrigger Binding="{Binding DebugState}" Value="{x:Static jobs:JobStepDebugState.Skipped}"><Setter TargetName="Card" Property="Opacity" Value="0.55"/></DataTrigger>
                                <DataTrigger Binding="{Binding DebugState}" Value="{x:Static jobs:JobStepDebugState.Failed}"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ItemsPanelTemplate x:Key="JobStepItemsPanelTemplate">
                <controls:ControlFlowBlockPanel
                    BlockBackground="{DynamicResource App.Brush.ControlFlowBlock}"
                    BlockBorderBrush="{DynamicResource App.Brush.ControlFlowBlockBorder}"
                    BlockHoverBackground="{DynamicResource App.Brush.ControlFlowBlockHover}"
                    BlockHoverBorderBrush="{DynamicResource App.Brush.BorderStrong}"
                    PlaceholderBorderBrush="{DynamicResource App.Brush.BorderStrong}"
                    PlaceholderForeground="{DynamicResource App.Brush.TextMuted}"/>
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,12">
            <controls:LibraryEditorHeader Title="{Binding Title}"
                                          BackCommand="{Binding BackCommand}"
                                          RenameCommand="{Binding RenameCommand}"
                                          OpenFileCommand="{Binding OpenFileCommand}"
                                          ExecuteCommand="{Binding StartJobCommand}"
                                          StopCommand="{Binding StopJobCommand}"
                                          SaveCommand="{Binding SaveCommand}"
                                          DiscardCommand="{Binding CancelCommand}"
                                          HasExecutionCommands="True"
                                          IsRunning="{Binding IsJobRunning}"
                                          HasUnsavedChanges="{Binding HasUnsavedChanges}"
                                          ExecuteToolTip="{loc:Translate Key=Shortcut.RunJob}"
                                          StopToolTip="{loc:Translate Key=Shortcut.StopJob}"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox HorizontalAlignment="Left" VerticalAlignment="Center"
                              ToolTip="{loc:Translate Key=Ui.Job.Settings.Repeating.Description}"
                              IsChecked="{Binding IsRepeating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsJobRunning, Converter={StaticResource InverseBooleanConverter}}">
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Settings.Repeating}"
                                   Margin="9,0,0,0" FontWeight="SemiBold"/>
                    </CheckBox>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsJobRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding AddStepCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Translate Key=Ui.Common.NewStep}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ButtonSecondary}" Command="{Binding OpenVariablesCommand}"
                                Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CodeBraces" Width="14" Height="14"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Button}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource ToolbarSeparator}"/>
                        <Button Style="{StaticResource ButtonSecondary}" Command="{Binding UndoCommand}"
                                AutomationProperties.AutomationId="UndoJobStepChangeButton"
                                ToolTip="{loc:Translate Key=Ui.Common.Undo}">
                            <iconPacks:PackIconMaterial Kind="Undo" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource ButtonSecondary}" Command="{Binding RedoCommand}" Margin="6,0,0,0"
                                AutomationProperties.AutomationId="RedoJobStepChangeButton"
                                ToolTip="{loc:Translate Key=Ui.Common.Redo}">
                            <iconPacks:PackIconMaterial Kind="Redo" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource ButtonSecondary}" Command="{Binding CopyCommand}" Margin="6,0,0,0"
                                AutomationProperties.AutomationId="CopyJobStepsButton"
                                ToolTip="{loc:Translate Key=Ui.Common.Copy}">
                            <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource ButtonSecondary}" Command="{Binding PasteCommand}" Margin="6,0,0,0"
                                AutomationProperties.AutomationId="PasteJobStepsButton"
                                ToolTip="{loc:Translate Key=Ui.Common.Paste}">
                            <iconPacks:PackIconMaterial Kind="ContentPaste" Width="14" Height="14"/>
                        </Button>
                        <Border Style="{StaticResource ToolbarSeparator}"/>
                        <Button Style="{StaticResource ButtonSecondary}" Command="{Binding DebugJobCommand}"
                                ToolTip="{loc:Translate Key=Ui.Job.Debug.StartTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Bug" Width="14" Height="14"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Start}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Margin="0,12,0,0" Padding="12,9" CornerRadius="7"
                        AutomationProperties.AutomationId="JobStepsStatusBar"
                        Background="{DynamicResource App.Brush.Surface}"
                        BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedStepsSummary}"
                                       Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                            <Border Style="{StaticResource ToolbarSeparator}" Margin="10,0"/>
                            <TextBlock Text="{Binding TotalStepsSummary}"
                                       Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="17" Height="17" Margin="0,0,8,0">
                                <iconPacks:PackIconMaterial.Style>
                                    <Style TargetType="iconPacks:PackIconMaterial">
                                        <Setter Property="Kind" Value="CheckCircle"/>
                                        <Setter Property="Foreground" Value="#2E9B55"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasValidationErrors}" Value="True">
                                                <Setter Property="Kind" Value="AlertCircle"/>
                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconMaterial.Style>
                            </iconPacks:PackIconMaterial>
                            <TextBlock Text="{Binding ValidationSummary}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" CornerRadius="7"
                Background="{DynamicResource App.Brush.AccentSubtle}"
                BorderBrush="{DynamicResource App.Brush.Accent}" BorderThickness="1"
                Visibility="{Binding IsEditContextVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsRunContextVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Style="{StaticResource ButtonDanger}" Command="{Binding StopJobCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Stop" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Translate Key=Ui.Common.Stop}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding HasDebugSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding ToggleDebugPanelCommand}" Margin="0,0,8,0"
                            ToolTip="{loc:Translate Key=Ui.Job.Debug.Panel.Toggle}">
                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding DebugStepCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="SkipNext" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Next}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding DebugContinueCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Play" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Continue}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonDanger}" Command="{Binding CancelDebugCommand}" Margin="0,0,8,0"><TextBlock Text="{loc:Translate Key=Ui.Common.Cancel}"/></Button>
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding CloseDebuggerCommand}"><TextBlock Text="{loc:Translate Key=Ui.Common.Close}"/></Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center"
                            Visibility="{Binding IsRunContextVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.JobRunning}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center"
                            Visibility="{Binding HasDebugSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10"
                                Background="{DynamicResource App.Brush.Accent}"
                                Visibility="{Binding HasDebugIteration, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding DebugIterationText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding DebugStatusText}" Margin="0,2,12,0" Opacity="0.8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Drei Lebenszyklus-Bereiche des Jobs. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="460"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="DebugInspectorColumn" Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Expander Style="{StaticResource JobStepSectionExpanderStyle}" AllowDrop="True"
                          Tag="{Binding StartSteps}"
                          DragEnter="StepSection_DragEnter" DragOver="StepSection_DragOver"
                          DragLeave="StepSection_DragLeave" Drop="StepSection_Drop"
                          IsExpanded="{Binding IsStartSectionExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Border Style="{StaticResource JobStepSectionHeaderStyle}" Tag="{Binding HasStartStepErrors}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Style="{StaticResource JobStepSectionChevronStyle}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Translate Key=Ui.Job.Steps.Section.Start}" FontWeight="SemiBold" FontSize="15"/>
                                <Border Grid.Column="2" Style="{StaticResource JobStepSectionCountStyle}">
                                    <TextBlock Text="{Binding StartSteps.Count}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Expander.Header>
                    <Border Margin="0,8,0,0">
                        <Grid>
                            <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Section.Start.Empty}"
                                       TextWrapping="Wrap" Opacity="0.65" Margin="12,8"
                                       Visibility="{Binding HasStartSteps, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <ListBox x:Name="StartStepsList" ItemsSource="{Binding StartSteps}"
                                     MinHeight="48" Background="Transparent" BorderThickness="0"
                                     ItemsPanel="{StaticResource JobStepItemsPanelTemplate}"
                                     SelectionMode="Extended"
                                     SelectionChanged="StepsList_SelectionChanged"
                                     PreviewMouseRightButtonDown="StepsList_PreviewMouseRightButtonDown"
                                     MouseDoubleClick="StepsList_MouseDoubleClick"
                                     ItemContainerStyle="{StaticResource JobStepCardListBoxItemStyle}"
                                     ItemTemplate="{Binding ItemTemplate, ElementName=StepsList}"
                                     behaviors:StepDragDrop.IsLivePreviewEnabled="True"
                                     behaviors:StepDragDrop.DragIndicesResolver="{Binding DragIndicesResolver}"
                                     behaviors:StepDragDrop.PreviewMoveValidator="{Binding PreviewMoveValidator}"
                                     behaviors:StepDragDrop.MoveCommand="{Binding ReorderStepCommand}"/>
                        </Grid>
                    </Border>
                </Expander>

                <Expander Style="{StaticResource JobStepSectionExpanderStyle}" AllowDrop="True"
                          Tag="{Binding Steps}"
                          DragEnter="StepSection_DragEnter" DragOver="StepSection_DragOver"
                          DragLeave="StepSection_DragLeave" Drop="StepSection_Drop"
                          IsExpanded="{Binding IsRunSectionExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Border Style="{StaticResource JobStepSectionHeaderStyle}" Tag="{Binding HasStepErrors}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Style="{StaticResource JobStepSectionChevronStyle}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Translate Key=Ui.Job.Steps.Section.Run}" FontWeight="SemiBold" FontSize="15"/>
                                <Border Grid.Column="2" Style="{StaticResource JobStepSectionCountStyle}">
                                    <TextBlock Text="{Binding Steps.Count}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Expander.Header>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Section.Run.Empty}"
                                   TextWrapping="Wrap" Opacity="0.65" Margin="12,8"
                                   Visibility="{Binding HasSteps, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                <!-- ListBox mit Hover-/Selected-Rahmen wie im Makro -->
                <ListBox x:Name="StepsList"
                         ItemsSource="{Binding Steps}"
                         SelectionMode="Extended"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="StepsList_SelectionChanged"
                         PreviewMouseRightButtonDown="StepsList_PreviewMouseRightButtonDown"
                         MouseDoubleClick="StepsList_MouseDoubleClick"
                         MinHeight="48" Background="Transparent" BorderThickness="0"
                         ItemsPanel="{StaticResource JobStepItemsPanelTemplate}"
                         ItemContainerStyle="{StaticResource JobStepCardListBoxItemStyle}"
                         behaviors:StepDragDrop.IsLivePreviewEnabled="True"
                         behaviors:StepDragDrop.DragIndicesResolver="{Binding DragIndicesResolver}"
                         behaviors:StepDragDrop.PreviewMoveValidator="{Binding PreviewMoveValidator}"
                         behaviors:StepDragDrop.MoveCommand="{Binding ReorderStepCommand}">

                    <ListBox.InputBindings>
                        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.AddStep}" Command="{Binding AddStepCommand}"/>
                        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.MoveUp}" Command="{Binding MoveStepUpCommand}" CommandParameter="{Binding SelectedStep}"/>
                        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.MoveDown}" Command="{Binding MoveStepDownCommand}" CommandParameter="{Binding SelectedStep}"/>
                        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.ToggleEnabled}" Command="{Binding ToggleStepEnabledCommand}" CommandParameter="{Binding SelectedStep}"/>
                        <KeyBinding Key="Delete"              Command="{Binding DeleteSelectedCommand}"/>
                        <KeyBinding Key="C" Modifiers="Ctrl"  Command="{Binding CopyCommand}"/>
                        <KeyBinding Key="V" Modifiers="Ctrl"  Command="{Binding PasteCommand}"/>
                        <KeyBinding Key="Z" Modifiers="Ctrl"  Command="{Binding UndoCommand}"/>
                        <KeyBinding Key="Y" Modifiers="Ctrl"  Command="{Binding RedoCommand}"/>
                    </ListBox.InputBindings>

                    <!-- Inhalt + Aktionsleiste rechts (Edit/Hoch/Runter/Delete exakt wie Makro) -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Outer grid: coloured left bar | content -->
                            <Grid>
                                <Grid.ToolTip>
                                    <ToolTip Content="{Binding ValidationError}"/>
                                </Grid.ToolTip>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                <Setter Property="Background" Value="#30FF0000"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <!-- Compact card: overview first, full template only on demand. -->
                                <Grid x:Name="StepCardLayout" Margin="10,3,6,3">
                                    <Grid.Visibility>
                                        <MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="contentVisibility">
                                            <Binding/>
                                            <Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                            <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                            <Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Grid.Visibility>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="0"/>
                                    </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                            <ColumnDefinition Width="0"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MahApps.Brushes.Accent}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource StepNumberConverter}">
                                                    <Binding/>
                                                    <Binding Path="DataContext.AllJobSteps" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                    <Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Converter={StaticResource StepDisplayNameConverter}}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <iconPacks:PackIconMaterial Grid.Column="3" Kind="AlertCircleOutline"
                                                                    Width="16" Height="16" Margin="8,0,0,0"
                                                                    Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                                                    ToolTip="{Binding ValidationError}"
                                                                    Visibility="{Binding IsValid, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="0"
                                            Panel.ZIndex="10"
                                            Width="112"
                                            Background="Transparent"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0">
                                    <StackPanel.RenderTransform>
                                        <!-- The card remains fixed while its actions occupy the reserved outside column. -->
                                        <TranslateTransform X="126"/>
                                    </StackPanel.RenderTransform>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,2,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                            <Condition Binding="{Binding DataContext.IsDebugPanelVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                            <Condition Binding="{Binding DataContext.IsDebugPanelVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <CheckBox
                                            IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                            Command="{Binding DataContext.ToggleStepEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanBeDisabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="{loc:Translate Key=Ui.Job.Steps.EnableDisableStep}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource ButtonIcon}"
                                                Margin="0,0,6,0"
                                                ToolTip="{loc:Translate Key=Ui.Common.EditStep}"
                                                Command="{Binding DataContext.EditStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <iconPacks:PackIconMaterial Kind="Pencil"/>
                                        </Button>
                                        <Button Style="{StaticResource ButtonIcon}"
                                                ToolTip="{loc:Translate Key=Ui.Common.Ellipsis}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Click="StepMoreButton_Click">
                                            <iconPacks:PackIconMaterial Kind="DotsVertical"/>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Translate Key=Ui.Common.MoveStepUp}"
                                                              Command="{Binding PlacementTarget.Tag.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="{loc:Translate Key=Ui.Common.MoveStepDown}"
                                                              Command="{Binding PlacementTarget.Tag.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Steps.MoveToStart}"
                                                              Command="{Binding PlacementTarget.Tag.MoveToStartSectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Steps.MoveToRun}"
                                                              Command="{Binding PlacementTarget.Tag.MoveToRunSectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Steps.MoveToEnd}"
                                                              Command="{Binding PlacementTarget.Tag.MoveToEndSectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator Visibility="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StepCanAddBranchesConverter}}"/>
                                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Steps.AddElseIf}"
                                                              Command="{Binding PlacementTarget.Tag.AddElseIfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StepCanAddBranchesConverter}}"/>
                                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Steps.AddElse}"
                                                              Command="{Binding PlacementTarget.Tag.AddElseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StepCanAddBranchesConverter}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Steps.DeleteStep}"
                                                              Command="{Binding PlacementTarget.Tag.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <Popup x:Name="StepDetailsPopup"
                                       IsOpen="False"
                                       PlacementTarget="{Binding ElementName=StepCardLayout}"
                                       Placement="Right" HorizontalOffset="8"
                                       AllowsTransparency="True" StaysOpen="True">
                                <Border Width="420" MaxHeight="620" Padding="14" CornerRadius="8"
                                        Background="{DynamicResource App.Brush.SurfaceRaised}"
                                        Opacity="1"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource App.Brush.CardBorder}"
                                        Visibility="{Binding Converter={StaticResource StepHasDetailsConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                    <ContentControl>
                                        <ContentControl.Content>
                                            <MultiBinding Converter="{StaticResource JobStepDetailsConverter}">
                                                <Binding/>
                                                <Binding Path="DataContext.AllJobSteps" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                <Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                <Binding Path="DataContext.Variables" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                <Binding Path="DataContext.ProviderSources" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                                <Binding Path="DataContext.LocalValues" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay"/>
                                            </MultiBinding>
                                        </ContentControl.Content>
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Groups}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,10">
                                                                    <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4"
                                                                                   Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                                                                        <ItemsControl ItemsSource="{Binding Items}"
                                                                                      ItemTemplate="{StaticResource StepDetailItemTemplate}"/>
                                                                    </StackPanel>
                                                                    <Expander Style="{StaticResource StepDetailsExpanderStyle}" IsExpanded="False"
                                                                              Visibility="{Binding IsAdvanced, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <Expander.Header>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                                                <iconPacks:PackIconMaterial Width="14" Height="14" Margin="0,1,5,0">
                                                                                    <iconPacks:PackIconMaterial.Style>
                                                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                                                            <Setter Property="Kind" Value="ChevronRight"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                                                    <Setter Property="Kind" Value="ChevronDown"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </iconPacks:PackIconMaterial.Style>
                                                                                </iconPacks:PackIconMaterial>
                                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                                                            </StackPanel>
                                                                        </Expander.Header>
                                                                        <ItemsControl ItemsSource="{Binding Items}"
                                                                                      ItemTemplate="{StaticResource StepDetailItemTemplate}"/>
                                                                    </Expander>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource App.Brush.CardBorder}"
                                                            Padding="0,10,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Result}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.DetailsReturnValue}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                                                            <TreeView ItemsSource="{Binding Result.Properties}" Margin="0,4,0,0"
                                                                      Background="Transparent" BorderThickness="0"
                                                                      ItemTemplate="{StaticResource StepResultPropertyTemplate}"
                                                                      ItemContainerStyle="{StaticResource StepResultTreeItemStyle}"
                                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                                <TreeView.Resources>
                                                                    <Style TargetType="TreeViewItem"
                                                                           BasedOn="{StaticResource StepResultTreeItemStyle}"/>
                                                                </TreeView.Resources>
                                                            </TreeView>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Border>
                                </Popup>
                                </Grid><!-- /inner Grid (content | buttons) -->
                            </Grid><!-- /outer Grid (bar | content) -->
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                    </Grid>
                </Expander>

                <Expander Style="{StaticResource JobStepSectionExpanderStyle}" AllowDrop="True"
                          Tag="{Binding EndSteps}"
                          DragEnter="StepSection_DragEnter" DragOver="StepSection_DragOver"
                          DragLeave="StepSection_DragLeave" Drop="StepSection_Drop"
                          IsExpanded="{Binding IsEndSectionExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Border Style="{StaticResource JobStepSectionHeaderStyle}" Tag="{Binding HasEndStepErrors}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Style="{StaticResource JobStepSectionChevronStyle}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Translate Key=Ui.Job.Steps.Section.End}" FontWeight="SemiBold" FontSize="15"/>
                                <Button x:Name="EndSettingsButton" Grid.Column="2"
                                        Style="{StaticResource ButtonIcon}" Width="28" Height="28" Margin="8,-6,8,-6"
                                        IsEnabled="{Binding IsDebugActive, Converter={StaticResource InverseBooleanConverter}}"
                                        ToolTip="{loc:Translate Key=Ui.Job.EndSettings.Tooltip}"
                                        Click="EndSettingsButton_Click">
                                    <iconPacks:PackIconMaterial Kind="CogOutline" Width="17" Height="17"/>
                                </Button>
                                <Border Grid.Column="3" Style="{StaticResource JobStepSectionCountStyle}">
                                    <TextBlock Text="{Binding EndSteps.Count}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                </Border>
                                <Popup x:Name="EndSettingsPopup" Grid.Column="2"
                                       PlacementTarget="{Binding ElementName=EndSettingsButton}"
                                       Placement="Bottom" HorizontalOffset="-270" VerticalOffset="8"
                                       StaysOpen="False" AllowsTransparency="True">
                                    <Border Width="330" Padding="16" CornerRadius="8"
                                            Background="{DynamicResource App.Brush.Surface}"
                                            BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1"
                                            DataContext="{Binding DataContext, Source={x:Reference EndSettingsButton}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.28"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Key=Ui.Job.EndSettings.Title}"
                                                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                            <TextBlock Text="{loc:Translate Key=Ui.Job.EndSettings.Timeout}"
                                                       FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <DockPanel LastChildFill="False">
                                                <mah:NumericUpDown Width="90"
                                                                   Style="{StaticResource AppNumericUpDownStyle}"
                                                                   HorizontalContentAlignment="Right"
                                                                   Minimum="1"
                                                                   Maximum="3600"
                                                                   Interval="1"
                                                                   NumericInputMode="Numbers"
                                                                   SnapToMultipleOfInterval="True"
                                                                   Value="{Binding EndPhaseTimeoutSeconds,
                                                                                   Mode=TwoWay,
                                                                                   UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="{loc:Translate Key=Ui.Job.EndSettings.Timeout.Unit}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </DockPanel>
                                            <TextBlock Text="{loc:Translate Key=Ui.Job.EndSettings.Timeout.Description}"
                                                       Foreground="{DynamicResource App.Brush.TextSecondary}"
                                                       TextWrapping="Wrap" Margin="0,9,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </Expander.Header>
                    <Border Margin="0,8,0,0">
                        <Grid>
                            <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Section.End.Empty}"
                                       TextWrapping="Wrap" Opacity="0.65" Margin="12,8"
                                       Visibility="{Binding HasEndSteps, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <ListBox x:Name="EndStepsList" ItemsSource="{Binding EndSteps}"
                                     MinHeight="48" Background="Transparent" BorderThickness="0"
                                     ItemsPanel="{StaticResource JobStepItemsPanelTemplate}"
                                     SelectionMode="Extended"
                                     SelectionChanged="StepsList_SelectionChanged"
                                     PreviewMouseRightButtonDown="StepsList_PreviewMouseRightButtonDown"
                                     MouseDoubleClick="StepsList_MouseDoubleClick"
                                     ItemContainerStyle="{StaticResource JobStepCardListBoxItemStyle}"
                                     ItemTemplate="{Binding ItemTemplate, ElementName=StepsList}"
                                     behaviors:StepDragDrop.IsLivePreviewEnabled="True"
                                     behaviors:StepDragDrop.DragIndicesResolver="{Binding DragIndicesResolver}"
                                     behaviors:StepDragDrop.PreviewMoveValidator="{Binding PreviewMoveValidator}"
                                     behaviors:StepDragDrop.MoveCommand="{Binding ReorderStepCommand}"/>
                        </Grid>
                    </Border>
                </Expander>
            </StackPanel>
            </ScrollViewer>
        </Border>
            <GridSplitter Grid.Column="1" Width="6" Margin="6,0"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeDirection="Columns"/>

            <Border Grid.Column="2" MinWidth="360"
                    Margin="0" Padding="16" CornerRadius="8"
                    AutomationProperties.AutomationId="SelectedJobStepInspector"
                    Background="{DynamicResource App.Brush.CardBackground}"
                    BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1">
                <Grid>
                    <Grid Visibility="{Binding HasSingleSelectedStep, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                            <iconPacks:PackIconMaterial Kind="CursorDefaultClickOutline" Width="28" Height="28"
                                                        HorizontalAlignment="Center" Margin="0,0,0,12"
                                                        Foreground="{DynamicResource App.Brush.TextMuted}"/>
                            <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.NoSelection}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource App.Brush.TextMuted}"/>
                            <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.MultipleSelection}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource App.Brush.TextMuted}"
                                       Visibility="{Binding HasMultipleSelectedSteps, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding HasSingleSelectedStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ButtonIcon}"
                                    Command="{Binding EditStepCommand}" CommandParameter="{Binding SelectedStep}"
                                    ToolTip="{loc:Translate Key=Ui.Common.Edit}">
                                <iconPacks:PackIconMaterial Kind="DotsVertical" Width="16" Height="16"/>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedStepDisplayName}" FontSize="18" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SelectedStepNumber}" Margin="0,0,8,0"
                                               Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedStepDescription}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox Content="{loc:Translate Key=Ui.Job.Steps.Editor.Active}"
                                      AutomationProperties.AutomationId="SelectedJobStepEnabledToggle"
                                      IsChecked="{Binding SelectedStep.IsEnabled, Mode=OneWay}"
                                      Command="{Binding ToggleStepEnabledCommand}" CommandParameter="{Binding SelectedStep}"
                                      Margin="0,0,20,0"/>
                            <CheckBox Content="{loc:Translate Key=Ui.Job.Debug.ToggleBreakpoint}"
                                      AutomationProperties.AutomationId="SelectedJobStepBreakpointToggle"
                                      IsChecked="{Binding SelectedStep.IsBreakpoint, Mode=OneWay}"
                                      Command="{Binding ToggleBreakpointCommand}" CommandParameter="{Binding SelectedStep}"/>
                        </StackPanel>
                        <TabControl x:Name="SelectedJobStepTabs" Grid.Row="2"
                                    AutomationProperties.AutomationId="SelectedJobStepTabs"
                                    Style="{StaticResource InspectorPageTabControlStyle}"
                                    Loaded="SelectedJobStepTabs_Loaded"
                                    SizeChanged="SelectedJobStepTabs_SizeChanged"
                                    SelectionChanged="SelectedJobStepTabs_SelectionChanged">
                            <TabItem Header="{loc:Translate Key=Ui.Job.Steps.Editor.Details}">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.DetailsTitle}"
                                                       FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.DetailsDescription}"
                                                       Margin="0,2,0,14" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                            <TextBlock Text="{Binding InlineEditorValidationError}" TextWrapping="Wrap"
                                                       Margin="0,0,0,10" Foreground="{DynamicResource App.Brush.Danger}"
                                                       Visibility="{Binding HasInlineEditorError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ContentControl Content="{Binding SelectedStepEditor}"
                                                            IsEnabled="{Binding IsDebugActive, Converter={StaticResource InverseBooleanConverter}}"
                                                            HorizontalContentAlignment="Stretch">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate><generated:GeneratedStepEditor/></DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{loc:Translate Key=Ui.Job.Steps.Editor.ReturnValue}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.ReturnValueTitle}"
                                                   FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.ReturnValueDescription}"
                                                   Margin="0,2,0,14" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                        <ContentControl>
                                            <ContentControl.Content>
                                                <MultiBinding Converter="{StaticResource JobStepDetailsConverter}">
                                                    <Binding Path="SelectedStep"/>
                                                    <Binding Path="AllJobSteps"/>
                                                    <Binding Path="StepsVersion"/>
                                                    <Binding Path="Variables"/>
                                                    <Binding Path="ProviderSources"/>
                                                    <Binding Path="LocalValues"/>
                                                </MultiBinding>
                                            </ContentControl.Content>
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.NoReturnValue}"
                                                                   TextWrapping="Wrap" Foreground="{DynamicResource App.Brush.TextMuted}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding Result}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TreeView ItemsSource="{Binding Result.Properties}" Background="Transparent" BorderThickness="0"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ItemTemplate="{StaticResource StepResultPropertyTemplate}"
                                                                  ItemContainerStyle="{StaticResource StepResultTreeItemStyle}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="{loc:Translate Key=Ui.Job.Steps.Editor.Debug}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.DebugTitle}"
                                                   FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.DebugDescription}"
                                                   Margin="0,2,0,14" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{loc:Translate Key=Ui.Job.Steps.Editor.NoDebugData}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.Brush.TextMuted}"
                                               Visibility="{Binding HasSelectedDebugContext, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding HasSelectedDebugContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding SelectedDebugContextGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Status}" Margin="0,2,0,6" Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                                        <TreeView ItemsSource="{Binding Values}" Background="Transparent" BorderThickness="0"
                                                                  ItemTemplate="{StaticResource DebugContextValueTemplate}"
                                                                  ItemContainerStyle="{StaticResource DebugContextTreeItemStyle}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                <Grid Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,3">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonIcon}"
                                Command="{Binding ToggleDebugPanelCommand}"
                                ToolTip="{loc:Translate Key=Ui.Common.Close}">
                            <iconPacks:PackIconMaterial Kind="Close" Width="15" Height="15"/>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Panel.Title}"
                                       FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DebugContextResultCountText}" Margin="0,2,0,0"
                                       FontSize="11" Foreground="{DynamicResource App.Brush.TextMuted}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,8,0,10">
                        <!--<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ButtonIcon}" Command="{Binding ExpandDebugContextCommand}"
                                    ToolTip="{loc:Translate Key=Ui.Job.Debug.Panel.ExpandAll}" Margin="0,0,4,0">
                                <iconPacks:PackIconMaterial Kind="UnfoldMoreHorizontal" Width="15" Height="15"/>
                            </Button>
                            <Button Style="{StaticResource ButtonIcon}" Command="{Binding CollapseDebugContextCommand}"
                                    ToolTip="{loc:Translate Key=Ui.Job.Debug.Panel.CollapseAll}">
                                <iconPacks:PackIconMaterial Kind="UnfoldLessHorizontal" Width="15" Height="15"/>
                            </Button>
                        </StackPanel>-->
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Panel.CurrentContext}"
                                   FontSize="11" Foreground="{DynamicResource App.Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Grid.Row="2">
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Panel.EmptyContext}"
                                   TextWrapping="Wrap" Margin="4" Opacity="0.65"
                                   Visibility="{Binding HasDebugContext, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <ScrollViewer x:Name="DebugContextScrollViewer"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      Visibility="{Binding HasDebugContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding DebugContextGroups}"
                                          HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  Style="{StaticResource DebugResultExpanderStyle}">
                                            <Expander.Header>
                                                <Border Padding="10,9" CornerRadius="6"
                                                        Background="{DynamicResource App.Brush.SurfaceHover}"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.CardBorder}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static jobs:JobStepDebugState.Failed}">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="20" Height="20" CornerRadius="4"
                                                                VerticalAlignment="Top"
                                                                Background="{DynamicResource App.Brush.Surface}">
                                                            <iconPacks:PackIconMaterial Width="14" Height="14"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource App.Brush.TextSecondary}">
                                                                <iconPacks:PackIconMaterial.Style>
                                                                    <Style TargetType="iconPacks:PackIconMaterial">
                                                                        <Setter Property="Kind" Value="ChevronRight"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="True">
                                                                                <Setter Property="Kind" Value="ChevronDown"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </iconPacks:PackIconMaterial.Style>
                                                            </iconPacks:PackIconMaterial>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                        <Border Grid.Column="2" Padding="7,2" CornerRadius="9"
                                                                VerticalAlignment="Top">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1F43A047"/>
                                                                    <Setter Property="TextElement.Foreground" Value="#43A047"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static jobs:JobStepDebugState.Skipped}">
                                                                            <Setter Property="Background" Value="{DynamicResource App.Brush.Surface}"/>
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static jobs:JobStepDebugState.Failed}">
                                                                            <Setter Property="Background" Value="#20E53935"/>
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Danger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <iconPacks:PackIconMaterial Width="11" Height="11"
                                                                    VerticalAlignment="Center" Margin="0,0,4,0">
                                                                    <iconPacks:PackIconMaterial.Style>
                                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                                            <Setter Property="Kind" Value="CheckCircle"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static jobs:JobStepDebugState.Skipped}">
                                                                                    <Setter Property="Kind" Value="MinusCircle"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static jobs:JobStepDebugState.Failed}">
                                                                                    <Setter Property="Kind" Value="AlertCircle"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </iconPacks:PackIconMaterial.Style>
                                                                </iconPacks:PackIconMaterial>
                                                                <TextBlock Text="{Binding Status}" FontSize="9"
                                                                           FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                                   Text="{Binding Summary}" Margin="0,5,0,0"
                                                                   FontSize="10" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource App.Brush.TextSecondary}"
                                                                   MaxHeight="30"/>
                                                    </Grid>
                                                </Border>
                                            </Expander.Header>
                                            <Grid Margin="10,7,2,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Subtitle}" Margin="1,0,0,5" FontSize="10"
                                                           Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                                <TreeView Grid.Row="1" ItemsSource="{Binding Values}"
                                                          Background="Transparent" BorderThickness="0"
                                                          ItemTemplate="{StaticResource DebugContextValueTemplate}"
                                                          ItemContainerStyle="{StaticResource DebugContextTreeItemStyle}"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                            </Grid>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
