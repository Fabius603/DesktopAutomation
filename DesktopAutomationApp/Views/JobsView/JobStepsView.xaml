                                AutomationProperties.AutomationId="PasteJobStepsButton"
                                ToolTip="{loc:Translate Key=Ui.Common.Paste}">
                            <iconPacks:PackIconMaterial Kind="ContentPaste" Width="14" Height="14"/>
                        </Button>
                        <Border Style="{StaticResource ToolbarSeparator}"/>
                        <Button MinHeight="42" Style="{StaticResource ButtonSecondary}" Command="{Binding DebugJobCommand}"
                                ToolTip="{loc:Translate Key=Ui.Job.Debug.StartTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Bug" Width="14" Height="14"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Start}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Margin="0,12,0,0" Padding="12,9" CornerRadius="7"
                        AutomationProperties.AutomationId="JobStepsStatusBar" Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{DynamicResource App.Brush.Surface}"
                        BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedStepsSummary}"
                                       Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                            <Border Style="{StaticResource ToolbarSeparator}" Margin="10,0" Height="16"/>
                            <TextBlock Text="{Binding TotalStepsSummary}"
                                       Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Width="17" Height="17" Margin="0,0,8,0">
                                <iconPacks:PackIconMaterial.Style>
                                    <Style TargetType="iconPacks:PackIconMaterial">
                                        <Setter Property="Kind" Value="CheckCircle"/>
                                        <Setter Property="Foreground" Value="#2E9B55"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasValidationErrors}" Value="True">
                                                <Setter Property="Kind" Value="AlertCircle"/>
                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconMaterial.Style>
                            </iconPacks:PackIconMaterial>
                            <TextBlock Text="{Binding ValidationSummary}" FontWeight="SemiBold"/>
                        </StackPanel>
                            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,5,0,0">
                            <ItemsControl ItemsSource="{Binding ValidationIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ShowValidationIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Step}" HorizontalContentAlignment="Stretch" Padding="10,8" Margin="0,3"
                                                FontWeight="Normal" FontSize="13" Foreground="{DynamicResource App.Brush.TextPrimary}"
                                                AutomationProperties.AutomationId="JobStepValidationIssue"
                                                ToolTip="{loc:Translate Key=Ui.Job.Steps.ShowProblem}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="IssueSurface" Background="{DynamicResource App.Brush.SurfaceRaised}" CornerRadius="5"
                                                            BorderBrush="{DynamicResource App.Brush.Danger}" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IssueSurface" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/></Trigger>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="IssueSurface" Property="BorderThickness" Value="2,1,1,1"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{DynamicResource App.Brush.Danger}" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Text><MultiBinding Converter="{StaticResource StepNumberConverter}" ConverterParameter="position"><Binding Path="Step"/><Binding Path="DataContext.AllJobSteps" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text>
                                                </TextBlock>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource App.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,8,0"/>
                                                </StackPanel>
                                                <iconPacks:PackIconMaterial Grid.Column="2" Kind="ChevronRight" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                    </Grid>
                </Border>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" CornerRadius="7"
                Background="{DynamicResource App.Brush.AccentSubtle}"
                BorderBrush="{DynamicResource App.Brush.Accent}" BorderThickness="1"
                Visibility="{Binding IsEditContextVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsRunContextVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Style="{StaticResource ButtonDanger}" Command="{Binding StopJobCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Stop" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Translate Key=Ui.Common.Stop}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding HasDebugSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding ToggleDebugPanelCommand}" Margin="0,0,8,0"
                            ToolTip="{loc:Translate Key=Ui.Job.Debug.Panel.Toggle}">
                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding DebugStepCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="SkipNext" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Next}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding DebugContinueCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Play" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Continue}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonDanger}" Command="{Binding CancelDebugCommand}" Margin="0,0,8,0"><TextBlock Text="{loc:Translate Key=Ui.Common.Cancel}"/></Button>
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding CloseDebuggerCommand}"><TextBlock Text="{loc:Translate Key=Ui.Common.Close}"/></Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center"
                            Visibility="{Binding IsRunContextVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.JobRunning}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center"
                            Visibility="{Binding HasDebugSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10"
                                Background="{DynamicResource App.Brush.Accent}"
                                Visibility="{Binding HasDebugIteration, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding DebugIterationText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding DebugStatusText}" Margin="0,2,12,0" Opacity="0.8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Drei Lebenszyklus-Bereiche des Jobs. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="460"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="DebugInspectorColumn" Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Expander Style="{StaticResource JobStepSectionExpanderStyle}" AllowDrop="True"
                          Tag="{Binding StartSteps}"
                          DragEnter="StepSection_DragEnter" DragOver="StepSection_DragOver"
                          DragLeave="StepSection_DragLeave" Drop="StepSection_Drop"
                          IsExpanded="{Binding IsStartSectionExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Border Style="{StaticResource JobStepSectionHeaderStyle}" Tag="{Binding HasStartStepErrors}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Style="{StaticResource JobStepSectionChevronStyle}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Translate Key=Ui.Job.Steps.Section.Start}" FontWeight="SemiBold" FontSize="18"/>
                                <Border Grid.Column="2" Style="{StaticResource JobStepSectionCountStyle}">
                                    <TextBlock Text="{Binding StartStepCount}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Expander.Header>
                    <Border Margin="0,0,0,0">
                        <Grid>
                            <ListBox x:Name="StartStepsList" ItemsSource="{Binding StartSteps}"
                                     MinHeight="48" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     ItemsPanel="{StaticResource JobStepItemsPanelTemplate}"
                                     SelectionMode="Extended"
                                     SelectionChanged="StepsList_SelectionChanged"
                                     PreviewMouseRightButtonDown="StepsList_PreviewMouseRightButtonDown"
                                     MouseDoubleClick="StepsList_MouseDoubleClick"
                                     ItemContainerStyle="{StaticResource JobStepCardListBoxItemStyle}"
                                     ItemTemplate="{Binding ItemTemplate, ElementName=StepsList}"
                                     behaviors:StepDragDrop.IsLivePreviewEnabled="False"
                                     behaviors:StepDragDrop.IsGhostPreviewEnabled="True"
                                     behaviors:StepDragDrop.RequireDragHandle="True"
                                     behaviors:StepDragDrop.PlacementResolver="{Binding DropPlacementResolver}"
                                     behaviors:StepDragDrop.HoverExpandCommand="{Binding ExpandDropBlockCommand}"
                                     behaviors:StepDragDrop.DragIndicesResolver="{Binding DragIndicesResolver}"
                                     behaviors:StepDragDrop.PreviewMoveValidator="{Binding PreviewMoveValidator}"
                                     behaviors:StepDragDrop.MoveCommand="{Binding ReorderStepCommand}"/>
                        </Grid>
                    </Border>
                </Expander>

                <Expander Style="{StaticResource JobStepSectionExpanderStyle}" AllowDrop="True"
                          Tag="{Binding Steps}"
                          DragEnter="StepSection_DragEnter" DragOver="StepSection_DragOver"
                          DragLeave="StepSection_DragLeave" Drop="StepSection_Drop"
                          IsExpanded="{Binding IsRunSectionExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Border Style="{StaticResource JobStepSectionHeaderStyle}" Tag="{Binding HasStepErrors}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Style="{StaticResource JobStepSectionChevronStyle}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Translate Key=Ui.Job.Steps.Section.Run}" FontWeight="SemiBold" FontSize="18"/>
                                <Border Grid.Column="2" Style="{StaticResource JobStepSectionCountStyle}">
                                    <TextBlock Text="{Binding RunStepCount}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Expander.Header>
                    <Grid Margin="0,8,0,0">

                <!-- ListBox mit Hover-/Selected-Rahmen wie im Makro -->
                <ListBox x:Name="StepsList"
                         ItemsSource="{Binding Steps}"
                         SelectionMode="Extended"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="StepsList_SelectionChanged"
                         PreviewMouseRightButtonDown="StepsList_PreviewMouseRightButtonDown"
                         MouseDoubleClick="StepsList_MouseDoubleClick"
                         MinHeight="48" Background="Transparent" BorderThickness="0"
                         ItemsPanel="{StaticResource JobStepItemsPanelTemplate}"
                         ItemContainerStyle="{StaticResource JobStepCardListBoxItemStyle}"
                         behaviors:StepDragDrop.IsLivePreviewEnabled="False"
                                     behaviors:StepDragDrop.IsGhostPreviewEnabled="True"
                                     behaviors:StepDragDrop.RequireDragHandle="True"
                                     behaviors:StepDragDrop.PlacementResolver="{Binding DropPlacementResolver}"
                                     behaviors:StepDragDrop.HoverExpandCommand="{Binding ExpandDropBlockCommand}"
                         behaviors:StepDragDrop.DragIndicesResolver="{Binding DragIndicesResolver}"
                         behaviors:StepDragDrop.PreviewMoveValidator="{Binding PreviewMoveValidator}"
                         behaviors:StepDragDrop.MoveCommand="{Binding ReorderStepCommand}">

                    <ListBox.InputBindings>
                        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.AddStep}" Command="{Binding AddStepCommand}"/>
                        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.MoveUp}" Command="{Binding MoveStepUpCommand}" CommandParameter="{Binding SelectedStep}"/>
                        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.MoveDown}" Command="{Binding MoveStepDownCommand}" CommandParameter="{Binding SelectedStep}"/>
                        <KeyBinding Gesture="{x:Static input:AppShortcutGestures.ToggleEnabled}" Command="{Binding ToggleStepEnabledCommand}" CommandParameter="{Binding SelectedStep}"/>
                        <KeyBinding Key="Delete"              Command="{Binding DeleteSelectedCommand}"/>
                        <KeyBinding Key="C" Modifiers="Ctrl"  Command="{Binding CopyCommand}"/>
                        <KeyBinding Key="V" Modifiers="Ctrl"  Command="{Binding PasteCommand}"/>
                        <KeyBinding Key="Z" Modifiers="Ctrl"  Command="{Binding UndoCommand}"/>
                        <KeyBinding Key="Y" Modifiers="Ctrl"  Command="{Binding RedoCommand}"/>
                    </ListBox.InputBindings>

                    <!-- Inhalt + Aktionsleiste rechts (Edit/Hoch/Runter/Delete exakt wie Makro) -->
                    <ListBox.ItemTemplate><DataTemplate>
                            <Grid Height="52" VerticalAlignment="Top" ToolTip="{Binding ValidationError}">
                                <Grid.Margin><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="headerMargin"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="DataContext.CollapsedBlockIds" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Grid.Margin>
                                <Grid.Visibility><MultiBinding Converter="{StaticResource StepBlockVisualConverter}" ConverterParameter="contentVisibility"><Binding/><Binding Path="(behaviors:StepDragDrop.PreviewItems)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="DataContext.CollapsedBlockIds" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Grid.Visibility>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left" BorderBrush="#50FFFFFF" BorderThickness="1" Cursor="Hand" behaviors:StepDragDrop.IsDragHandle="True" AutomationProperties.AutomationId="JobStepDragHandle" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Steps.Drag.Handle}" ToolTip="{loc:Translate Key=Ui.Job.Steps.Drag.Handle}">
                                    <Border.Background><MultiBinding Converter="{StaticResource StepOverviewConverter}" ConverterParameter="color"><Binding/><Binding RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.Background>
                                    <iconPacks:PackIconMaterial Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"><iconPacks:PackIconMaterial.Kind><MultiBinding Converter="{StaticResource StepOverviewConverter}" ConverterParameter="icon"><Binding/></MultiBinding></iconPacks:PackIconMaterial.Kind></iconPacks:PackIconMaterial>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,4,0">
                                    <TextBlock Text="{Binding Converter={StaticResource StepDisplayNameConverter}}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="13" Foreground="{DynamicResource App.Brush.TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"><TextBlock.Text><MultiBinding Converter="{StaticResource StepOverviewConverter}"><Binding/><Binding Path="DataContext.AllJobSteps" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="DataContext.StepsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="DataContext.Variables" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="DataContext.LocalValues" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="DataContext.CollapsedBlockIds" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.ValidationIssues" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock>
                                </StackPanel>
                                <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource JobStepBranchActions}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                    </Grid>
                </Expander>

                <Expander Style="{StaticResource JobStepSectionExpanderStyle}" AllowDrop="True"
                          Tag="{Binding EndSteps}"
                          DragEnter="StepSection_DragEnter" DragOver="StepSection_DragOver"
                          DragLeave="StepSection_DragLeave" Drop="StepSection_Drop"
                          IsExpanded="{Binding IsEndSectionExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Border Style="{StaticResource JobStepSectionHeaderStyle}" Tag="{Binding HasEndStepErrors}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Style="{StaticResource JobStepSectionChevronStyle}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Translate Key=Ui.Job.Steps.Section.End}" FontWeight="SemiBold" FontSize="18"/>
                                <Button x:Name="EndSettingsButton" Grid.Column="2"
                                        Style="{StaticResource ButtonIcon}" Width="28" Height="28" Margin="8,-6,8,-6"
                                        IsEnabled="{Binding IsDebugActive, Converter={StaticResource InverseBooleanConverter}}"
                                        ToolTip="{loc:Translate Key=Ui.Job.EndSettings.Tooltip}"
                                        Click="EndSettingsButton_Click">
                                    <iconPacks:PackIconMaterial Kind="CogOutline" Width="17" Height="17"/>
                                </Button>
                                <Border Grid.Column="3" Style="{StaticResource JobStepSectionCountStyle}">
                                    <TextBlock Text="{Binding EndStepCount}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                </Border>
                                <Popup x:Name="EndSettingsPopup" Grid.Column="2"
                                       PlacementTarget="{Binding ElementName=EndSettingsButton}"
                                       Placement="Bottom" HorizontalOffset="-270" VerticalOffset="8"
                                       StaysOpen="False" AllowsTransparency="True">
                                    <Border Width="330" Padding="16" CornerRadius="8"
                                            Background="{DynamicResource App.Brush.Surface}"
                                            BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1"
                                            DataContext="{Binding DataContext, Source={x:Reference EndSettingsButton}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.28"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Key=Ui.Job.EndSettings.Title}"
                                                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                            <TextBlock Text="{loc:Translate Key=Ui.Job.EndSettings.Timeout}"
                                                       FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <DockPanel LastChildFill="False">
                                                <mah:NumericUpDown Width="90"
                                                                   Style="{StaticResource AppNumericUpDownStyle}"
                                                                   HorizontalContentAlignment="Right"
                                                                   Minimum="1"
                                                                   Maximum="3600"
                                                                   Interval="1"
                                                                   NumericInputMode="Numbers"
                                                                   SnapToMultipleOfInterval="True"
                                                                   Value="{Binding EndPhaseTimeoutSeconds,
                                                                                   Mode=TwoWay,
                                                                                   UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="{loc:Translate Key=Ui.Job.EndSettings.Timeout.Unit}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </DockPanel>
                                            <TextBlock Text="{loc:Translate Key=Ui.Job.EndSettings.Timeout.Description}"
                                                       Foreground="{DynamicResource App.Brush.TextSecondary}"
                                                       TextWrapping="Wrap" Margin="0,9,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </Expander.Header>
                    <Border Margin="0,0,0,0">
                        <Grid>
                            <ListBox x:Name="EndStepsList" ItemsSource="{Binding EndSteps}"
                                     MinHeight="48" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     ItemsPanel="{StaticResource JobStepItemsPanelTemplate}"
                                     SelectionMode="Extended"
                                     SelectionChanged="StepsList_SelectionChanged"
                                     PreviewMouseRightButtonDown="StepsList_PreviewMouseRightButtonDown"
                                     MouseDoubleClick="StepsList_MouseDoubleClick"
                                     ItemContainerStyle="{StaticResource JobStepCardListBoxItemStyle}"
                                     ItemTemplate="{Binding ItemTemplate, ElementName=StepsList}"
                                     behaviors:StepDragDrop.IsLivePreviewEnabled="False"
                                     behaviors:StepDragDrop.IsGhostPreviewEnabled="True"
                                     behaviors:StepDragDrop.RequireDragHandle="True"
                                     behaviors:StepDragDrop.PlacementResolver="{Binding DropPlacementResolver}"
                                     behaviors:StepDragDrop.HoverExpandCommand="{Binding ExpandDropBlockCommand}"
                                     behaviors:StepDragDrop.DragIndicesResolver="{Binding DragIndicesResolver}"
                                     behaviors:StepDragDrop.PreviewMoveValidator="{Binding PreviewMoveValidator}"
                                     behaviors:StepDragDrop.MoveCommand="{Binding ReorderStepCommand}"/>
                        </Grid>
                    </Border>
                </Expander>
            </StackPanel>
            </ScrollViewer>
        </Border>
            <GridSplitter Grid.Column="1" Margin="2,0"
                          AutomationProperties.AutomationId="InspectorResizeGrip"
                          Style="{StaticResource InspectorGridSplitterStyle}"/>

            <Border Grid.Column="2" MinWidth="360"
                    Margin="0" Padding="16" CornerRadius="8"
                    AutomationProperties.AutomationId="SelectedJobStepInspector"
                    Background="{DynamicResource App.Brush.CardBackground}"
                    BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1">
                <Grid>
                    <Grid Visibility="{Binding HasSingleSelectedStep, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                            <iconPacks:PackIconMaterial Kind="CursorDefaultClickOutline" Width="28" Height="28"
                                                        HorizontalAlignment="Center" Margin="0,0,0,12"
                                                        Foreground="{DynamicResource App.Brush.TextMuted}"/>
                            <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.NoSelection}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource App.Brush.TextMuted}"/>
                            <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.MultipleSelection}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource App.Brush.TextMuted}"
                                       Visibility="{Binding HasMultipleSelectedSteps, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding HasSingleSelectedStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="8" Margin="0,4,16,0" VerticalAlignment="Top"><Border.Background><MultiBinding Converter="{StaticResource StepOverviewConverter}" ConverterParameter="color"><Binding Path="SelectedStep"/><Binding RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.Background><iconPacks:PackIconMaterial Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"><iconPacks:PackIconMaterial.Kind><MultiBinding Converter="{StaticResource StepOverviewConverter}" ConverterParameter="icon"><Binding Path="SelectedStep"/></MultiBinding></iconPacks:PackIconMaterial.Kind></iconPacks:PackIconMaterial></Border>

                            <StackPanel>
                                <TextBlock ToolTip="{Binding SelectedStepBreadcrumb}" Text="{Binding SelectedStepDisplayName}" FontSize="18" FontWeight="SemiBold"/>
                                <StackPanel Margin="0,2,0,0">

                                    <TextBlock Text="{Binding SelectedStepDescription}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <TabControl x:Name="SelectedJobStepTabs" Grid.Row="2"
                                    AutomationProperties.AutomationId="SelectedJobStepTabs"
                                    Style="{StaticResource InspectorPageTabControlStyle}"
                                    Loaded="SelectedJobStepTabs_Loaded"
                                    SizeChanged="SelectedJobStepTabs_SizeChanged"
                                    SelectionChanged="SelectedJobStepTabs_SelectionChanged">
                            <TabControl.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource StepInspectorScrollBarStyle}"/>
                            </TabControl.Resources>
                            <TabItem Header="{loc:Translate Key=Ui.Job.Steps.Editor.Details}">
                                <Grid>
                                    <DockPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                                        <StackPanel>


                                            <Border Margin="0,0,0,12" Padding="10" CornerRadius="5" BorderThickness="2,0,0,0" BorderBrush="{DynamicResource App.Brush.Danger}"
                                                    Background="{DynamicResource App.Brush.SurfaceRaised}" Visibility="{Binding HasSelectedStepValidationError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding SelectedStepValidationError}" TextWrapping="Wrap" Foreground="{DynamicResource App.Brush.TextPrimary}"
                                                           AutomationProperties.AutomationId="SelectedJobStepValidationError"/>
                                            </Border>
                                            <ContentControl Content="{Binding SelectedStepEditor}"
                                                            IsEnabled="{Binding IsDebugActive, Converter={StaticResource InverseBooleanConverter}}"
                                                            HorizontalContentAlignment="Stretch">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate><generated:GeneratedStepEditor/></DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                        </StackPanel>
                                    </ScrollViewer></DockPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{loc:Translate Key=Ui.Job.Steps.Editor.ReturnValue}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.ReturnValueTitle}"
                                                   FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.ReturnValueDescription}"
                                                   Margin="0,2,0,14" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                        <ContentControl>
                                            <ContentControl.Content>
                                                <MultiBinding Converter="{StaticResource JobStepDetailsConverter}">
                                                    <Binding Path="SelectedStep"/>
                                                    <Binding Path="AllJobSteps"/>
                                                    <Binding Path="StepsVersion"/>
                                                    <Binding Path="Variables"/>
                                                    <Binding Path="ProviderSources"/>
                                                    <Binding Path="LocalValues"/>
                                                </MultiBinding>
                                            </ContentControl.Content>
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.NoReturnValue}"
                                                                   TextWrapping="Wrap" Foreground="{DynamicResource App.Brush.TextMuted}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding Result}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TreeView ItemsSource="{Binding Result.Properties}" Background="Transparent" BorderThickness="0"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ItemTemplate="{StaticResource StepResultPropertyTemplate}"
                                                                  ItemContainerStyle="{StaticResource StepResultTreeItemStyle}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="{loc:Translate Key=Ui.Job.Steps.Editor.Debug}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.DebugTitle}"
                                                   FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Steps.Editor.DebugDescription}"
                                                   Margin="0,2,0,14" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{loc:Translate Key=Ui.Job.Steps.Editor.NoDebugData}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.Brush.TextMuted}"
                                               Visibility="{Binding HasSelectedDebugContext, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding HasSelectedDebugContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding SelectedDebugContextGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Status}" Margin="0,2,0,6" Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                                        <TreeView ItemsSource="{Binding Values}" Background="Transparent" BorderThickness="0"
                                                                  ItemTemplate="{StaticResource DebugContextValueTemplate}"
                                                                  ItemContainerStyle="{StaticResource DebugContextTreeItemStyle}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                <Grid Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,3">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonIcon}"
                                Command="{Binding ToggleDebugPanelCommand}"
                                ToolTip="{loc:Translate Key=Ui.Common.Close}">
                            <iconPacks:PackIconMaterial Kind="Close" Width="15" Height="15"/>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Panel.Title}"
                                       FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DebugContextResultCountText}" Margin="0,2,0,0"
                                       FontSize="11" Foreground="{DynamicResource App.Brush.TextMuted}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,8,0,10">
                        <!--<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ButtonIcon}" Command="{Binding ExpandDebugContextCommand}"
                                    ToolTip="{loc:Translate Key=Ui.Job.Debug.Panel.ExpandAll}" Margin="0,0,4,0">
                                <iconPacks:PackIconMaterial Kind="UnfoldMoreHorizontal" Width="15" Height="15"/>
                            </Button>
                            <Button Style="{StaticResource ButtonIcon}" Command="{Binding CollapseDebugContextCommand}"
                                    ToolTip="{loc:Translate Key=Ui.Job.Debug.Panel.CollapseAll}">
                                <iconPacks:PackIconMaterial Kind="UnfoldLessHorizontal" Width="15" Height="15"/>
                            </Button>
                        </StackPanel>-->
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Panel.CurrentContext}"
                                   FontSize="11" Foreground="{DynamicResource App.Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Grid.Row="2">
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Debug.Panel.EmptyContext}"
                                   TextWrapping="Wrap" Margin="4" Opacity="0.65"
                                   Visibility="{Binding HasDebugContext, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <ScrollViewer x:Name="DebugContextScrollViewer"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      Visibility="{Binding HasDebugContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding DebugContextGroups}"
                                          HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  Style="{StaticResource DebugResultExpanderStyle}">
                                            <Expander.Header>
                                                <Border Padding="10,9" CornerRadius="6"
                                                        Background="{DynamicResource App.Brush.SurfaceHover}"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.CardBorder}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static jobs:JobStepDebugState.Failed}">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="20" Height="20" CornerRadius="4"
                                                                VerticalAlignment="Top"
                                                                Background="{DynamicResource App.Brush.Surface}">
                                                            <iconPacks:PackIconMaterial Width="14" Height="14"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource App.Brush.TextSecondary}">
                                                                <iconPacks:PackIconMaterial.Style>
                                                                    <Style TargetType="iconPacks:PackIconMaterial">
                                                                        <Setter Property="Kind" Value="ChevronRight"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="True">
                                                                                <Setter Property="Kind" Value="ChevronDown"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </iconPacks:PackIconMaterial.Style>
                                                            </iconPacks:PackIconMaterial>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                        <Border Grid.Column="2" Padding="7,2" CornerRadius="9"
                                                                VerticalAlignment="Top">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1F43A047"/>
                                                                    <Setter Property="TextElement.Foreground" Value="#43A047"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static jobs:JobStepDebugState.Skipped}">
                                                                            <Setter Property="Background" Value="{DynamicResource App.Brush.Surface}"/>
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static jobs:JobStepDebugState.Failed}">
                                                                            <Setter Property="Background" Value="#20E53935"/>
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Danger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <iconPacks:PackIconMaterial Width="11" Height="11"
                                                                    VerticalAlignment="Center" Margin="0,0,4,0">
                                                                    <iconPacks:PackIconMaterial.Style>
                                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                                            <Setter Property="Kind" Value="CheckCircle"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static jobs:JobStepDebugState.Skipped}">
                                                                                    <Setter Property="Kind" Value="MinusCircle"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static jobs:JobStepDebugState.Failed}">
                                                                                    <Setter Property="Kind" Value="AlertCircle"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </iconPacks:PackIconMaterial.Style>
                                                                </iconPacks:PackIconMaterial>
                                                                <TextBlock Text="{Binding Status}" FontSize="9"
                                                                           FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                                   Text="{Binding Summary}" Margin="0,5,0,0"
                                                                   FontSize="10" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource App.Brush.TextSecondary}"
                                                                   MaxHeight="30"/>
                                                    </Grid>
                                                </Border>
                                            </Expander.Header>
                                            <Grid Margin="10,7,2,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Subtitle}" Margin="1,0,0,5" FontSize="10"
                                                           Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                                <TreeView Grid.Row="1" ItemsSource="{Binding Values}"
                                                          Background="Transparent" BorderThickness="0"
                                                          ItemTemplate="{StaticResource DebugContextValueTemplate}"
                                                          ItemContainerStyle="{StaticResource DebugContextTreeItemStyle}"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                            </Grid>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
