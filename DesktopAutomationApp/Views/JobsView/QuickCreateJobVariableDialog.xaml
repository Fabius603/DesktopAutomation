<mah:MetroWindow x:Class="DesktopAutomationApp.Views.QuickCreateJobVariableDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
                 xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
                 WindowStartupLocation="CenterOwner"
                 Width="500" SizeToContent="Height" MaxHeight="650"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 Title="{loc:Translate Key=Ui.ValueReference.CreateVariable}"
                 Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:Translate Key=Ui.ValueReference.CreateVariable.DialogHint}"
                   TextWrapping="Wrap" Foreground="{DynamicResource App.Brush.TextSecondary}"/>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource App.Brush.Danger}"
                       Text="{Binding NameValidationMessage}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Type}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedKind}"
                      DisplayMemberPath="DisplayName"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Value}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <jobs:JobVariableValueEditor DataContext="{Binding Editor}"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Translate Key=Common.Cancel}" IsCancel="True" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{loc:Translate Key=Ui.ValueReference.CreateVariable}" IsDefault="True"
                    Style="{StaticResource ButtonPrimary}" MinWidth="120" Click="Create_Click"
                    IsEnabled="{Binding CanCreate}"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
