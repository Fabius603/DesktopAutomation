<mah:MetroWindow x:Class="DesktopAutomationApp.Views.JobVariablesDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:context="clr-namespace:DesktopAutomationApp.Behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
 xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
 xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
 xmlns:conv="clr-namespace:DesktopAutomationApp.Converters"
 WindowStartupLocation="CenterOwner" Width="1140" Height="710" MinWidth="980" MinHeight="580"
 Title="{loc:Translate Key=Ui.Job.Variables.DialogTitle}" ResizeMode="CanResize" ShowInTaskbar="False"
 Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" Style="{StaticResource DialogWindowStyle}"
 WindowTitleBrush="{DynamicResource App.Brush.Surface}" NonActiveWindowTitleBrush="{DynamicResource App.Brush.Surface}"
 TitleForeground="{DynamicResource App.Brush.TextPrimary}" FontSize="14">
 <mah:MetroWindow.InputBindings>
  <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}"/>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddVariableCommand}"/>
  <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateVariableCommand}" CommandParameter="{Binding SelectedJobVariable}"/>
  <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}"/>
 </mah:MetroWindow.InputBindings>
 <mah:MetroWindow.CommandBindings>
  <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="Find_Executed"/>
  <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="Close_Executed"/>
 </mah:MetroWindow.CommandBindings>
 <mah:MetroWindow.Resources>
  <conv:StepOverviewConverter x:Key="VariableUsageStepPresentation"/>
  <Style x:Key="DialogPrimaryAction" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}"><Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal"/></Style>
  <Style x:Key="DialogSecondaryAction" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}"><Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal"/></Style>
  <Style x:Key="VariableListItemStyle" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" Padding="12,12" CornerRadius="6" Background="{DynamicResource App.Brush.SurfaceRaised}" BorderThickness="1" BorderBrush="{DynamicResource App.Brush.CardBorder}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </mah:MetroWindow.Resources>
 <Grid Background="{DynamicResource App.Brush.WindowBackground}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="365"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Padding="16,18" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource App.Brush.CardBorder}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,8,0">
       <TextBox x:Name="VariableSearchBox" Text="{Binding VariableSearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Padding="30,7,8,7"
        mah:TextBoxHelper.Watermark="{loc:Translate Key=Ui.Job.Variables.Search}" ToolTip="{loc:Translate Key=Ui.Job.Variables.Shortcut.Search}"
        AutomationProperties.AutomationId="JobVariableSearch" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Variables.Search}"/>
       <icons:PackIconMaterial Kind="Magnify" Width="16" Height="16" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource App.Brush.TextSecondary}"/>
      </Grid>
      <Button Grid.Column="1" Command="{Binding AddVariableCommand}" Style="{StaticResource DialogSecondaryAction}" Padding="10,7" AutomationProperties.AutomationId="AddJobVariableButton" ToolTip="{loc:Translate Key=Ui.Job.Variables.Shortcut.Add}">
       <StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Plus" Width="15" Height="15" Margin="0,0,5,0"/><TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Add}"/></StackPanel>
      </Button>
     </Grid>
     <ComboBox Grid.Row="1" ItemsSource="{Binding VariableTypeFilterOptions}" SelectedItem="{Binding SelectedVariableTypeFilter}" DisplayMemberPath="DisplayName" Margin="0,0,0,12"
      AutomationProperties.AutomationId="JobVariableTypeFilter" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Variables.Filter.Type}"/>
     <Grid Grid.Row="2">
      <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Empty}" Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="270" TextAlignment="Center" Visibility="{Binding HasEmptyVariableView, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.EmptyFilter}" Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="270" TextAlignment="Center" Visibility="{Binding HasEmptyVariableFilterResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      <ListBox x:Name="VariableList" SelectionMode="Extended" context:ContextActions.Profile="Variables" ItemsSource="{Binding FilteredJobVariables}" SelectedItem="{Binding SelectedJobVariable, Mode=TwoWay}" ItemContainerStyle="{StaticResource VariableListItemStyle}" Background="Transparent" BorderThickness="0"
       AutomationProperties.AutomationId="JobVariableList" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Variables.DialogTitle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

       <ListBox.ItemTemplate><DataTemplate><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource App.Brush.Accent}" Width="35" Height="35" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center"><icons:PackIconMaterial Kind="{Binding Icon}" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1">
         <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
         <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding TypeDisplayName}" FontSize="12" Foreground="{DynamicResource App.Brush.TextSecondary}" Margin="0,0,12,0"/>
          <TextBlock Grid.Column="1" Text="{Binding CompactValue}" Foreground="{DynamicResource App.Brush.TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding CompactValue}"/>
         </Grid>
         <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Draft.Changed}" Foreground="{DynamicResource App.Brush.Accent}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
       </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </Grid>
   </Border>
   <Grid Grid.Column="1">
    <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.SelectHint}" Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSelectedJobVariable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
    <ContentControl Content="{Binding SelectedJobVariable}" Visibility="{Binding HasSelectedJobVariable, Converter={StaticResource BooleanToVisibilityConverter}}">
     <ContentControl.ContentTemplate><DataTemplate>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="24,22">
        <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <DockPanel><Border DockPanel.Dock="Left" Background="{DynamicResource App.Brush.Accent}" Width="40" Height="40" CornerRadius="7" Margin="0,0,12,0"><icons:PackIconMaterial Kind="{Binding Icon}" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding TypeDisplayName}" Foreground="{DynamicResource App.Brush.TextSecondary}" Margin="0,3,0,0"/></StackPanel>
         </DockPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource DialogSecondaryAction}" Padding="9,6" Margin="0,0,6,0" Content="{loc:Translate Key=Ui.Job.Variables.Duplicate}" Command="{Binding DataContext.DuplicateVariableCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="DuplicateJobVariableButton"/>
          <Button Style="{StaticResource DialogSecondaryAction}" Padding="9,6" Content="{loc:Translate Key=Ui.Job.Variables.Delete.Action}" Command="{Binding DataContext.DeleteVariableCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="DeleteJobVariableButton"/>
         </StackPanel>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Name}" VerticalAlignment="Center" Margin="0,0,12,10"/>
         <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsShared}" Margin="0,0,0,10" AutomationProperties.AutomationId="JobVariableName" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Variables.Name}"/>
         <TextBlock Grid.Row="1" Text="{loc:Translate Key=Ui.Job.Variables.Type}" VerticalAlignment="Top" Margin="0,8,12,10"/>
         <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
          <Grid>
           <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}" IsEnabled="{Binding CanChangeKind}" DisplayMemberPath="DisplayName" Visibility="{Binding CanChangeKind, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="JobVariableType" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Variables.Type}"/>
           <Border Background="{DynamicResource App.Brush.SurfaceRaised}" BorderBrush="{DynamicResource App.Brush.BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,7" Visibility="{Binding CanChangeKind, Converter={StaticResource InverseBooleanToVisibilityConverter}}" ToolTip="{loc:Translate Key=Ui.Job.Variables.Type.Locked}" AutomationProperties.AutomationId="LockedJobVariableType" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Variables.Type.Locked}">
            <DockPanel><icons:PackIconMaterial DockPanel.Dock="Right" Kind="LockOutline" Width="16" Height="16" Foreground="{DynamicResource App.Brush.TextSecondary}"/><TextBlock Text="{Binding TypeDisplayName}" Foreground="{DynamicResource App.Brush.TextSecondary}"/></DockPanel>
           </Border>
          </Grid>
          <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Type.Locked}" Foreground="{DynamicResource App.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding CanChangeKind, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
         </StackPanel>
         <TextBlock Grid.Row="2" Text="{loc:Translate Key=Ui.Job.Variables.Value}" VerticalAlignment="Top" Margin="0,8,12,12" FontWeight="SemiBold"/>
         <jobs:JobVariableValueEditor Grid.Row="2" Grid.Column="1" Margin="0,0,0,14" AutomationProperties.AutomationId="JobVariableValue" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Variables.Value}"/>
         <TextBlock Grid.Row="3" Text="{loc:Translate Key=Ui.Job.Variables.Description.Optional}" TextWrapping="Wrap" Margin="0,8,12,0"/>
         <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" AutomationProperties.AutomationId="JobVariableDescription" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Variables.Description.Optional}"/>
        </Grid>
        <Border Height="1" Background="{DynamicResource App.Brush.CardBorder}" Margin="0,24,0,16"/>
        <Grid><TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Usage.Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding UsageText}" Foreground="{DynamicResource App.Brush.TextSecondary}" HorizontalAlignment="Right"/></Grid>
        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Usage.None}" Foreground="{DynamicResource App.Brush.TextSecondary}" Margin="0,12,0,0" Visibility="{Binding IsUsed, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        <ListBox context:ContextActions.Profile="VariableUsages" ItemsSource="{Binding UsageItems}" SelectedItem="{Binding DataContext.SelectedVariableUsage, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="JobVariableUsageList" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Variables.Usage.Title}">
         <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource VariableListItemStyle}"><Setter Property="Margin" Value="0,0,0,6"/></Style></ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate><DataTemplate><Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center"><Border.Background><MultiBinding Converter="{StaticResource VariableUsageStepPresentation}" ConverterParameter="color"><Binding Path="Step"/><Binding RelativeSource="{RelativeSource Self}"/></MultiBinding></Border.Background><icons:PackIconMaterial Width="21" Height="21" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"><icons:PackIconMaterial.Kind><MultiBinding Converter="{StaticResource VariableUsageStepPresentation}" ConverterParameter="icon"><Binding Path="Step"/></MultiBinding></icons:PackIconMaterial.Kind></icons:PackIconMaterial></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="{Binding StepName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding InputName}" Foreground="{DynamicResource App.Brush.TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
           <Button Style="{StaticResource DialogSecondaryAction}" Padding="9,6" FontSize="12" Content="{loc:Translate Key=Ui.Job.Variables.Usage.OnlyThis}" Command="{Binding DataContext.ApplyVariableToSelectedUsageCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="DetachJobVariableUsageButton" ToolTip="{loc:Translate Key=Ui.Job.Variables.Draft.SelectUsageHint}" Visibility="{Binding DataContext.SelectedJobVariable.HasMultipleUsages, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
           <Button Style="{StaticResource ButtonIcon}" Command="{Binding DataContext.OpenVariableUsageCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}" CommandParameter="{Binding}" ToolTip="{loc:Translate Key=Ui.Job.Variables.Usage.Open}" AutomationProperties.Name="{loc:Translate Key=Ui.Job.Variables.Usage.Open}" AutomationProperties.AutomationId="OpenJobVariableUsageButton" Margin="6,0,0,0"><icons:PackIconMaterial Kind="ArrowRight" Width="16" Height="16"/></Button>
          </StackPanel>
         </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Usage.Warning}" Foreground="{DynamicResource App.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="{Binding HasMultipleUsages, Converter={StaticResource BooleanToVisibilityConverter}}"/>
       </StackPanel>
      </ScrollViewer>
     </DataTemplate></ContentControl.ContentTemplate>
    </ContentControl>
   </Grid>
  </Grid>
  <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource App.Brush.CardBorder}" Background="{DynamicResource App.Brush.Surface}" Padding="16,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding VariableDraftStatusText}" Foreground="{DynamicResource App.Brush.TextPrimary}"/>
     <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Draft.Retained}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Brush.TextSecondary}" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Command="{Binding DiscardVariableChangesCommand}" Content="{loc:Translate Key=Ui.Job.Variables.Draft.Discard}" Style="{StaticResource DialogSecondaryAction}" Margin="0,0,8,0" AutomationProperties.AutomationId="DiscardJobVariableChangesButton"/>
     <Button Command="{Binding ApplySelectedVariableCommand}" Content="{loc:Translate Key=Ui.Job.Variables.Draft.ApplySelected}" Style="{StaticResource DialogPrimaryAction}" AutomationProperties.AutomationId="ApplyJobVariableChangesButton"/>
     <Button Command="{Binding ApplyAllVariableChangesCommand}" Content="{loc:Translate Key=Ui.Job.Variables.Draft.ApplyAll}" Style="{StaticResource DialogSecondaryAction}" Margin="8,0,0,0" Visibility="{Binding ShowApplyAllVariableChanges, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="ApplyAllJobVariableChangesButton"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</mah:MetroWindow>
