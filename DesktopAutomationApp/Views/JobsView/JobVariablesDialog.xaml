<mah:MetroWindow x:Class="DesktopAutomationApp.Views.JobVariablesDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
                 xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 WindowStartupLocation="CenterOwner"
                 Width="920" Height="720"
                 MinWidth="700" MinHeight="520"
                 Title="{loc:Translate Key=Ui.Job.Variables.DialogTitle}"
                 ResizeMode="CanResize" ShowInTaskbar="False"
                 Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource App.Brush.Surface}"
                BorderBrush="{DynamicResource App.Brush.CardBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="8"
                        Background="{DynamicResource App.Brush.AccentSubtle}"
                        Margin="0,0,14,0">
                    <iconPacks:PackIconMaterial Kind="CodeBraces" Width="21" Height="21"
                                                Foreground="{DynamicResource App.Brush.Accent}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.DialogTitle}"
                               FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.DialogDescription}"
                               Foreground="{DynamicResource App.Brush.TextMuted}"
                               TextWrapping="Wrap" Margin="0,3,12,0"/>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding AddVariableCommand}"
                        Style="{StaticResource ButtonPrimary}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="15" Height="15" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Add}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" CornerRadius="8"
                Background="{DynamicResource App.Brush.Surface}"
                BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding VariableSearchText, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="{loc:Translate Key=Ui.Job.Variables.Search}"
                         mah:TextBoxHelper.UseFloatingWatermark="False" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="{loc:Translate Key=Ui.Job.Variables.Filter.Shared}" IsChecked="{Binding ShowSharedVariables}" Margin="0,0,10,0"/>
                    <CheckBox Content="{loc:Translate Key=Ui.Job.Variables.Filter.StepValues}" IsChecked="{Binding ShowStepValues}" Margin="0,0,10,0"/>
                    <CheckBox Content="{loc:Translate Key=Ui.Job.Variables.Filter.Used}" IsChecked="{Binding ShowUsedVariables}" Margin="0,0,10,0"/>
                    <CheckBox Content="{loc:Translate Key=Ui.Job.Variables.Filter.Unused}" IsChecked="{Binding ShowUnusedVariables}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource App.Brush.Surface}"
                BorderBrush="{DynamicResource App.Brush.CardBorder}"
                BorderThickness="1" CornerRadius="10">
            <Grid>
                <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Empty}"
                           TextWrapping="Wrap" Opacity="0.65"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="460" TextAlignment="Center"
                           Visibility="{Binding HasJobVariables, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.EmptyFilter}"
                           TextWrapping="Wrap" Opacity="0.65"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="460" TextAlignment="Center"
                           Visibility="{Binding HasFilteredJobVariables, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="18,16">
                    <ItemsControl ItemsSource="{Binding FilteredJobVariables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="16" CornerRadius="8"
                                        Background="{DynamicResource App.Brush.SurfaceHover}"
                                        BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ScopeLabel}" Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                            <Border Grid.Column="1" Padding="7,2" CornerRadius="8"
                                                    Background="{DynamicResource App.Brush.AccentSubtle}"
                                                    ToolTip="{Binding UsageSummary}">
                                                <TextBlock Text="{Binding UsageText}" FontSize="10"
                                                           Foreground="{DynamicResource App.Brush.Accent}"/>
                                            </Border>
                                            <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Width="28" Height="28" Margin="6,0,0,0"
                                                    ToolTip="{loc:Translate Key=Ui.Job.Variables.Duplicate}"
                                                    Command="{Binding DataContext.DuplicateVariableCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}"
                                                    CommandParameter="{Binding}">
                                                <iconPacks:PackIconMaterial Kind="ContentCopy" Width="15" Height="15"/>
                                            </Button>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsShared}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Type}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" IsEnabled="{Binding IsShared}"
                                                          DisplayMemberPath="DisplayName"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Width="32" Height="32"
                                                    Margin="4,21,0,0" VerticalAlignment="Top"
                                                    ToolTip="{loc:Translate Key=Ui.Job.Variables.Delete.Title}"
                                                    Command="{Binding DataContext.DeleteVariableCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}"
                                                    CommandParameter="{Binding}">
                                                <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="17" Height="17"/>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Description}" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Value}" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                        <jobs:JobVariableValueEditor/>
                                        <Button Margin="0,10,0,0" HorizontalAlignment="Left"
                                                Style="{StaticResource ButtonSecondary}"
                                                Visibility="{Binding IsStepValue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.PromoteVariableCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="ShareVariantOutline" Width="14" Height="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.PromoteToShared}"/>
                                            </StackPanel>
                                        </Button>
                                        <Expander Margin="0,10,0,0"
                                                  Visibility="{Binding IsUsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding UsageText}" FontWeight="SemiBold"/>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding UsageSteps}" Margin="20,5,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat='• {0}'}" Margin="0,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                        <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="6"
                                                Background="{DynamicResource App.Brush.AccentSubtle}"
                                                Visibility="{Binding HasMultipleUsages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="InformationOutline" Width="15" Height="15"
                                                                            Foreground="{DynamicResource App.Brush.Accent}" Margin="0,1,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Usage.Warning}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding UsageSummary}" Margin="0,3,0,0" FontSize="10"
                                                               Foreground="{DynamicResource App.Brush.TextSecondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0"
                Background="{DynamicResource App.Brush.Surface}"
                BorderBrush="{DynamicResource App.Brush.CardBorder}"
                BorderThickness="1" CornerRadius="10" Padding="14,11">
            <Grid>
                <Button HorizontalAlignment="Right" MinWidth="100" IsDefault="True" IsCancel="True"
                        Style="{StaticResource ButtonPrimary}" Click="Close_Click"
                        Content="{loc:Translate Key=Ui.Common.Close}"/>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
