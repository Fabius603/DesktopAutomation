<mah:MetroWindow x:Class="DesktopAutomationApp.Views.JobVariablesDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
                 xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 WindowStartupLocation="CenterOwner"
                 Width="1120" Height="760"
                 MinWidth="880" MinHeight="600"
                 Title="{loc:Translate Key=Ui.Job.Variables.DialogTitle}"
                 ResizeMode="CanResize" ShowInTaskbar="False"
                 Style="{StaticResource DialogWindowStyle}">
    <mah:MetroWindow.Resources>
        <CollectionViewSource x:Key="GroupedVariables" Source="{Binding FilteredJobVariables}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="ScopeLabel"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="VariableListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="12,10" CornerRadius="7"
                                Background="{DynamicResource App.Brush.SurfaceHover}"
                                BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3,3,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource App.Brush.Surface}"
                BorderBrush="{DynamicResource App.Brush.CardBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="8"
                        Background="{DynamicResource App.Brush.AccentSubtle}"
                        Margin="0,0,14,0">
                    <iconPacks:PackIconMaterial Kind="CodeBraces" Width="21" Height="21"
                                                Foreground="{DynamicResource App.Brush.Accent}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.DialogTitle}"
                               FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.DialogDescription}"
                               Foreground="{DynamicResource App.Brush.TextMuted}"
                               TextWrapping="Wrap" Margin="0,3,12,0"/>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding AddVariableCommand}"
                        Style="{StaticResource ButtonPrimary}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="15" Height="15" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Add}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource App.Brush.Surface}"
                BorderBrush="{DynamicResource App.Brush.CardBorder}"
                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding VariableSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="{loc:Translate Key=Ui.Job.Variables.Search}"
                                 mah:TextBoxHelper.UseFloatingWatermark="False" Margin="0,0,8,0"/>
                        <Button x:Name="FilterButton" Grid.Column="1" Click="FilterButton_Click"
                                Style="{StaticResource ButtonSecondary}" MinWidth="40"
                                ToolTip="{loc:Translate Key=Ui.Job.Variables.Filter.Title}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FilterVariant" Width="16" Height="16"/>
                                <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="8"
                                        Background="{DynamicResource App.Brush.AccentSubtle}"
                                        Visibility="{Binding HasActiveVariableFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ActiveVariableFilterCount}" FontSize="10"
                                               Foreground="{DynamicResource App.Brush.Accent}"/>
                                </Border>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Variables.Filter.Scope}" StaysOpenOnClick="True">
                                        <MenuItem Header="{loc:Translate Key=Ui.Job.Variables.Filter.Shared}" IsCheckable="True"
                                                  IsChecked="{Binding ShowSharedVariables}" StaysOpenOnClick="True"/>
                                        <MenuItem Header="{loc:Translate Key=Ui.Job.Variables.Filter.StepValues}" IsCheckable="True"
                                                  IsChecked="{Binding ShowStepValues}" StaysOpenOnClick="True"/>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Variables.Filter.Usage}" StaysOpenOnClick="True">
                                        <MenuItem Header="{loc:Translate Key=Ui.Job.Variables.Filter.Used}" IsCheckable="True"
                                                  IsChecked="{Binding ShowUsedVariables}" StaysOpenOnClick="True"/>
                                        <MenuItem Header="{loc:Translate Key=Ui.Job.Variables.Filter.Unused}" IsCheckable="True"
                                                  IsChecked="{Binding ShowUnusedVariables}" StaysOpenOnClick="True"/>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Variables.Filter.Type}" StaysOpenOnClick="True">
                                        <ComboBox ItemsSource="{Binding VariableTypeFilterOptions}"
                                                  SelectedItem="{Binding SelectedVariableTypeFilter}"
                                                  DisplayMemberPath="DisplayName" Width="180" Margin="8,5"/>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{loc:Translate Key=Ui.Job.Variables.Filter.Reset}"
                                              Command="{Binding ResetVariableFiltersCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,9,0,3"
                               Visibility="{Binding HasActiveVariableFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Style="{StaticResource FilterChipStyle}"
                                Visibility="{Binding HasScopeVariableFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ScopeVariableFilterLabel}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource ButtonIcon}" Width="22" Height="22" Margin="4,0,0,0"
                                        Command="{Binding ResetVariableScopeFilterCommand}">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FilterChipStyle}"
                                Visibility="{Binding HasUsageVariableFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UsageVariableFilterLabel}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource ButtonIcon}" Width="22" Height="22" Margin="4,0,0,0"
                                        Command="{Binding ResetVariableUsageFilterCommand}">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FilterChipStyle}"
                                Visibility="{Binding HasTypeVariableFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedVariableTypeFilter.DisplayName}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource ButtonIcon}" Width="22" Height="22" Margin="4,0,0,0"
                                        Command="{Binding ResetVariableTypeFilterCommand}">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <Grid Grid.Row="2" Margin="0,9,0,0">
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Empty}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource App.Brush.TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="280" TextAlignment="Center"
                                   Visibility="{Binding HasJobVariables, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.EmptyFilter}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource App.Brush.TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="280" TextAlignment="Center"
                                   Visibility="{Binding HasEmptyVariableFilterResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ListBox ItemsSource="{Binding Source={StaticResource GroupedVariables}}"
                                 SelectedItem="{Binding SelectedJobVariable, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource VariableListItemStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Margin="2,8,0,7"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CompactValue}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,2"/>
                                        <Border Grid.Column="1" Padding="7,2" CornerRadius="8"
                                                Background="{DynamicResource App.Brush.AccentSubtle}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TypeDisplayName}" FontSize="10"
                                                       Foreground="{DynamicResource App.Brush.Accent}"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UsageText}" Margin="8,0,0,0"
                                                   FontSize="10" Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource App.Brush.CardBorder}"/>

                <Grid Grid.Column="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasSelectedJobVariable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.SelectHint}"
                                   Foreground="{DynamicResource App.Brush.TextMuted}" TextAlignment="Center"/>
                    </StackPanel>

                    <ContentControl Content="{Binding SelectedJobVariable}"
                                    Visibility="{Binding HasSelectedJobVariable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="24,20,24,24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="190"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Name}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsShared}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Type}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                <ComboBox ItemsSource="{Binding KindOptions}"
                                                          SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsShared}" DisplayMemberPath="DisplayName"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                            <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Value}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <jobs:JobVariableValueEditor/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                                            <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Description}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Border Grid.Row="3" Margin="0,22,0,0" Padding="14" CornerRadius="8"
                                                Background="{DynamicResource App.Brush.SurfaceHover}"
                                                BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Usage.Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding UsageText}" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                                </Grid>
                                                <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Usage.None}"
                                                           Margin="0,9,0,0" Foreground="{DynamicResource App.Brush.TextMuted}"
                                                           Visibility="{Binding IsUsed, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                <ItemsControl ItemsSource="{Binding UsageItems}" Margin="0,7,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button HorizontalContentAlignment="Stretch" Margin="0,2,0,0" Padding="9,7"
                                                                    Style="{StaticResource ButtonSecondary}"
                                                                    Command="{Binding DataContext.OpenVariableUsageCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{loc:Translate Key=Ui.Job.Variables.Usage.Open}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding StepName}" FontWeight="SemiBold" TextAlignment="Left"/>
                                                                        <TextBlock Text="{Binding InputName}" Margin="0,2,0,0" TextAlignment="Left"
                                                                                   Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                                                    </StackPanel>
                                                                    <iconPacks:PackIconMaterial Grid.Column="1" Kind="ArrowRight" Width="15" Height="15"
                                                                                              VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                                                        Background="{DynamicResource App.Brush.AccentSubtle}"
                                                        Visibility="{Binding HasMultipleUsages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="15" Height="15"
                                                                                    Foreground="{DynamicResource App.Brush.Accent}" Margin="0,1,8,0"/>
                                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Usage.Warning}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="4" Margin="0,20,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource ButtonSecondary}"
                                                        Command="{Binding DataContext.DuplicateVariableCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="ContentCopy" Width="15" Height="15" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Duplicate}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="8,0,0,0" Style="{StaticResource ButtonSecondary}"
                                                        Visibility="{Binding IsStepValue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Command="{Binding DataContext.PromoteVariableCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.PromoteToShared}"/>
                                                </Button>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource ButtonDanger}"
                                                    Command="{Binding DataContext.DeleteVariableCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Delete.Action}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button HorizontalAlignment="Right" MinWidth="100" IsDefault="True" IsCancel="True"
                    Style="{StaticResource ButtonPrimary}" Click="Close_Click"
                    Content="{loc:Translate Key=Ui.Common.Close}"/>
        </Grid>
    </Grid>
</mah:MetroWindow>
