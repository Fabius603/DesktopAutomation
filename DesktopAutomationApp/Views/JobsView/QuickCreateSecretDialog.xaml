<mah:MetroWindow x:Class="DesktopAutomationApp.Views.QuickCreateSecretDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
                 WindowStartupLocation="CenterOwner"
                 Width="500" SizeToContent="Height" MaxHeight="650"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 Title="{loc:Translate Key=Ui.ValueReference.CreateSecret}"
                 Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:Translate Key=Ui.ValueReference.CreateSecret.DialogHint}"
                   TextWrapping="Wrap" Foreground="{DynamicResource App.Brush.TextSecondary}"/>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Description}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{loc:Translate Key=Ui.ValueReference.CreateSecret.Value}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox PasswordChanged="SecretValue_Changed"/>
        </StackPanel>
        <TextBlock Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource App.Brush.Danger}"
                   Text="{Binding ValidationMessage}"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Translate Key=Common.Cancel}" IsCancel="True" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{loc:Translate Key=Ui.ValueReference.CreateSecret}" IsDefault="True"
                    Style="{StaticResource ButtonPrimary}" MinWidth="120" Click="Create_Click"
                    IsEnabled="{Binding CanCreate}"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
