<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.ValueReferencePicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
             MaxHeight="34" VerticalAlignment="Top"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <jobs:ResultPathPicker x:Name="PathPicker"
                               ItemsSource="{Binding SelectionTree}"
                               IsRichPreview="True"
                               DisplayText="{Binding SelectedPropertyName}"
                               InlineText="{Binding SelectedInlineText}"
                               PreviewText="{Binding SelectedPreviewValue}"
                               SourceText="{Binding SelectedPreviewSource}"
                               ContextText="{Binding PickerContextText}"
                               SecondaryText="{Binding SelectedPreviewType}"
                               ToolTipValue="{Binding SelectedTooltipValue}"
                               ToolTipDescription="{Binding SelectedTooltipDescription}"
                               SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               ExpectedTypeText="{Binding ExpectedTypeText}"
                               CreateCommand="{Binding CreateJobVariableCommand}"
                               ShowCreateAction="{Binding ShowCreateVariableAction}"/>
    </Grid>
</UserControl>
