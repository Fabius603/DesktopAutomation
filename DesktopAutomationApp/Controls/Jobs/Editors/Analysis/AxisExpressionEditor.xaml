<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.Editors.Analysis.AxisExpressionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopAutomationApp.Controls"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization">
    <Border Style="{StaticResource GeometryCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button HorizontalAlignment="Right"
                    Style="{StaticResource ButtonIconDanger}"
                    Content="{loc:Translate Key=Ui.Common.RemoveSymbol}"
                    Command="{Binding RemoveCommand}"
                    ToolTip="{loc:Translate Key=Ui.Step.Settings.RemoveExpression}"/>

            <controls:ResponsiveColumnsPanel Grid.Row="1" Margin="0,6,0,0"
                                             MinItemWidth="100" MaxColumns="3"
                                             HorizontalSpacing="8" VerticalSpacing="8">
            <ComboBox
                      ItemsSource="{Binding AvailableAxes}"
                      SelectedItem="{Binding Axis, Mode=TwoWay}"/>
            <ComboBox
                      ItemsSource="{Binding AvailableOperators}"
                      SelectedItem="{Binding Operator, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource PointAxisOperatorConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox
                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </controls:ResponsiveColumnsPanel>
        </Grid>
    </Border>
</UserControl>
