<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.Editors.Analysis.PointEntryEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
             xmlns:shared="clr-namespace:DesktopAutomationApp.Controls.Jobs.Shared"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization">
    <UserControl.Resources>
        <DataTemplate x:Key="PointSourceOptionTemplate">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
        </DataTemplate>
        <DataTemplate x:Key="PointSourceContentTemplate">
            <Grid>
                <Grid Visibility="{Binding ShowManual, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.Coordinates}"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.X}" Style="{StaticResource StepAxisLabel}" Width="16"/>
                        <TextBox Width="90" Margin="0,0,16,0" Text="{Binding ManualX, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.Y}" Style="{StaticResource StepAxisLabel}" Width="16"/>
                        <TextBox Width="90" Text="{Binding ManualY, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <Grid Visibility="{Binding ShowJobResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.DetectionStep}"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                    <jobs:ResultBindingPicker Grid.Column="1" DataContext="{Binding PointsSource}"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="{DynamicResource App.Brush.SurfaceRaised}"
            BorderBrush="{DynamicResource App.Brush.BorderSubtle}"
            BorderThickness="1" CornerRadius="7" Padding="12,10" Margin="0,0,0,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.PointSource}"
                           VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                <Button Grid.Column="1" Content="{loc:Translate Key=Ui.Step.Settings.RemovePoint}"
                        Command="{Binding RemoveCommand}" FontSize="11" Padding="8,3"/>
            </Grid>

            <shared:ChoiceGroupEditor Grid.Row="1"
                                      ItemsSource="{Binding SourceOptions}"
                                      SelectedItem="{Binding SelectedSourceOption, Mode=TwoWay}"
                                      SelectedContent="{Binding}"
                                      ItemTemplate="{StaticResource PointSourceOptionTemplate}"
                                      SelectedContentTemplate="{StaticResource PointSourceContentTemplate}"/>
        </Grid>
    </Border>
</UserControl>
