<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.Editors.Analysis.PointEntryEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
             xmlns:geometry="clr-namespace:DesktopAutomationApp.Controls.Jobs.Geometry"
             xmlns:shared="clr-namespace:DesktopAutomationApp.Controls.Jobs.Shared"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization">
    <UserControl.Resources>
        <DataTemplate x:Key="PointSourceOptionTemplate">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
        </DataTemplate>
        <DataTemplate x:Key="PointSourceContentTemplate">
            <Grid>
                <geometry:GeometryValueEditor
                    Visibility="{Binding ShowManual, Converter={StaticResource BooleanToVisibilityConverter}}"
                    X="{Binding ManualX, Mode=TwoWay}"
                    Y="{Binding ManualY, Mode=TwoWay}"/>
                <Grid Visibility="{Binding ShowJobResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.DetectionStep}"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                    <jobs:ResultBindingPicker Grid.Column="1" DataContext="{Binding PointsSource}"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource GeometryCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.PointSource}"
                           Style="{StaticResource GeometrySectionHeader}"/>
                <Button Grid.Column="1"
                        Style="{StaticResource ButtonIconDanger}"
                        Content="{loc:Translate Key=Ui.Common.RemoveSymbol}"
                        Command="{Binding RemoveCommand}"
                        ToolTip="{loc:Translate Key=Ui.Step.Settings.RemovePoint}"/>
            </Grid>

            <shared:ChoiceGroupEditor Grid.Row="1"
                                      ItemsSource="{Binding SourceOptions}"
                                      SelectedItem="{Binding SelectedSourceOption, Mode=TwoWay}"
                                      SelectedContent="{Binding}"
                                      ItemTemplate="{StaticResource PointSourceOptionTemplate}"
                                      SelectedContentTemplate="{StaticResource PointSourceContentTemplate}"/>
        </Grid>
    </Border>
</UserControl>
