<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.Editors.Analysis.PointEntryEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopAutomationApp.Controls"
             xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
             xmlns:geometry="clr-namespace:DesktopAutomationApp.Controls.Jobs.Geometry"
             xmlns:generated="clr-namespace:DesktopAutomationApp.Controls.Jobs.Editors.Generated"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization">
    <Border Style="{StaticResource GeometryCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.PointSource}"
                           Style="{StaticResource GeometrySectionHeader}"/>
                <Button Grid.Column="1"
                        Style="{StaticResource ButtonIconDanger}"
                        Content="{loc:Translate Key=Ui.Common.RemoveSymbol}"
                        Command="{Binding RemoveCommand}"
                        ToolTip="{loc:Translate Key=Ui.Step.Settings.RemovePoint}"/>
            </Grid>

            <controls:ResponsiveActionPanel CanWrap="False" Grid.Row="1"
                                            MinPrimaryWidth="220"
                                            HorizontalSpacing="12"
                                            VerticalSpacing="6">
                <Grid>
                    <Border Style="{StaticResource CompoundValueSourceGroup}"
                            Visibility="{Binding WholeValueSource.ShowsIndividualValues, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <geometry:ResponsiveGeometryPanel Grid.IsSharedSizeScope="True">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="GeometryLabel"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Translate Key=Ui.Common.XCoordinate}" Style="{StaticResource GeometryInlineFieldLabel}"/>
                                <generated:GeneratedValueSourceInput Grid.Column="1" DataContext="{Binding ManualXField}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="GeometryLabel"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Translate Key=Ui.Common.YCoordinate}" Style="{StaticResource GeometryInlineFieldLabel}"/>
                                <generated:GeneratedValueSourceInput Grid.Column="1" DataContext="{Binding ManualYField}"/>
                            </Grid>
                        </geometry:ResponsiveGeometryPanel>
                    </Border>
                    <jobs:ValueReferencePicker DataContext="{Binding WholeValueSource.Picker}"
                                               Visibility="{Binding DataContext.WholeValueSource.UsesReference, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
                <generated:GeneratedWholeValueSourceSelector HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              DataContext="{Binding WholeValueSource}"/>
            </controls:ResponsiveActionPanel>
        </Grid>
    </Border>
</UserControl>
