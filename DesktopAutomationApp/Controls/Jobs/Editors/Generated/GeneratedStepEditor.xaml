<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.Editors.Generated.GeneratedStepEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
             xmlns:controls="clr-namespace:DesktopAutomationApp.Controls"
             xmlns:conditions="clr-namespace:DesktopAutomationApp.Controls.Jobs.Conditions"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             xmlns:output="clr-namespace:DesktopAutomationApp.Controls.Jobs.Editors.Output"
             xmlns:roi="clr-namespace:DesktopAutomationApp.Controls.Jobs.Roi"
             xmlns:geometry="clr-namespace:DesktopAutomationApp.Controls.Jobs.Geometry"
             xmlns:shared="clr-namespace:DesktopAutomationApp.Controls.Jobs.Shared"
             xmlns:windows="clr-namespace:DesktopAutomationApp.Controls.WindowsIntegration"
             xmlns:analysis="clr-namespace:DesktopAutomationApp.Controls.Jobs.Editors.Analysis"
             xmlns:generated="clr-namespace:DesktopAutomationApp.Controls.Jobs.Editors.Generated"
             xmlns:viewModels="clr-namespace:DesktopAutomationApp.ViewModels"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             MinWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource StepRadioButton}"/>
        <generated:GeneratedStepFieldTemplateSelector x:Key="GeneratedStepFieldTemplateSelector"/>
        <generated:GeneratedStepFieldTemplateSelector x:Key="InlineStepValueTemplateSelector" IgnoreInputReference="True"/>
        <Style x:Key="VirtualizedCompoundEditorItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="TextFieldTemplate">
            <TextBox MinWidth="0" HorizontalAlignment="Stretch"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>
        <DataTemplate x:Key="SingleLineTextFieldTemplate">
            <TextBox Height="34" MinWidth="0" HorizontalAlignment="Stretch"
                     AcceptsReturn="False" TextWrapping="NoWrap"
                     VerticalContentAlignment="Center"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>
        <DataTemplate x:Key="MultilineTextFieldTemplate">
            <TextBox MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>
        <DataTemplate x:Key="EmojiTextFieldTemplate">
            <emoji:RichTextBox MinHeight="58" AcceptsReturn="True"
                               Style="{StaticResource StepRichTextInput}"
                               VerticalScrollBarVisibility="Hidden"
                               Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>
        <DataTemplate x:Key="BooleanFieldTemplate">
            <CheckBox HorizontalAlignment="Left" VerticalAlignment="Center"
                      IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>
        <DataTemplate x:Key="BooleanDropdownFieldTemplate">
            <ComboBox ItemsSource="{Binding BooleanOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedBooleanOption, Mode=TwoWay}"/>
        </DataTemplate>
        <DataTemplate x:Key="DateTimeFieldTemplate">
            <mah:DateTimePicker Style="{StaticResource AppDateTimePickerStyle}"
                                SelectedDateTime="{Binding DateTimeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Culture="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=CurrentCulture}"/>
        </DataTemplate>
        <DataTemplate x:Key="SuggestionsFieldTemplate">
            <ComboBox IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                      ItemsSource="{Binding Suggestions}"
                      Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>
        <DataTemplate x:Key="SuggestionFileFieldTemplate">
            <controls:ResponsiveActionPanel CanWrap="False" MinPrimaryWidth="160"
                                            HorizontalSpacing="6"
                                            VerticalSpacing="6">
                <ComboBox IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                          ItemsSource="{Binding Suggestions}"
                          Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="{loc:Translate Key=Ui.Common.Ellipsis}" Width="34" Height="34"
                        HorizontalAlignment="Right"
                        Command="{Binding DataContext.BrowseGeneratedFileCommand, RelativeSource={RelativeSource AncestorType={x:Type generated:GeneratedStepEditor}}}"
                        CommandParameter="{Binding}"/>
            </controls:ResponsiveActionPanel>
        </DataTemplate>
        <DataTemplate x:Key="ChoiceFieldTemplate">
            <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"/>
        </DataTemplate>
        <DataTemplate x:Key="EnumFieldTemplate">
            <StackPanel MinWidth="0">
                <ComboBox MinWidth="0" HorizontalAlignment="Stretch"
                          AutomationProperties.AutomationId="GeneratedStepEnumPicker"
                          ItemsSource="{Binding EnumOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          TextSearch.TextPath="Label"
                          SelectedValue="{Binding SelectedEnumValue, Mode=TwoWay}"/>
                <TextBlock Margin="2,4,2,0"
                           Foreground="{DynamicResource App.Brush.Danger}"
                           Text="{Binding EnumValidationMessage}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasInvalidEnumValue}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ProcessSourceOptionTemplate">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:GeneratedProcessNameTargetContentViewModel}">
            <StackPanel>
                <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.ProcessName}"
                           Style="{StaticResource StepFieldLabel}" Margin="0,0,0,4"/>
                <generated:GeneratedValueSourceInput DataContext="{Binding Editor.ProcessNameField}"/>
                <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.WindowTitleContains}"
                           Style="{StaticResource StepFieldLabel}" Margin="0,10,0,4"/>
                <generated:GeneratedValueSourceInput DataContext="{Binding Editor.WindowTitleField}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:GeneratedExecutableProcessTargetContentViewModel}">
            <StackPanel>
                <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.PathProgram}"
                           Style="{StaticResource StepFieldLabel}" Margin="0,0,0,4"/>
                <generated:GeneratedValueSourceInput DataContext="{Binding Editor.ExecutablePathField}"/>
                <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.WindowTitleContains}"
                           Style="{StaticResource StepFieldLabel}" Margin="0,10,0,4"/>
                <generated:GeneratedValueSourceInput DataContext="{Binding Editor.WindowTitleField}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ProcessTargetFieldTemplate">
            <controls:ResponsiveActionPanel CanWrap="False" MinPrimaryWidth="220"
                                            HorizontalSpacing="12"
                                            VerticalSpacing="6">
                <Grid x:Name="ProcessTargetValueHost">
                    <Border Style="{StaticResource CompoundValueSourceGroup}"
                            Visibility="{Binding ProcessTargetEditor.WholeValueSource.ShowsIndividualValues, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ContentControl Content="{Binding ProcessTargetEditor.ManualSourceContent}"
                                        HorizontalContentAlignment="Stretch"/>
                    </Border>
                    <jobs:ValueReferencePicker DataContext="{Binding ProcessTargetEditor.WholeValueSource.Picker}"
                                               Visibility="{Binding DataContext.ProcessTargetEditor.WholeValueSource.UsesReference, ElementName=ProcessTargetValueHost, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
                <generated:GeneratedWholeValueSourceSelector HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              DataContext="{Binding ProcessTargetEditor.WholeValueSource}"/>
            </controls:ResponsiveActionPanel>
        </DataTemplate>
        <DataTemplate x:Key="FileFieldTemplate">
            <shared:PathPickerField PathValue="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    BrowseCommand="{Binding DataContext.BrowseGeneratedFileCommand, RelativeSource={RelativeSource AncestorType={x:Type generated:GeneratedStepEditor}}}"
                                    BrowseCommandParameter="{Binding}" PreviewSource="{Binding FilePreview}"
                                    HasPreview="{Binding HasFilePreview}"/>
        </DataTemplate>
        <DataTemplate x:Key="DirectoryFieldTemplate">
            <shared:PathPickerField PathValue="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    BrowseCommand="{Binding DataContext.BrowseGeneratedDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type generated:GeneratedStepEditor}}}"
                                    BrowseCommandParameter="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Key="FileOrFolderFieldTemplate">
            <shared:PathPickerField PathValue="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    BrowseCommand="{Binding DataContext.BrowseGeneratedFileOrFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type generated:GeneratedStepEditor}}}"
                                    BrowseCommandParameter="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Key="MonitorFieldTemplate">
            <shared:MonitorPicker MonitorIndex="{Binding IntegerValue, Mode=TwoWay}"
                                  SelectCommand="{Binding DataContext.ChooseMonitorCommand, RelativeSource={RelativeSource AncestorType={x:Type generated:GeneratedStepEditor}}}"
                                  SelectCommandParameter="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Key="InputReferenceFieldTemplate">
            <Grid x:Name="InputValueHost">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <ContentControl Content="{Binding}"
                                    ContentTemplateSelector="{StaticResource InlineStepValueTemplateSelector}"
                                    Visibility="{Binding ShowsDirectInput, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Grid Visibility="{Binding ShowsInputSourcePicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <jobs:ValueReferencePicker DataContext="{Binding InputReferenceEditor.Picker}"/>
                    </Grid>
                    <Border Padding="10,8" CornerRadius="6"
                            Background="{DynamicResource App.Brush.AccentSubtle}"
                            Visibility="{Binding RequiresInlineEditChoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding InputReferenceEditor.Picker.MultipleUsageText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Inline.ChooseAction}"
                                           Margin="0,2,0,0" FontSize="10"
                                           Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0">
                                <Button Content="{loc:Translate Key=Ui.Job.Variables.Inline.EditEverywhere}"
                                        Command="{Binding InputReferenceEditor.Picker.EditEverywhereCommand}"
                                        Style="{StaticResource ButtonSecondary}" Margin="0,0,0,6"/>
                                <Button Content="{loc:Translate Key=Ui.Job.Variables.Inline.EditOnlyHere}"
                                        Command="{Binding InputReferenceEditor.Picker.EditOnlyHereCommand}"
                                        Style="{StaticResource ButtonPrimary}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Button Grid.Column="1" Width="34" Height="34" Margin="5,0,0,0" VerticalAlignment="Top"
                        Padding="0" Style="{StaticResource ButtonSecondary}"
                        Visibility="{Binding ShowsInputSourceSelector, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="{loc:Translate Key=Ui.Job.StepInput.Source.ToolTip}"
                        Click="OpenButtonContextMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{loc:Translate Key=Ui.Job.StepInput.Source.Direct}"
                                      Command="{Binding UseDirectValueCommand}"
                                      IsCheckable="True" IsChecked="{Binding InputReferenceEditor.Picker.IsDirectSource, Mode=OneWay}"/>
                            <MenuItem Header="{loc:Translate Key=Ui.Job.StepInput.Source.JobVariable}"
                                      Command="{Binding InputReferenceEditor.Picker.UseJobVariableCommand}"
                                      IsCheckable="True" IsChecked="{Binding InputReferenceEditor.Picker.IsJobVariableSource, Mode=OneWay}"/>
                            <MenuItem Header="{loc:Translate Key=Ui.Job.StepInput.Source.StepResult}"
                                      Command="{Binding InputReferenceEditor.Picker.UseStepResultCommand}"
                                      IsCheckable="True" IsChecked="{Binding InputReferenceEditor.Picker.IsStepResultSource, Mode=OneWay}"/>
                            <MenuItem Header="{loc:Translate Key=Ui.Job.StepInput.Source.Secret}"
                                      Command="{Binding InputReferenceEditor.Picker.UseSecretCommand}"
                                      IsCheckable="True" IsChecked="{Binding InputReferenceEditor.Picker.IsSecretSource, Mode=OneWay}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <iconPacks:PackIconMaterial Kind="RhombusOutline" Width="15" Height="15"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Foreground="{DynamicResource App.Brush.Accent}"/>
                </Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PercentageFieldTemplate">
            <shared:PercentageInput Value="{Binding NumberValue, Mode=TwoWay}"/>
        </DataTemplate>
        <DataTemplate x:Key="ColorFieldTemplate">
            <mah:ColorPicker HorizontalAlignment="Left" SelectedColor="{Binding ColorValue, Mode=TwoWay}"/>
        </DataTemplate>
        <DataTemplate x:Key="CameraFieldTemplate">
            <StackPanel>
                <controls:ResponsiveActionPanel CanWrap="False" MinPrimaryWidth="220"
                                                HorizontalSpacing="8"
                                                VerticalSpacing="6">
                    <ComboBox ItemsSource="{Binding CameraEditor.Cameras}" SelectedItem="{Binding CameraEditor.SelectedCamera, Mode=TwoWay}"
                              DisplayMemberPath="Name" MinWidth="0" HorizontalAlignment="Stretch"/>
                    <Button Command="{Binding CameraEditor.RefreshCommand}"
                            Content="{loc:Translate Key=Ui.Step.Camera.Refresh}"
                            HorizontalAlignment="Right"/>
                </controls:ResponsiveActionPanel>
                <TextBlock Text="{Binding CameraEditor.CameraStatus}" Foreground="{DynamicResource App.Brush.TextMuted}"
                           TextWrapping="Wrap" Margin="0,4,0,8"/>
                <TextBlock Text="{loc:Translate Key=Ui.Step.Camera.Quality}" Style="{StaticResource StepFieldLabel}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding CameraEditor.Qualities}" SelectedItem="{Binding CameraEditor.SelectedQuality, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" IsEnabled="{Binding CameraEditor.IsLoadingQualities, Converter={StaticResource InverseBooleanConverter}}"
                          MinWidth="0" HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding CameraEditor.QualityStatus}" Foreground="{DynamicResource App.Brush.TextMuted}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding CameraEditor.InvalidQualityMessage}" Foreground="{DynamicResource App.Brush.Danger}"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding CameraEditor.HasInvalidQualityToken, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="VisualOverlayFieldTemplate">
            <output:VisualOverlayEditor Margin="0,-12,0,0" DataContext="{Binding VisualOverlayEditor}"/>
        </DataTemplate>
        <DataTemplate x:Key="RoiFieldTemplate">
            <roi:RoiEditor DataContext="{Binding RoiEditor}" IsRoiEnabled="{Binding IsRoiEnabled, Mode=TwoWay}"
                           X="{Binding X, Mode=TwoWay}" Y="{Binding Y, Mode=TwoWay}"
                           RoiWidth="{Binding RoiWidth, Mode=TwoWay}" RoiHeight="{Binding RoiHeight, Mode=TwoWay}"
                           CaptureCommand="{Binding DataContext.CaptureGeneratedRoiCommand, RelativeSource={RelativeSource AncestorType={x:Type generated:GeneratedStepEditor}}}"
                           CaptureCommandParameter="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Key="YoloFieldTemplate">
            <StackPanel>
                <generated:GeneratedValueSourceInput DataContext="{Binding YoloEditor.ModelField}"/>
                <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.ClassName}" Style="{StaticResource StepFieldLabel}" Margin="0,10,0,4"/>
                <generated:GeneratedValueSourceInput DataContext="{Binding YoloEditor.ClassField}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ConditionFieldTemplate">
            <conditions:ConditionEditor Conditions="{Binding ConditionEditor.Conditions}"
                                        IsAll="{Binding ConditionEditor.IsAll, Mode=TwoWay}"
                                        IsAny="{Binding ConditionEditor.IsAny, Mode=TwoWay}"
                                        AddCommand="{Binding ConditionEditor.AddCommand}"/>
        </DataTemplate>
        <DataTemplate x:Key="WindowsCapabilityFieldTemplate">
            <windows:WindowsCapabilityPicker DataContext="{Binding WindowsCapabilityEditor.Picker}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScreenPointFieldTemplate">
            <StackPanel>
                <StackPanel Visibility="{Binding ScreenPointEditor.WholeValueSource.ShowsIndividualValues, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:ResponsiveActionPanel CanWrap="False" Margin="0,0,0,10"
                                                    MinPrimaryWidth="220"
                                                    HorizontalSpacing="8"
                                                    VerticalSpacing="6">
                        <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.Coordinates}"
                                   Style="{StaticResource GeometrySectionHeader}" TextWrapping="Wrap"/>
                        <Button HorizontalAlignment="Right"
                                Content="{loc:Translate Key=Ui.Step.Settings.Capture}"
                                Style="{StaticResource GeometryInlineAction}"
                                Command="{Binding ScreenPointEditor.CaptureCommand}"/>
                    </controls:ResponsiveActionPanel>
                    <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.Monitor}" Style="{StaticResource GeometryFieldLabel}"/>
                    <generated:GeneratedValueSourceInput DataContext="{Binding ScreenPointEditor.MonitorField}" Margin="0,0,0,10"/>
                </StackPanel>
                <controls:ResponsiveActionPanel CanWrap="False" MinPrimaryWidth="220"
                                                HorizontalSpacing="12"
                                                VerticalSpacing="6">
                    <Grid x:Name="ScreenPointValueHost">
                        <Border Style="{StaticResource CompoundValueSourceGroup}"
                                Visibility="{Binding ScreenPointEditor.WholeValueSource.ShowsIndividualValues, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <geometry:ResponsiveGeometryPanel Grid.IsSharedSizeScope="True">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="GeometryLabel"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Translate Key=Ui.Common.XCoordinate}" Style="{StaticResource GeometryInlineFieldLabel}"/><generated:GeneratedValueSourceInput Grid.Column="1" DataContext="{Binding ScreenPointEditor.XField}"/></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="GeometryLabel"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Translate Key=Ui.Common.YCoordinate}" Style="{StaticResource GeometryInlineFieldLabel}"/><generated:GeneratedValueSourceInput Grid.Column="1" DataContext="{Binding ScreenPointEditor.YField}"/></Grid>
                            </geometry:ResponsiveGeometryPanel>
                        </Border>
                        <jobs:ValueReferencePicker DataContext="{Binding ScreenPointEditor.WholeValueSource.Picker}"
                                                   Visibility="{Binding DataContext.ScreenPointEditor.WholeValueSource.UsesReference, ElementName=ScreenPointValueHost, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <generated:GeneratedWholeValueSourceSelector HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  DataContext="{Binding ScreenPointEditor.WholeValueSource}"/>
                </controls:ResponsiveActionPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="UserChoiceOptionsFieldTemplate">
            <StackPanel>
                <ListBox ItemsSource="{Binding UserChoiceOptionsEditor.Options}" MaxHeight="560"
                         BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource VirtualizedCompoundEditorItem}">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource GeometryCard}">
                            <controls:ResponsiveActionPanel CanWrap="False" MinPrimaryWidth="220"
                                                            HorizontalSpacing="10"
                                                            VerticalSpacing="6">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Key=Ui.UserChoice.AnswerTextRequired}"
                                               Style="{StaticResource GeometryFieldLabel}"/>
                                    <generated:GeneratedValueSourceInput DataContext="{Binding LabelField}"/>
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{loc:Translate Key=Ui.UserChoice.AnswerValueOptional}"
                                               Style="{StaticResource GeometryFieldLabel}"/>
                                    <generated:GeneratedValueSourceInput DataContext="{Binding ValueField}"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Width="28" Height="28"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ButtonIcon}"
                                        ToolTip="{loc:Translate Key=Ui.Common.Ellipsis}"
                                        Click="OpenButtonContextMenu_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{loc:Translate Key=Ui.UserChoice.MoveUp}"
                                                      Command="{Binding MoveUpCommand}"/>
                                            <MenuItem Header="{loc:Translate Key=Ui.UserChoice.MoveDown}"
                                                      Command="{Binding MoveDownCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="{loc:Translate Key=Ui.UserChoice.RemoveAnswer}"
                                                      Command="{Binding RemoveCommand}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <iconPacks:PackIconMaterial Kind="DotsVertical" Width="15" Height="15"/>
                                </Button>
                            </controls:ResponsiveActionPanel>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button Content="{loc:Translate Key=Ui.UserChoice.AddAnswer}"
                        Command="{Binding UserChoiceOptionsEditor.AddCommand}"
                        Style="{StaticResource ButtonSecondary}"
                        HorizontalAlignment="Left"/>
                <TextBlock Text="{loc:Translate Key=Ui.UserChoice.StableReferenceHint}"
                           Style="{StaticResource GeometrySummary}"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PointEntryListFieldTemplate">
            <StackPanel>
                <ListBox ItemsSource="{Binding PointEntryListEditor.Points}" MaxHeight="560"
                         BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource VirtualizedCompoundEditorItem}">
                    <ListBox.ItemTemplate><DataTemplate><analysis:PointEntryEditor/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button Content="{loc:Translate Key=Ui.Step.Settings.AddPoint}"
                        Command="{Binding PointEntryListEditor.AddCommand}"
                        Style="{StaticResource ButtonSecondary}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AxisExpressionListFieldTemplate">
            <StackPanel>
                <ListBox ItemsSource="{Binding AxisExpressionListEditor.Expressions}" MaxHeight="560"
                         BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource VirtualizedCompoundEditorItem}">
                    <ListBox.ItemTemplate><DataTemplate><analysis:AxisExpressionEditor/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button Content="{loc:Translate Key=Ui.Step.Settings.AddExpression}"
                        Command="{Binding AxisExpressionListEditor.AddCommand}"
                        Style="{StaticResource ButtonSecondary}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="GeneratedFieldTemplate">
            <Grid x:Name="GeneratedFieldHost" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                  Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Top" Margin="0,0,0,6"
                             Visibility="{Binding UsesConditionEditor, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource StepFieldLabel}"/>
                    <TextBlock Text="{Binding Description}"
                               Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource App.Brush.TextMuted}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <ContentControl Content="{Binding}"
                                Grid.Row="1"
                                HorizontalContentAlignment="Stretch"
                                ContentTemplateSelector="{StaticResource GeneratedStepFieldTemplateSelector}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UsesConditionEditor}" Value="True">
                                    <Setter Property="Grid.Row" Value="0"/>
                                    <Setter Property="Grid.RowSpan" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ChoiceBranchHeaderTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Description}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Foreground="{DynamicResource App.Brush.TextMuted}" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ChoiceBranchContentTemplate">
            <ItemsControl ItemsSource="{Binding Children}" HorizontalContentAlignment="Stretch"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:GeneratedStepFieldNodeViewModel}">
            <ContentControl Content="{Binding Field}" ContentTemplate="{StaticResource GeneratedFieldTemplate}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:GeneratedStepPointFieldPairViewModel}">
            <Grid x:Name="PointPairHost" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6">
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding Label}"
                               Style="{StaticResource StepFieldLabel}"
                               Visibility="{Binding HasLabel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
                <controls:ResponsiveActionPanel CanWrap="False" Grid.Row="1"
                                                MinPrimaryWidth="220"
                                                HorizontalSpacing="12"
                                                VerticalSpacing="6">
                    <Grid x:Name="PointPairValueHost">
                        <Border Style="{StaticResource CompoundValueSourceGroup}"
                                Visibility="{Binding ShowsIndividualValues, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <geometry:ResponsiveGeometryPanel Grid.IsSharedSizeScope="True">
                                <geometry:ResponsiveGeometryPanel.Style>
                                    <Style TargetType="geometry:ResponsiveGeometryPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsesWholeValueReference}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </geometry:ResponsiveGeometryPanel.Style>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="GeometryLabel"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Translate Key=Ui.Common.XCoordinate}" Style="{StaticResource GeometryInlineFieldLabel}"/><generated:GeneratedValueSourceInput Grid.Column="1" DataContext="{Binding XField}"/></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="GeometryLabel"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Translate Key=Ui.Common.YCoordinate}" Style="{StaticResource GeometryInlineFieldLabel}"/><generated:GeneratedValueSourceInput Grid.Column="1" DataContext="{Binding YField}"/></Grid>
                            </geometry:ResponsiveGeometryPanel>
                        </Border>
                        <jobs:ValueReferencePicker DataContext="{Binding WholeValueSource.Picker}"
                                                   Visibility="{Binding DataContext.UsesWholeValueReference, ElementName=PointPairValueHost, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <generated:GeneratedWholeValueSourceSelector HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  DataContext="{Binding WholeValueSource}"
                                                                  Visibility="{Binding DataContext.HasWholeValueSource, ElementName=PointPairValueHost, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </controls:ResponsiveActionPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:GeneratedStepChoiceGroupViewModel}">
            <Grid Margin="0,0,0,12" HorizontalAlignment="Stretch"
                  Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Top" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource StepFieldLabel}"/>
                    <TextBlock Text="{Binding Description}"
                               Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource App.Brush.TextMuted}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <shared:ChoiceGroupEditor Grid.Row="1"
                                          ItemsSource="{Binding Branches}"
                                          SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                                          SelectedContent="{Binding SelectedBranch}"
                                          ItemTemplate="{StaticResource ChoiceBranchHeaderTemplate}"
                                          SelectedContentTemplate="{StaticResource ChoiceBranchContentTemplate}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RegularSectionTemplate">
            <ItemsControl ItemsSource="{Binding Nodes}"
                          HorizontalContentAlignment="Stretch"/>
        </DataTemplate>
        <DataTemplate x:Key="CollapsibleSectionTemplate">
            <Expander Header="{Binding Title}"
                      IsExpanded="{Binding IsInitiallyExpanded, Mode=OneWay}"
                      Style="{StaticResource StepAdvancedExpander}">
                <ItemsControl Margin="0,10,0,0"
                              ItemsSource="{Binding Nodes}"
                              HorizontalContentAlignment="Stretch"/>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding GeneratedEditor.EditorDescription}"
                   Visibility="{Binding GeneratedEditor.HasEditorDescription, Converter={StaticResource BooleanToVisibilityConverter}}"
                   TextWrapping="Wrap" Foreground="{DynamicResource App.Brush.TextMuted}"
                   FontStyle="Italic" FontSize="12" Margin="0,0,0,12"/>
        <ItemsControl ItemsSource="{Binding GeneratedEditor.Sections}"
                      HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource RegularSectionTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsible}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CollapsibleSectionTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
