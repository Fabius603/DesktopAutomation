<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.Editors.Generated.GeneratedStepEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
             xmlns:conditions="clr-namespace:DesktopAutomationApp.Controls.Jobs.Conditions"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             xmlns:output="clr-namespace:DesktopAutomationApp.Controls.Jobs.Editors.Output"
             xmlns:roi="clr-namespace:DesktopAutomationApp.Controls.Jobs.Roi"
             xmlns:shared="clr-namespace:DesktopAutomationApp.Controls.Jobs.Shared"
             xmlns:windows="clr-namespace:DesktopAutomationApp.Controls.WindowsIntegration"
             xmlns:analysis="clr-namespace:DesktopAutomationApp.Controls.Jobs.Editors.Analysis"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <DataTemplate x:Key="GeneratedFieldTemplate">
            <Grid Margin="0,0,0,12"
                  Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource StepFieldLabel}"/>
                    <TextBlock Text="{Binding Description}"
                               Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource App.Brush.TextMuted}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,3,10,0"/>
                </StackPanel>
                <TextBox Grid.Column="1" Width="160" HorizontalAlignment="Left"
                         Visibility="{Binding UsesTextInput, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="1" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding UsesMultilineTextInput, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
                <emoji:RichTextBox Grid.Column="1" MinHeight="58" AcceptsReturn="True"
                                   Style="{DynamicResource MahApps.Styles.RichTextBox}"
                                   VerticalScrollBarVisibility="Hidden"
                                   Visibility="{Binding UsesEmojiText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibilityConverter}}"
                          IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                          Visibility="{Binding UsesSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ItemsSource="{Binding Suggestions}"
                          Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid Grid.Column="1"
                      Visibility="{Binding UsesSuggestionFilePicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                              ItemsSource="{Binding Suggestions}"
                              Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="{loc:Translate Key=Ui.Common.Ellipsis}" Width="32" Height="28" Margin="6,0,0,0"
                            Command="{Binding DataContext.BrowseGeneratedFileCommand, ElementName=Root}"
                            CommandParameter="{Binding}"/>
                </Grid>
                <ComboBox Grid.Column="1"
                          Visibility="{Binding UsesChoicePicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ItemsSource="{Binding Choices}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"/>
                <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left"
                          Visibility="{Binding UsesEnumPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ItemsSource="{Binding EnumOptions}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedEnumOption, Mode=TwoWay}"/>
                <StackPanel Grid.Column="1"
                            Visibility="{Binding UsesProcessTargetPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <jobs:ProcessTargetModeSelector Picker="{Binding ProcessTargetEditor.Picker}"
                                                    UseProcessReference="{Binding ProcessTargetEditor.UseProcessReference, Mode=TwoWay}"/>
                    <StackPanel Visibility="{Binding UsesNamedProcessTargetPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ComboBox IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  Visibility="{Binding ProcessTargetEditor.UseProcessReference, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                  ItemsSource="{Binding ProcessTargetEditor.ProcessNames}"
                                  Text="{Binding ProcessTargetEditor.ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding UsesExecutableProcessTargetPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <shared:PathPickerField
                            Visibility="{Binding ProcessTargetEditor.UseProcessReference, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            PathValue="{Binding ProcessTargetEditor.ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            BrowseCommand="{Binding DataContext.BrowseGeneratedProcessTargetFileCommand, ElementName=Root}"
                            BrowseCommandParameter="{Binding}"/>
                    </StackPanel>
                </StackPanel>
                <shared:PathPickerField Grid.Column="1"
                                        Visibility="{Binding UsesFilePicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        PathValue="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        BrowseCommand="{Binding DataContext.BrowseGeneratedFileCommand, ElementName=Root}"
                                        BrowseCommandParameter="{Binding}"
                                        PreviewSource="{Binding FilePreview}"
                                        HasPreview="{Binding HasFilePreview}"/>
                <shared:PathPickerField Grid.Column="1"
                                        Visibility="{Binding UsesDirectoryPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        PathValue="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        BrowseCommand="{Binding DataContext.BrowseGeneratedDirectoryCommand, ElementName=Root}"
                                        BrowseCommandParameter="{Binding}"/>
                <shared:PathPickerField Grid.Column="1"
                                        Visibility="{Binding UsesFileOrFolderPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        PathValue="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        BrowseCommand="{Binding DataContext.BrowseGeneratedFileOrFolderCommand, ElementName=Root}"
                                        BrowseCommandParameter="{Binding}"/>
                <shared:MonitorPicker Grid.Column="1" HorizontalAlignment="Left"
                                      Visibility="{Binding UsesMonitorPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      MonitorIndex="{Binding IntegerValue, Mode=TwoWay}"
                                      SelectCommand="{Binding DataContext.ChooseMonitorCommand, ElementName=Root}"
                                      SelectCommandParameter="{Binding}"/>
                <jobs:ResultBindingPicker Grid.Column="1"
                                          Visibility="{Binding UsesResultBindingPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          DataContext="{Binding ResultBindingEditor.Picker}"/>
                <shared:PercentageInput Grid.Column="1"
                                        Visibility="{Binding UsesPercentagePicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Value="{Binding NumberValue, Mode=TwoWay}"/>
                <mah:ColorPicker Grid.Column="1" HorizontalAlignment="Left"
                                 Visibility="{Binding UsesColorPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 SelectedColor="{Binding ColorValue, Mode=TwoWay}"/>
                <StackPanel Grid.Column="1"
                            Visibility="{Binding UsesCameraPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding CameraEditor.Cameras}"
                                  SelectedItem="{Binding CameraEditor.SelectedCamera, Mode=TwoWay}"
                                  DisplayMemberPath="Name" MinWidth="220"/>
                        <Button Grid.Column="1" Command="{Binding CameraEditor.RefreshCommand}"
                                Content="{loc:Translate Key=Ui.Step.Camera.Refresh}" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding CameraEditor.CameraStatus}"
                               Foreground="{DynamicResource App.Brush.TextMuted}"
                               TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <TextBlock Text="{loc:Translate Key=Ui.Step.Camera.Quality}"
                               Style="{StaticResource StepFieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding CameraEditor.Qualities}"
                              SelectedItem="{Binding CameraEditor.SelectedQuality, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding CameraEditor.IsLoadingQualities, Converter={StaticResource InverseBooleanConverter}}"
                              MinWidth="220" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding CameraEditor.QualityStatus}"
                               Foreground="{DynamicResource App.Brush.TextMuted}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <output:VisualOverlayEditor Grid.Column="1"
                                            Margin="0,-12,0,0"
                                            Visibility="{Binding UsesVisualOverlay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            DataContext="{Binding VisualOverlayEditor}"/>
                <roi:RoiEditor Grid.Column="1"
                               Visibility="{Binding UsesRoiPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                               DataContext="{Binding RoiEditor}"
                               IsRoiEnabled="{Binding RoiEditor.IsRoiEnabled, Mode=TwoWay}"
                               X="{Binding RoiEditor.X, Mode=TwoWay}"
                               Y="{Binding RoiEditor.Y, Mode=TwoWay}"
                               RoiWidth="{Binding RoiEditor.RoiWidth, Mode=TwoWay}"
                               RoiHeight="{Binding RoiEditor.RoiHeight, Mode=TwoWay}"
                               CaptureCommand="{Binding DataContext.CaptureGeneratedRoiCommand, ElementName=Root}"
                               CaptureCommandParameter="{Binding}"/>
                <StackPanel Grid.Column="1"
                            Visibility="{Binding UsesYoloPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox ItemsSource="{Binding YoloEditor.Models}"
                              IsEditable="True"
                              Text="{Binding YoloEditor.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.ClassName}"
                               Style="{StaticResource StepFieldLabel}" Margin="0,10,0,4"/>
                    <ComboBox ItemsSource="{Binding YoloEditor.Classes}"
                              IsEditable="True"
                              Text="{Binding YoloEditor.ClassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <conditions:ConditionEditor Grid.Column="1"
                                            Visibility="{Binding UsesConditionEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Conditions="{Binding ConditionEditor.Conditions}"
                                            IsAll="{Binding ConditionEditor.IsAll, Mode=TwoWay}"
                                            IsAny="{Binding ConditionEditor.IsAny, Mode=TwoWay}"
                                            AddCommand="{Binding ConditionEditor.AddCommand}"/>
                <windows:WindowsCapabilityPicker Grid.Column="1"
                                                 Visibility="{Binding UsesWindowsCapabilityPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 DataContext="{Binding WindowsCapabilityEditor.Picker}"/>
                <StackPanel Grid.Column="1" Visibility="{Binding UsesScreenPointPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <shared:MonitorPicker MonitorIndex="{Binding ScreenPointEditor.MonitorIndex, Mode=TwoWay}"
                                          SelectCommand="{Binding ScreenPointEditor.SelectMonitorCommand}" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.X}" Style="{StaticResource StepAxisLabel}"/>
                        <TextBox Width="90" Text="{Binding ScreenPointEditor.X, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                        <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.Y}" Style="{StaticResource StepAxisLabel}"/>
                        <TextBox Width="90" Text="{Binding ScreenPointEditor.Y, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                        <Button Content="{loc:Translate Key=Ui.Step.Settings.Capture}" Command="{Binding ScreenPointEditor.CaptureCommand}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Visibility="{Binding UsesUserChoiceOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding UserChoiceOptionsEditor.Options}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <emoji:RichTextBox Grid.Column="1" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" MinHeight="30"/>
                                <emoji:RichTextBox Grid.Column="2" Margin="6,0" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" MinHeight="30"/>
                                <Button Grid.Column="3" Command="{Binding MoveUpCommand}" Padding="6,2" ToolTip="{loc:Translate Key=Ui.UserChoice.MoveUp}"><iconPacks:PackIconMaterial Kind="ArrowUp" Width="14" Height="14"/></Button>
                                <Button Grid.Column="4" Command="{Binding MoveDownCommand}" Padding="6,2" Margin="4,0,0,0" ToolTip="{loc:Translate Key=Ui.UserChoice.MoveDown}"><iconPacks:PackIconMaterial Kind="ArrowDown" Width="14" Height="14"/></Button>
                                <Button Grid.Column="5" Content="{loc:Translate Key=Ui.Common.RemoveSymbol}" Command="{Binding RemoveCommand}" Padding="6,2" Margin="4,0,0,0"/>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{loc:Translate Key=Ui.UserChoice.AddAnswer}" Command="{Binding UserChoiceOptionsEditor.AddCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{loc:Translate Key=Ui.UserChoice.StableReferenceHint}" Foreground="{DynamicResource App.Brush.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Visibility="{Binding UsesPointEntryList, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding PointEntryListEditor.Points}">
                        <ItemsControl.ItemTemplate><DataTemplate><analysis:PointEntryEditor/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{loc:Translate Key=Ui.Step.Settings.AddPoint}" Command="{Binding PointEntryListEditor.AddCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Visibility="{Binding UsesAxisExpressionList, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding AxisExpressionListEditor.Expressions}">
                        <ItemsControl.ItemTemplate><DataTemplate><analysis:AxisExpressionEditor/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{loc:Translate Key=Ui.Step.Settings.AddExpression}" Command="{Binding AxisExpressionListEditor.AddCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RegularSectionTemplate">
            <ItemsControl ItemsSource="{Binding Fields}"
                          ItemTemplate="{StaticResource GeneratedFieldTemplate}"/>
        </DataTemplate>
        <DataTemplate x:Key="CollapsibleSectionTemplate">
            <Expander Header="{Binding Title}"
                      IsExpanded="{Binding IsInitiallyExpanded}"
                      Style="{StaticResource StepAdvancedExpander}">
                <ItemsControl Margin="0,10,0,0"
                              ItemsSource="{Binding Fields}"
                              ItemTemplate="{StaticResource GeneratedFieldTemplate}"/>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding GeneratedEditor.EditorDescription}"
                   Visibility="{Binding GeneratedEditor.HasEditorDescription, Converter={StaticResource BooleanToVisibilityConverter}}"
                   TextWrapping="Wrap" Foreground="{DynamicResource App.Brush.TextMuted}"
                   FontStyle="Italic" FontSize="12" Margin="0,0,0,12"/>
        <ItemsControl ItemsSource="{Binding GeneratedEditor.Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource RegularSectionTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsible}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CollapsibleSectionTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
