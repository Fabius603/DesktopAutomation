<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.ResultPathPicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <Style x:Key="PickerToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="{DynamicResource App.Brush.WindowBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                                <Setter TargetName="ToggleBorder" Property="CornerRadius" Value="5,5,0,0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerTreeItemStyle" TargetType="TreeViewItem"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}"/>
        </Style>

        <Style x:Key="PickerTreeRowStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource App.Brush.AccentSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource App.Brush.SurfaceHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="DropDownToggle"
                      Style="{StaticResource PickerToggleStyle}"
                      Checked="DropDownToggle_Checked"
                      PreviewMouseLeftButtonDown="DropDownToggle_PreviewMouseLeftButtonDown"
                      IsChecked="{Binding IsOpen, ElementName=SelectionPopup, Mode=TwoWay}">
            <Grid>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRichPreview, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconMaterial Kind="SourceBranch"
                                            Width="14" Height="14" Margin="0,0,8,0"
                                            Foreground="{DynamicResource App.Brush.Accent}"
                                            VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayText, ElementName=Root}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="2" Margin="8,0,0,0" Padding="5,1"
                        Background="{DynamicResource App.Brush.Surface}"
                        CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SecondaryText, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SecondaryText, ElementName=Root}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SecondaryText, ElementName=Root}"
                               FontSize="9" Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                </Border>
                <iconPacks:PackIconMaterial Grid.Column="3"
                                            Width="14" Height="14" Margin="8,0,0,0"
                                            Foreground="{DynamicResource App.Brush.TextMuted}"
                                            VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial.Style>
                        <Style TargetType="iconPacks:PackIconMaterial">
                            <Setter Property="Kind" Value="ChevronDown"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen, ElementName=SelectionPopup}" Value="True">
                                    <Setter Property="Kind" Value="ChevronUp"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </iconPacks:PackIconMaterial.Style>
                </iconPacks:PackIconMaterial>
            </Grid>
            <Grid MinHeight="34">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRichPreview, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                           Text="{Binding DisplayText, ElementName=Root}"
                           MaxWidth="190"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewText, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PreviewText, ElementName=Root}" Value="">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Margin="7,0,0,0"
                           Text="{Binding PreviewText, ElementName=Root, StringFormat='= {0}'}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewText, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PreviewText, ElementName=Root}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Grid.Column="2" Margin="9,0,0,0" Padding="5,1"
                        Background="{DynamicResource App.Brush.Surface}"
                        CornerRadius="3" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SecondaryText, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SecondaryText, ElementName=Root}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SecondaryText, ElementName=Root}"
                               FontSize="9" Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                </Border>
                <TextBlock Grid.Column="3" Margin="8,0,0,0"
                           MaxWidth="110"
                           Text="{Binding SourceText, ElementName=Root}"
                           FontSize="9"
                           Foreground="{DynamicResource App.Brush.TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SourceText, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SourceText, ElementName=Root}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <iconPacks:PackIconMaterial Grid.Column="4"
                                            Width="14" Height="14" Margin="8,0,0,0"
                                            Foreground="{DynamicResource App.Brush.TextMuted}"
                                            VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial.Style>
                        <Style TargetType="iconPacks:PackIconMaterial">
                            <Setter Property="Kind" Value="ChevronDown"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen, ElementName=SelectionPopup}" Value="True">
                                    <Setter Property="Kind" Value="ChevronUp"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </iconPacks:PackIconMaterial.Style>
                </iconPacks:PackIconMaterial>
            </Grid>
            </Grid>
        </ToggleButton>

        <Popup x:Name="SelectionPopup"
               Closed="SelectionPopup_Closed"
               PlacementTarget="{Binding ElementName=DropDownToggle}"
               Placement="Bottom"
               VerticalOffset="-1"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="{Binding ActualWidth, ElementName=DropDownToggle}"
                    MinWidth="420" MaxHeight="440"
                    Padding="5"
                    Background="{DynamicResource App.Brush.Surface}"
                    BorderBrush="{DynamicResource App.Brush.Accent}"
                    BorderThickness="1"
                    CornerRadius="0,0,7,7">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.28" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="6,4,6,8">
                        <TextBlock Text="{loc:Translate Key=Ui.ValueReference.PickerTitle}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ContextText, ElementName=Root}"
                                   Margin="0,2,0,0" FontSize="10"
                                   Foreground="{DynamicResource App.Brush.Accent}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ContextText, ElementName=Root}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{loc:Translate Key=Ui.ValueReference.PickerHint}"
                                   Margin="0,2,0,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                    </StackPanel>
                    <TextBox x:Name="SearchBox" Grid.Row="1"
                             Margin="2,2,2,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="{loc:Translate Key=Ui.ValueReference.Search}"
                             mah:TextBoxHelper.UseFloatingWatermark="False"/>
                <TreeView Grid.Row="2" ItemsSource="{Binding ItemsSource, ElementName=Root}"
                          ItemContainerStyle="{StaticResource PickerTreeItemStyle}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          MaxHeight="306"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Button Style="{StaticResource PickerTreeRowStyle}"
                                    Command="{Binding SelectCommand}"
                                    IsEnabled="{Binding IsEnabled}"
                                    ToolTip="{Binding Description}"
                                    Click="TreeNode_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Kind="{Binding Icon}"
                                                                Width="14" Height="14" Margin="0,0,7,0"
                                                                Foreground="{DynamicResource App.Brush.TextMuted}"
                                                                Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SecondaryText}"
                                                   Margin="0,1,0,0"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.Brush.TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SecondaryText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SecondaryText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Margin="8,0,0,0" Padding="5,2"
                                            Background="{DynamicResource App.Brush.SurfaceHover}"
                                            CornerRadius="3" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SourceText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SourceText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SourceText}" FontSize="9"
                                                   Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                    </Border>
                                    <iconPacks:PackIconMaterial Grid.Column="3" Kind="CheckCircle"
                                                                Width="15" Height="15" Margin="8,0,1,0"
                                                                Foreground="{DynamicResource App.Brush.Accent}"
                                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                    <Button Grid.Row="3" Margin="2,6,2,1" Padding="7,4"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PickerTreeRowStyle}"
                            Command="{Binding ToggleIncompatibleCommand}"
                            Visibility="{Binding HasIncompatible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding IncompatibleText}" FontSize="10"
                                   Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                    </Button>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
