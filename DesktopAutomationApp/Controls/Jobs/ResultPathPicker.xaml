<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.ResultPathPicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Height="34" MaxHeight="34" VerticalAlignment="Top">
    <Grid>
        <ToggleButton x:Name="DropDownToggle"
                      Style="{StaticResource ReferencePickerField}"
                      Height="34" MaxHeight="34" VerticalAlignment="Top"
                      Tag="{Binding ElementName=Root}"
                      PreviewMouseLeftButtonDown="DropDownToggle_PreviewMouseLeftButtonDown"
                      Click="DropDownToggle_Click"
                      IsChecked="{Binding IsOpen, ElementName=SelectionPopup, Mode=OneWay}">
            <ToggleButton.ToolTip>
                <ToolTip MaxWidth="430"
                         DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <StackPanel Margin="3">
                        <TextBlock Text="{Binding DisplayText}"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SecondaryText}"
                                       Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                       Text="{Binding SourceText}"
                                       Foreground="{DynamicResource App.Brush.TextMuted}"/>
                        </Grid>
                        <StackPanel Margin="0,7,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToolTipValue}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{loc:Translate Key=Ui.ValueReference.ToolTip.Value}"
                                       FontSize="10" Foreground="{DynamicResource App.Brush.TextMuted}"/>
                            <TextBlock Text="{Binding ToolTipValue}"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Margin="0,7,0,0"
                                   Text="{Binding ToolTipDescription}"
                                   Foreground="{DynamicResource App.Brush.TextSecondary}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToolTipDescription}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ToolTip>
            </ToggleButton.ToolTip>

            <Grid MinHeight="34">
                <Grid x:Name="SimplePreview">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRichPreview, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayText, ElementName=Root}"
                               FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <iconPacks:PackIconMaterial Grid.Column="1" Width="14" Height="14" Margin="8,0,0,0"
                                                Kind="ChevronDown"
                                                Foreground="{DynamicResource App.Brush.TextMuted}"
                                                VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="RichPreview">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRichPreview, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PreviewText, ElementName=Root}"
                               MinWidth="48" MaxWidth="210"
                               FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewText, ElementName=Root}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               Text="{Binding InlineText, ElementName=Root}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="9,0,10,0"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewText, ElementName=Root}" Value="">
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Column="2">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ReferencePickerTypeBadge}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SecondaryText, ElementName=Root}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SecondaryText, ElementName=Root}"
                                   FontSize="10" Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                    </Border>
                    <TextBlock Grid.Column="3" Margin="8,0,0,0" MaxWidth="125"
                               Text="{Binding SourceText, ElementName=Root}"
                               FontSize="9" Foreground="{DynamicResource App.Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SourceText, ElementName=Root}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PreviewDensity, ElementName=Root}" Value="Normal">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PreviewDensity, ElementName=Root}" Value="Compact">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PreviewDensity, ElementName=Root}" Value="VeryNarrow">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <iconPacks:PackIconMaterial Grid.Column="4" Width="14" Height="14" Margin="8,0,0,0"
                                                Foreground="{DynamicResource App.Brush.TextMuted}"
                                                VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                                <Setter Property="Kind" Value="ChevronDown"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=SelectionPopup}" Value="True">
                                        <Setter Property="Kind" Value="ChevronUp"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                </Grid>
            </Grid>
        </ToggleButton>

        <Popup x:Name="SelectionPopup"
               Opened="SelectionPopup_Opened"
               Closed="SelectionPopup_Closed"
               PlacementTarget="{Binding ElementName=DropDownToggle}"
               Placement="Bottom"
               VerticalOffset="4"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="{Binding ActualWidth, ElementName=DropDownToggle}"
                    MinWidth="400" MaxWidth="620" MaxHeight="440"
                    Style="{StaticResource ReferencePickerPopup}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="12,10,12,9">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Key=Ui.ValueReference.SelectVariable}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding ExpectedTypeText, ElementName=Root}"
                                   FontSize="10" Foreground="{DynamicResource App.Brush.TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,9,0,0"
                                 Text="{Binding SearchText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 PreviewKeyDown="OnPreviewKeyDown"
                                 mah:TextBoxHelper.Watermark="{loc:Translate Key=Ui.ValueReference.Search}"
                                 mah:TextBoxHelper.UseFloatingWatermark="False"/>
                    </Grid>

                    <TreeView Grid.Row="2" Margin="5,1,5,5"
                              ItemsSource="{Binding ItemsSource, ElementName=Root}"
                              ItemContainerStyle="{StaticResource ReferencePickerTreeItem}"
                              Background="Transparent" BorderThickness="0" Padding="0"
                              MaxHeight="306"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Button Style="{StaticResource ReferencePickerRow}"
                                        Command="{Binding SelectCommand}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Click="TreeNode_Click">
                                    <Button.ToolTip>
                                        <ToolTip MaxWidth="430"
                                                 Visibility="{Binding IsSelectable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Margin="3">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding SecondaryText}"
                                                               Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding SourceText}"
                                                               Foreground="{DynamicResource App.Brush.TextMuted}"/>
                                                </Grid>
                                                <TextBlock Margin="0,7,0,0" Text="{Binding FullValueText}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Visibility="{Binding HasFullValueText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Margin="0,7,0,0" Text="{Binding Description}"
                                                           Foreground="{DynamicResource App.Brush.TextSecondary}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3" Margin="0,5,0,5" CornerRadius="2"
                                                Background="{DynamicResource App.Brush.SelectionBorder}"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Grid Grid.Column="1" Margin="7,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock MinWidth="40" MaxWidth="200"
                                                       Text="{Binding ValueText}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasValueText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Grid.Column="1" Margin="9,0,10,0"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasValueText}" Value="True">
                                                                <Setter Property="FontSize" Value="11"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelectable}" Value="True"/>
                                                                    <Condition Binding="{Binding HasValueText}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Grid.Column="2" Width="13" Height="13" Margin="0,0,6,0" CornerRadius="2"
                                                    Background="{Binding ColorPreview, TargetNullValue=Transparent, FallbackValue=Transparent}"
                                                    BorderBrush="{DynamicResource App.Brush.BorderStrong}" BorderThickness="1"
                                                    Visibility="{Binding HasColorPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                        <Border Grid.Column="2" Margin="10,0,0,0"
                                                Style="{StaticResource ReferencePickerTypeBadge}"
                                                Visibility="{Binding HasSecondaryText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding SecondaryText}" FontSize="10"
                                                       Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Margin="8,0,0,0" MaxWidth="125"
                                                   Text="{Binding SourceText}"
                                                   FontSize="9" Foreground="{DynamicResource App.Brush.TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasSourceText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Button>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Border Grid.Row="3" Padding="8" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource App.Brush.BorderSubtle}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowCreateAction, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding CreateCommand, ElementName=Root}"
                                Style="{StaticResource ReferencePickerFooterButton}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,8,0"
                                                            Foreground="{DynamicResource App.Brush.Accent}"/>
                                <TextBlock Text="{loc:Translate Key=Ui.ValueReference.CreateVariable}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
