<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.JobVariableValueEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <Style x:Key="VariableNumericInputStyle" TargetType="mah:NumericUpDown"
               BasedOn="{StaticResource {x:Type mah:NumericUpDown}}">
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HideUpDownButtons" Value="True"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="ChangeValueOnTextChanged" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.BorderSubtle}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.FocusBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VariableDateTimeInputStyle" TargetType="mah:DateTimePicker"
               BasedOn="{StaticResource AppDateTimePickerStyle}"/>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="0,0,0,8"
                    Visibility="{Binding HasInvalidValue, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding InvalidValueMessage}" TextWrapping="Wrap" Foreground="{DynamicResource App.Brush.Danger}"/>
            <Button Content="{loc:Translate Key=Ui.Job.Variables.UseDefaultExplicitly}"
                    Command="{Binding ResetInvalidValueCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
        </StackPanel>
    <Grid>
        <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <ComboBox ItemsSource="{Binding BooleanOptions}"
                  SelectedItem="{Binding SelectedBooleanOption, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName"
                  Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <mah:NumericUpDown Value="{Binding IntegerValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            NumericInputMode="Numbers" Interval="1" Style="{StaticResource VariableNumericInputStyle}"
                            Visibility="{Binding IsInteger, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <mah:NumericUpDown Value="{Binding NumberValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            NumericInputMode="All" Interval="0.1" Style="{StaticResource VariableNumericInputStyle}"
                           Visibility="{Binding IsNumber, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <mah:DateTimePicker SelectedDateTime="{Binding DateTimeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource VariableDateTimeInputStyle}"
                            Culture="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=CurrentCulture}"
                            Visibility="{Binding IsDateTime, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <mah:ColorPicker HorizontalAlignment="Left"
                         SelectedColor="{Binding ColorValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsColor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Grid Visibility="{Binding IsFilePath, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="{loc:Translate Key=Ui.Job.Variables.FilePath.Watermark}"/>
            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ButtonSecondary}"
                    Command="{Binding BrowseFileCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="FileSearchOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                    <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.FilePath.Browse}"/>
                </StackPanel>
            </Button>
        </Grid>
        <Grid Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="{loc:Translate Key=Ui.Job.Variables.ImagePath}"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ButtonSecondary}"
                        Command="{Binding BrowseImageCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FolderImage" Width="15" Height="15" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Image.Browse}"/>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding ImageStatus}" Margin="1,6,0,0"
                       FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextSecondary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsImagePathMissing}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Grid.Row="2" Margin="0,10,0,0" Padding="8" CornerRadius="7" MaxHeight="230"
                    Background="{DynamicResource App.Brush.SurfaceHover}"
                    BorderBrush="{DynamicResource App.Brush.CardBorder}" BorderThickness="1"
                    Visibility="{Binding HasImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Image Source="{Binding ImagePreview}" Stretch="Uniform" MaxHeight="210"/>
            </Border>
        </Grid>
        <TextBox Text="{Binding JsonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="100"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Visibility="{Binding IsResultObject, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Grid Visibility="{Binding IsPoint, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{loc:Translate Key=Ui.Job.Variables.X}" Margin="0,0,0,4"/><mah:NumericUpDown Value="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" NumericInputMode="All" Interval="1" Style="{StaticResource VariableNumericInputStyle}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Y}" Margin="0,0,0,4"/><mah:NumericUpDown Value="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" NumericInputMode="All" Interval="1" Style="{StaticResource VariableNumericInputStyle}"/></StackPanel>
        </Grid>
        <Grid Visibility="{Binding IsRectangle, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{loc:Translate Key=Ui.Job.Variables.X}" Margin="0,0,0,4"/><mah:NumericUpDown Value="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" NumericInputMode="All" Interval="1" Style="{StaticResource VariableNumericInputStyle}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Y}" Margin="0,0,0,4"/><mah:NumericUpDown Value="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" NumericInputMode="All" Interval="1" Style="{StaticResource VariableNumericInputStyle}"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Width}" Margin="0,0,0,4"/><mah:NumericUpDown Value="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" NumericInputMode="Numbers" Interval="1" Style="{StaticResource VariableNumericInputStyle}"/></StackPanel>
            <StackPanel Grid.Column="6"><TextBlock Text="{loc:Translate Key=Ui.Job.Variables.Height}" Margin="0,0,0,4"/><mah:NumericUpDown Value="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" NumericInputMode="Numbers" Interval="1" Style="{StaticResource VariableNumericInputStyle}"/></StackPanel>
        </Grid>
    </Grid>
    </StackPanel>
</UserControl>
