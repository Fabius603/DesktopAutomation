<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.Roi.RoiEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
             xmlns:geometry="clr-namespace:DesktopAutomationApp.Controls.Jobs.Geometry">
    <Border Style="{StaticResource GeometryCard}">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right"
                        Content="{loc:Translate Key=Ui.Step.Settings.Capture}"
                        Style="{StaticResource GeometryInlineAction}"
                        Command="{Binding CaptureCommand, ElementName=Root}"
                        CommandParameter="{Binding CaptureCommandParameter, ElementName=Root}"/>
                <CheckBox Content="{loc:Translate Key=Ui.Step.Settings.EnableROI}"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsRoiEnabled, ElementName=Root}"/>
            </DockPanel>

            <geometry:GeometryValueEditor
                IsEnabled="{Binding IsRoiEnabled, ElementName=Root}"
                ShowSize="True"
                X="{Binding X, ElementName=Root}"
                Y="{Binding Y, ElementName=Root}"
                RegionWidth="{Binding RoiWidth, ElementName=Root}"
                RegionHeight="{Binding RoiHeight, ElementName=Root}"/>

            <Border Height="1" Margin="0,4,0,10"
                    Background="{DynamicResource App.Brush.BorderSubtle}"/>
            <CheckBox Content="{loc:Translate Key=Ui.Step.DynamicRoi.Use}"
                      IsChecked="{Binding UseDynamicRoi, Mode=TwoWay}"
                      FontWeight="SemiBold"
                      Margin="0,0,0,6"/>
            <jobs:ResultBindingPicker DataContext="{Binding DetectionDynamicRoiSource}"
                                      Margin="0,0,0,8"
                                      Visibility="{Binding UseDynamicRoi, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock>
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource GeometrySummary}">
                    <Setter Property="Text" Value="{loc:Translate Key=Ui.Step.Roi.Hint.None}"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRoiEnabled, ElementName=Root}" Value="True"/>
                                <Condition Binding="{Binding UseDynamicRoi}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Text" Value="{loc:Translate Key=Ui.Step.Roi.Hint.Static}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRoiEnabled, ElementName=Root}" Value="False"/>
                                <Condition Binding="{Binding HasSelectedDynamicRoi}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Text" Value="{loc:Translate Key=Ui.Step.Roi.Hint.Dynamic}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRoiEnabled, ElementName=Root}" Value="True"/>
                                <Condition Binding="{Binding HasSelectedDynamicRoi}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Text" Value="{loc:Translate Key=Ui.Step.Roi.Hint.Combined}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRoiEnabled, ElementName=Root}" Value="False"/>
                                <Condition Binding="{Binding UseDynamicRoi}" Value="True"/>
                                <Condition Binding="{Binding HasSelectedDynamicRoi}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Text" Value="{loc:Translate Key=Ui.Step.Roi.Hint.NoDynamicFull}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRoiEnabled, ElementName=Root}" Value="True"/>
                                <Condition Binding="{Binding UseDynamicRoi}" Value="True"/>
                                <Condition Binding="{Binding HasSelectedDynamicRoi}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Text" Value="{loc:Translate Key=Ui.Step.Roi.Hint.NoDynamicStatic}"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
