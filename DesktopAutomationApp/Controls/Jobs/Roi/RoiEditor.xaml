<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.Roi.RoiEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization"
             xmlns:generated="clr-namespace:DesktopAutomationApp.Controls.Jobs.Editors.Generated">
    <Border Style="{StaticResource GeometryCard}">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right"
                        Content="{loc:Translate Key=Ui.Step.Settings.Capture}"
                        Style="{StaticResource GeometryInlineAction}"
                        Command="{Binding CaptureCommand, ElementName=Root}"
                        CommandParameter="{Binding CaptureCommandParameter, ElementName=Root}"/>
                <StackPanel>
                    <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.EnableROI}" Style="{StaticResource GeometryFieldLabel}"/>
                    <generated:GeneratedValueSourceInput DataContext="{Binding EnabledField}"/>
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="2" Margin="0,0,0,6">
                <StackPanel Margin="0,0,4,4"><TextBlock Text="{loc:Translate Key=Ui.Common.XCoordinate}" Style="{StaticResource GeometryFieldLabel}"/><generated:GeneratedValueSourceInput DataContext="{Binding XField}"/></StackPanel>
                <StackPanel Margin="4,0,0,4"><TextBlock Text="{loc:Translate Key=Ui.Common.YCoordinate}" Style="{StaticResource GeometryFieldLabel}"/><generated:GeneratedValueSourceInput DataContext="{Binding YField}"/></StackPanel>
                <StackPanel Margin="0,0,4,0"><TextBlock Text="{loc:Translate Key=Ui.Step.Settings.Width}" Style="{StaticResource GeometryFieldLabel}"/><generated:GeneratedValueSourceInput DataContext="{Binding WidthField}"/></StackPanel>
                <StackPanel Margin="4,0,0,0"><TextBlock Text="{loc:Translate Key=Ui.Step.Settings.Height}" Style="{StaticResource GeometryFieldLabel}"/><generated:GeneratedValueSourceInput DataContext="{Binding HeightField}"/></StackPanel>
            </UniformGrid>

            <TextBlock>
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource GeometrySummary}">
                    <Setter Property="Text" Value="{loc:Translate Key=Ui.Step.Roi.Hint.None}"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRoiEnabled, ElementName=Root}" Value="True"/>
                                <Condition Binding="{Binding UseDynamicRoi}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Text" Value="{loc:Translate Key=Ui.Step.Roi.Hint.Static}"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
