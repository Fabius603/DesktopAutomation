<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.ResultBindingPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <jobs:ResultPathPicker ItemsSource="{Binding SelectionTree}"
                               DisplayText="{Binding SelectedDisplayPath}"
                               SecondaryText="{Binding SelectedCardinality}"/>

        <Button Grid.Column="1"
                Width="30" Height="30"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ClearCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ButtonIconDanger}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CanClear}" Value="True"/>
                                <Condition Binding="{Binding ShowClearButton, ElementName=Root}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <iconPacks:PackIconMaterial Kind="Close" Width="13" Height="13"/>
        </Button>
    </Grid>
</UserControl>
