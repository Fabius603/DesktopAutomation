<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.Conditions.ConditionEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:context="clr-namespace:DesktopAutomationApp.Behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:jobs="clr-namespace:DesktopAutomationApp.Controls.Jobs"
             xmlns:generated="clr-namespace:DesktopAutomationApp.Controls.Jobs.Editors.Generated"
             xmlns:conv="clr-namespace:DesktopAutomationApp.Converters"
             xmlns:controls="clr-namespace:DesktopAutomationApp.Controls"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization">
    <UserControl.Resources>
        <conv:OneBasedIndexConverter x:Key="OneBasedIndexConverter"/>
        <Style x:Key="ConditionFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
        </Style>
        <Style x:Key="VirtualizedConditionItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionBorder" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource StepInspectorScrollBarStyle}"/>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource App.Brush.SurfaceHover}"
                BorderBrush="{DynamicResource App.Brush.CardBorder}"
                BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.Evaluation}"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <controls:ResponsiveColumnsPanel MinItemWidth="170" MaxColumns="2"
                                                 HorizontalSpacing="16" VerticalSpacing="6">
                    <RadioButton IsChecked="{Binding IsAll, ElementName=Root}"
                                 Style="{StaticResource StepRadioButton}"
                                 VerticalAlignment="Center">
                        <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.AllAND}" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsAny, ElementName=Root}"
                                 Style="{StaticResource StepRadioButton}"
                                 VerticalAlignment="Center">
                        <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.OneOR}" TextWrapping="Wrap"/>
                    </RadioButton>
                </controls:ResponsiveColumnsPanel>
            </StackPanel>
        </Border>

        <ListBox context:ContextActions.Profile="Conditions" SelectionMode="Extended" ItemsSource="{Binding Conditions, ElementName=Root}" AlternationCount="1000"
                 MaxHeight="560" BorderThickness="0" Background="Transparent"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ItemContainerStyle="{StaticResource VirtualizedConditionItem}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border HorizontalAlignment="Left"
                                Background="{DynamicResource App.Brush.AccentSubtle}"
                                CornerRadius="9" Padding="9,2" Margin="14,0,0,5">
                            <TextBlock FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource App.Brush.Accent}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{loc:Translate Key=Ui.Step.IfEditor.AndConnector}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAny, ElementName=Root}" Value="True">
                                                <Setter Property="Text" Value="{loc:Translate Key=Ui.Step.IfEditor.OrConnector}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Border Background="{DynamicResource App.Brush.Surface}"
                                BorderBrush="{DynamicResource App.Brush.CardBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="25" Height="25" CornerRadius="13"
                                                Background="{DynamicResource App.Brush.AccentSubtle}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource OneBasedIndexConverter}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource App.Brush.Accent}"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{loc:Translate Key=Ui.Step.IfEditor.Condition}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource ButtonIconDanger}"
                                            Command="{Binding RemoveCommand}"
                                            IsEnabled="{Binding CanRemove}"
                                            ToolTip="{loc:Translate Key=Ui.Step.Settings.RemoveCondition}">
                                        <TextBlock Text="{loc:Translate Key=Ui.Common.RemoveSymbol}"
                                                   FontSize="22" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>

                                <!-- A condition reads from left to right: source, operator, comparison value. -->
                                <controls:ResponsiveColumnsPanel x:Name="ConditionComparisonGrid"
                                                                 MinItemWidth="160" MaxColumns="3"
                                                                 KeepAllColumnsTogether="True"
                                                                 HorizontalSpacing="12" VerticalSpacing="10">
                                    <StackPanel>
                                    <TextBlock Text="{loc:Translate Key=Ui.Step.IfEditor.ResultPath}"
                                               Style="{StaticResource ConditionFieldLabel}"/>
                                    <generated:GeneratedValueSourceInput DataContext="{Binding SourceField}"/>
                                    </StackPanel>

                                    <StackPanel>
                                    <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.Operator}"
                                               Style="{StaticResource ConditionFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding AvailableOperators}"
                                              SelectedItem="{Binding SelectedOperator}"
                                              Height="34">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ConditionOperatorConverter}}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    </StackPanel>

                                    <StackPanel
                                                 Visibility="{Binding ShowComparisonValue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.Value}"
                                                   Style="{StaticResource ConditionFieldLabel}"/>
                                        <generated:GeneratedValueSourceInput DataContext="{Binding ComparisonField}"/>
                                         <TextBlock Text="{Binding ComparisonValueValidationError}"
                                                    FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsComparisonValueValid}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </controls:ResponsiveColumnsPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Command="{Binding AddCommand, ElementName=Root}"
                HorizontalAlignment="Stretch" Style="{StaticResource ButtonSecondary}"
                Padding="10,8" Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,6,0"/>
                <TextBlock Text="{loc:Translate Key=Ui.Step.Settings.AddCondition}"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
