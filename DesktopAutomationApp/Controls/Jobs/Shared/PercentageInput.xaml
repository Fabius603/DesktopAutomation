<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.Shared.PercentageInput"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopAutomationApp.Controls">
    <controls:ResponsiveActionPanel MinPrimaryWidth="120"
                                    HorizontalSpacing="8"
                                    VerticalSpacing="2">
        <Slider Minimum="0" Maximum="1"
                SmallChange="0.01" LargeChange="0.05"
                TickFrequency="0.01" IsSnapToTickEnabled="True"
                VerticalAlignment="Center"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}"/>
        <TextBlock Width="44"
                   VerticalAlignment="Center" TextAlignment="Right"
                   Text="{Binding Value, ElementName=Root, StringFormat={}{0:P0}}"/>
    </controls:ResponsiveActionPanel>
</UserControl>
