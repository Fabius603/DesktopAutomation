<UserControl x:Class="DesktopAutomationApp.Controls.Jobs.Shared.MonitorPicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBox Width="72"
                 IsReadOnly="True"
                 Style="{StaticResource GeometryNumberInput}"
                 Text="{Binding MonitorIndex, ElementName=Root}"/>
        <Button Content="{loc:Translate Key=Ui.Step.Settings.SelectMonitor}"
                Margin="8,0,0,0"
                Style="{StaticResource GeometryInlineAction}"
                Command="{Binding SelectCommand, ElementName=Root}"
                CommandParameter="{Binding SelectCommandParameter, ElementName=Root}"/>
    </StackPanel>
</UserControl>
