<UserControl x:Class="DesktopAutomationApp.Controls.WindowsIntegration.WindowsCapabilityPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:loc="clr-namespace:DesktopAutomationApp.Localization">
    <StackPanel>
        <TextBlock Text="{loc:Translate Key=Ui.Windows.Category}" Margin="0,0,0,4" Foreground="{DynamicResource App.Brush.TextMuted}"/>
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                  MinHeight="34" Margin="0,0,0,10">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedEnumConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{loc:Translate Key=Ui.Windows.Capability}" Margin="0,0,0,4" Foreground="{DynamicResource App.Brush.TextMuted}"/>
        <ComboBox ItemsSource="{Binding Capabilities}" SelectedItem="{Binding SelectedCapability}"
                  MinHeight="34" Margin="0,0,0,4">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource WindowsCapabilityDisplayNameConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding SelectedCapabilityDescription}" Margin="0,0,0,10"
                   Foreground="{DynamicResource App.Brush.TextMuted}" TextWrapping="Wrap"/>

        <ItemsControl ItemsSource="{Binding Parameters}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,9"
                                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding DisplayName}" Margin="0,0,0,4" Foreground="{DynamicResource App.Brush.TextMuted}"/>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="{Binding Placeholder}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsText}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <CheckBox IsChecked="{Binding BooleanValue}" Content="{loc:Translate Key=Ui.Windows.Enabled}">
                            <CheckBox.Style><Style TargetType="CheckBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
                        </CheckBox>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="{loc:Translate Key=Ui.Common.Refresh}"
                                    Command="{Binding RefreshOptionsCommand}"
                                    Margin="8,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDynamicOptions}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ComboBox ItemsSource="{Binding Options}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Value}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox"
                                           BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelection}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Text="{Binding OptionStatus}"
                                   Foreground="{DynamicResource App.Brush.TextMuted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding AvailabilityHint}" Foreground="#FFE5A100" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
